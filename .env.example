# Local static website -> local SOF EXPO backend
PUBLIC_LEAD_ENDPOINT=http://localhost:8787/lead
PUBLIC_ANALYTICS_ENDPOINT=http://localhost:8787/event
# Public website account-menu target (API/backend origin only; leave blank until deployed).
# Production example: https://api.sof-expo.com
PUBLIC_PORTAL_URL=
# Optional: where the site reads the live exhibitor directory (GET /api/public/exhibitors).
# Defaults to the origin of PUBLIC_PORTAL_URL, then of PUBLIC_LEAD_ENDPOINT.
# PUBLIC_EXHIBITORS_API=https://api.sof-expo.com

# Backend listener and SQLite persistence
LEAD_WEBHOOK_HOST=0.0.0.0
LEAD_WEBHOOK_PORT=8787
LEAD_WEBHOOK_DB=./.data/sofexpo.sqlite

# Exact browser origins allowed to send leads / analytics or use the admin API.
# Add the public site hosts you actually deploy; do not use * in production.
LEAD_WEBHOOK_ORIGINS=http://localhost:4321,https://sof-expo.com,https://api.sof-expo.com,https://foodera.sof-expo.com,https://buildpro.sof-expo.com,https://agropro.sof-expo.com,https://worldedu.sof-expo.com,https://ecomretail.sof-expo.com

# First-run bootstrap only. Use a unique 12+ character password; change before deployment.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_DAYS=7
PORTAL_SESSION_DAYS=14
# One-time recovery command only: ADMIN_RESET_EMAIL=admin@example.com npm run admin:reset-password
# ADMIN_RESET_EMAIL=admin@example.com
# ADMIN_RESET_PASSWORD=SET-A-NEW-LONG-RANDOM-PASSWORD

# Set to 1 ONLY when requests arrive through your own trusted reverse proxy.
# The proxy must overwrite X-Forwarded-For / X-Forwarded-Proto / X-Forwarded-Host.
LEAD_WEBHOOK_TRUST_PROXY=0

# Optional durable notifications. Credentials remain on the backend, never in PUBLIC_* vars.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=

# --- Telegram channel -> site blog sync (docs/telegram-blog-sync.md) -----------------
# Bot token above is reused (the same bot must be ADMIN of the channel).
# Random 32+ char secret, generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Numeric channel id, looks like -1001234567890. How to get it: fill in the username
# below, add the bot as channel admin, then run: npm run telegram:webhook-info
TELEGRAM_CHANNEL_ID=
TELEGRAM_CHANNEL_USERNAME=sofexpo
# Full webhook URL, needed by npm run telegram:set-webhook
TELEGRAM_WEBHOOK_URL=https://api.sof-expo.com/api/telegram/webhook
# auto = publish immediately, draft = keep as draft until published in /admin -> Blog
BLOG_SYNC_MODE=auto
# optional: only sync posts carrying this hashtag (without #)
BLOG_SYNC_HASHTAG=
# which collection/locale the synced posts land in
BLOG_SYNC_COLLECTION=news
BLOG_SYNC_LOCALE=ru
BLOG_SYNC_MAX_FILE_MB=20
# publishing: the backend commits content/media into this checkout and pushes so the static
# host rebuilds (= revalidation). Off by default — enable only on the server with git credentials.
BLOG_SYNC_REPO_DIR=.
BLOG_SYNC_GIT_PUSH=0
BLOG_SYNC_GIT_REMOTE=origin
BLOG_SYNC_GIT_BRANCH=main
BLOG_SYNC_PUSH_DEBOUNCE_MS=20000
# optional hosting deploy-hook URLs (comma-separated), POST-ed after every publish
BLOG_SYNC_DEPLOY_HOOK_URLS=

# Optional: protects public /lead and /event intake. Do not treat a key embedded in
# PUBLIC_LEAD_ENDPOINT as a secret; browser code is public. Prefer rate limits + validation.
LEAD_WEBHOOK_SECRET=
# Optional non-cookie access to GET /stats for server-to-server reporting only.
LEAD_WEBHOOK_STATS_TOKEN=
