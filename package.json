{
  "name": "sofexpo.org",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 4321",
    "build": "astro build && node scripts/prune-sitemap.mjs",
    "preview": "astro preview --host 0.0.0.0 --port 4321",
    "check": "npm run build && npm run audit:seo",
    "audit:seo": "node scripts/seo-audit.mjs",
    "build:hosts": "node scripts/build-hosts.mjs --mode subdomain",
    "build:alias": "node scripts/build-hosts.mjs --mode alias",
    "check:hosts": "node scripts/build-hosts.mjs --mode subdomain && node scripts/check-hosts.mjs --mode subdomain"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource-variable/unbounded": "^5.3.0",
    "astro": "^7.3.3",
    "sharp": "^0.34.5"
  }
}
