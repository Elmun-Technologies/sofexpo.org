{
  "name": "sofexpo.org",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 4321",
    "build": "node scripts/gen-editorial-map.mjs && astro build && node scripts/build-og.mjs dist && node scripts/fit-meta.mjs dist && node scripts/prune-sitemap.mjs",
    "preview": "astro preview --host 0.0.0.0 --port 4321",
    "check": "npm run build && npm run audit:seo && npm run audit:translations && npm run audit:downloads && npm test",
    "audit:seo": "node scripts/seo-audit.mjs && node scripts/page-audit.mjs",
    "build:hosts": "node scripts/build-hosts.mjs --mode subdomain",
    "build:alias": "node scripts/build-hosts.mjs --mode alias",
    "check:hosts": "node scripts/build-hosts.mjs --mode subdomain && node scripts/check-hosts.mjs --mode subdomain",
    "build:host": "node scripts/build-one-host.mjs",
    "editorial:map": "node scripts/gen-editorial-map.mjs",
    "photos": "node scripts/build-photos.mjs",
    "fonts:sync": "node scripts/sync-fonts.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "i18n:extract": "node scripts/extract-translations.mjs",
    "audit:translations": "node scripts/audit-translations.mjs",
    "audit:downloads": "node scripts/audit-downloads.mjs",
    "check:release": "npm run check && npm run audit:downloads -- --require-final"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/golos-text": "5.3.0",
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "astro": "^7.3.3",
    "parse5": "^7.3.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "typescript": "^5.9.3"
  }
}
