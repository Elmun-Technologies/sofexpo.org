---
/**
 * "Ask AI about SOF EXPO": one click opens an AI assistant with a ready prompt about the
 * centre and the page the visitor is on. The prompt points the assistant at sofexpo.org,
 * /llms.txt and the current URL, so the answer is built from our own pages.
 *
 * Every edition (en/ru/tr/zh) gets a prompt in its own language: the four prompts are kept
 * in data-* attributes (the static zh/tr pipeline leaves data-* alone) and a tiny script
 * picks one from <html lang> + location. The static href is a working English fallback
 * for visitors without JavaScript.
 */
import { SITE } from '@/lib/seo';
import { localize, type SourceLocale as Locale } from '@/i18n/config';

const { locale, path } = Astro.props as { locale: Locale; path: string };
const ru = locale === 'ru';
const pageUrl = `${SITE}${localize(locale, path)}`;

const prompts: Record<string, string> = {
  en: 'Tell me about SOF EXPO Samarkand (sofexpo.org), the exhibition centre in Samarkand, Uzbekistan: upcoming trade shows and dates, the venue, how to book a stand or rent the hall. Use https://sofexpo.org/llms.txt and this page: {url}',
  ru: 'Расскажи о SOF EXPO Samarkand (sofexpo.org) — выставочном центре в Самарканде, Узбекистан: ближайшие выставки и даты, площадка, как забронировать стенд или арендовать зал. Используй https://sofexpo.org/llms.txt и эту страницу: {url}',
  tr: "SOF EXPO Samarkand (sofexpo.org) hakkında bilgi ver — Semerkant, Özbekistan'daki fuar merkezi: yaklaşan fuarlar ve tarihleri, mekân, stant rezervasyonu veya salon kiralama. https://sofexpo.org/llms.txt ve bu sayfayı kullan: {url}",
  'zh-CN': '请介绍 SOF EXPO Samarkand(sofexpo.org)——乌兹别克斯坦撒马尔罕的会展中心:近期展会及日期、场馆、如何预订展位或租用展馆。请参考 https://sofexpo.org/llms.txt 和本页面:{url}',
};

/* the ?q= deep links each assistant supports */
const tools: { id: string; name: string; nameEn?: string; href: string; bg: string; icon: string }[] = [
  { id: 'chatgpt', name: 'ChatGPT', href: 'https://chatgpt.com/?hints=search&q=', bg: '#10a37f',
    icon: '<path d="M12 3.2a4.3 4.3 0 0 1 4.1 3 4.3 4.3 0 0 1 3.4 5.7 4.3 4.3 0 0 1-2.7 6.2 4.3 4.3 0 0 1-6.3 2.4 4.3 4.3 0 0 1-6-3 4.3 4.3 0 0 1-2.1-5.9 4.3 4.3 0 0 1 3-6.2A4.3 4.3 0 0 1 12 3.2Z" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M9 9.5 12 8l3 1.5v5L12 16l-3-1.5z" fill="none" stroke="currentColor" stroke-width="1.5"/>' },
  { id: 'claude', name: 'Claude', href: 'https://claude.ai/new?q=', bg: '#d97757',
    icon: '<path d="M12 2.5v19M2.5 12h19M5.3 5.3l13.4 13.4M18.7 5.3 5.3 18.7M8.2 3.3l7.6 17.4M3.3 15.8l17.4-7.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>' },
  { id: 'perplexity', name: 'Perplexity', href: 'https://www.perplexity.ai/search?q=', bg: '#20808d',
    icon: '<path d="M12 2.5v19M5 7.5h14v8H5zM12 7.5 5.5 2.8v4.7M12 7.5l6.5-4.7v4.7M12 15.5l-6.5 5v-5M12 15.5l6.5 5v-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>' },
  { id: 'gemini', name: 'Google AI', href: 'https://www.google.com/search?udm=50&q=', bg: '#4b6ef5',
    icon: '<path d="M12 2c.6 5.3 4.7 9.4 10 10-5.3.6-9.4 4.7-10 10-.6-5.3-4.7-9.4-10-10 5.3-.6 9.4-4.7 10-10Z" fill="currentColor"/>' },
  { id: 'grok', name: 'Grok', href: 'https://grok.com/?q=', bg: '#111111',
    icon: '<path d="M5 19 17.5 5M9.5 5H5v4.5M19 14.5V19h-4.5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>' },
  { id: 'copilot', name: 'Copilot', href: 'https://copilot.microsoft.com/?q=', bg: '#2465d8',
    icon: '<path d="M7 4h7l-4 16H3zM17 4h4l-3.5 16H10" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>' },
  { id: 'mistral', name: 'Le Chat', href: 'https://chat.mistral.ai/chat?q=', bg: '#fa520f',
    icon: '<path d="M3 4h4v4H3zM17 4h4v4h-4zM3 8h8v4H3zM13 8h8v4h-8zM3 12h18v4H3zM3 16h4v4H3zM10 16h4v4h-4zM17 16h4v4h-4z" fill="currentColor"/>' },
  { id: 'alice', name: 'Алиса AI', nameEn: 'Alice AI', href: 'https://ya.ru/search/?text=', bg: '#7b3ff2',
    icon: '<circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="3.2" fill="currentColor"/>' },
];
const fallback = prompts[ru ? 'ru' : 'en'].replace('{url}', pageUrl);
---

<section class="askai" aria-labelledby="askai-t" data-nosnippet>
  <div class="askai__txt">
    <p class="askai__t" id="askai-t">{ru ? 'Спросите ИИ о SOF EXPO' : 'Ask AI about SOF EXPO'}</p>
    <p class="askai__s">{ru ? 'Готовый вопрос о центре и этой странице — в один клик' : 'A ready question about the centre and this page, in one click'}</p>
  </div>
  <ul class="askai__list" data-askai data-p-en={prompts.en} data-p-ru={prompts.ru} data-p-tr={prompts.tr} data-p-zh={prompts['zh-CN']}>
    {tools.map((t) => (
      <li>
        <a
          class="askai__btn"
          href={t.href + encodeURIComponent(fallback)}
          data-base={t.href}
          target="_blank"
          rel="nofollow noopener noreferrer"
          aria-label={`${ru ? t.name : t.nameEn ?? t.name} — ${ru ? 'спросить о SOF EXPO (откроется в новой вкладке)' : 'ask about SOF EXPO (opens in a new tab)'}`}
          title={ru ? t.name : t.nameEn ?? t.name}
          style={`--ai:${t.bg}`}
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" set:html={t.icon} />
          <span translate="no">{ru ? t.name : t.nameEn ?? t.name}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<script is:inline>
  (function () {
    var list = document.querySelector('[data-askai]');
    if (!list) return;
    var lang = (document.documentElement.lang || 'en').slice(0, 2);
    var tpl = list.getAttribute('data-p-' + lang) || list.getAttribute('data-p-en');
    var q = encodeURIComponent(tpl.replace('{url}', location.origin + location.pathname));
    list.querySelectorAll('a[data-base]').forEach(function (a) {
      a.href = a.getAttribute('data-base') + q;
    });
  })();
</script>

<style>
  .askai {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.6rem;
    margin-top: clamp(1.4rem, 1rem + 2vw, 2.4rem);
    padding: 1.1rem 1.2rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--r-lg);
    background: rgba(255, 255, 255, 0.04);
  }
  .askai__t {
    margin: 0;
    color: #fff;
    font-family: var(--f-display);
    font-weight: 650;
    font-size: 1rem;
  }
  .askai__s {
    margin: 0.15rem 0 0;
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.6);
  }
  .askai__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .askai__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.8rem 0.45rem 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--r-pill);
    color: #fff;
    font-size: 0.84rem;
    font-weight: 600;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.06);
    transition:
      background-color var(--tr),
      border-color var(--tr),
      transform var(--tr);
  }
  .askai__btn svg {
    flex: none;
    width: 26px;
    height: 26px;
    padding: 5px;
    border-radius: 50%;
    background: var(--ai);
    color: #fff;
  }
  .askai__btn:hover {
    background: rgba(255, 255, 255, 0.14);
    border-color: var(--ai);
    transform: translateY(-2px);
  }
  .askai__btn:focus-visible {
    outline: 2px solid var(--gold-soft, #f3e3c9);
    outline-offset: 2px;
  }
</style>
