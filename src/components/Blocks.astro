---
import { fig, figHtml } from '@/lib/figures';
/**
 * Block renderer. Every page is authored as an ordered, individual list of blocks,
 * so no two pages share the same composition while the markup stays one system.
 * Phase 2: auto CTA + form injection based on path — ideal placement.
 */
import type { Block, BlockAlbum, BlockCard, BlockFile, BlockLink, BlockRow, BlockShot, BlockStat } from '@/data/pages/types';
import { localize, type SourceLocale as Locale } from '@/i18n/config';
import { useUI } from '@/i18n/ui';
import Icon from '@/components/Icon.astro';
import TableScroll from '@/components/TableScroll.astro';
import DownloadNotice from '@/components/DownloadNotice.astro';
import { isSampleDownload } from '@/lib/downloads.mjs';
import Photo from '@/components/Photo.astro';
import StatBand from '@/components/StatBand.astro';
import LeadForm from '@/components/LeadForm.astro';
import QuizForm from '@/components/QuizForm.astro';
import Faq from '@/components/Faq.astro';
import CalendarRail from '@/components/CalendarRail.astro';
import VenuePlan from '@/components/VenuePlan.astro';
import MapSchema from '@/components/MapSchema.astro';
import TeamWall from '@/components/TeamWall.astro';
import PartnerLogoWall from '@/components/PartnerLogoWall.astro';
import ExhibitorForm from '@/components/conversion/forms/ExhibitorForm.astro';
import VisitorForm from '@/components/conversion/forms/VisitorForm.astro';
import OrganizerForm from '@/components/conversion/forms/OrganizerForm.astro';
import SponsorForm from '@/components/conversion/forms/SponsorForm.astro';
import CallbackForm from '@/components/conversion/forms/CallbackForm.astro';
import CatalogForm from '@/components/conversion/forms/CatalogForm.astro';
import GroupVisitForm from '@/components/conversion/forms/GroupVisitForm.astro';
import SmartCta from '@/components/conversion/SmartCta.astro';
import ExhibitorDirectory from '@/components/ExhibitorDirectory.astro';

const { blocks, locale, path = '' } = Astro.props as { blocks: Block[]; locale: Locale; path?: string };

function resolveAuto(p: string): { cta: 'exhibitor'|'visitor'|'organizer'|'sponsor'|'callback'|'catalog'|'group'; form: 'exhibitor'|'visitor'|'organizer'|'sponsor'|'callback'|'catalog'|'group' } | null {
  if (!p || p.includes('/venue/virtual-tour')) return null;
  if (p.includes('/exhibitors/sponsorship')) return { cta: 'sponsor', form: 'sponsor' };
  if (p.includes('/exhibitors/catalogue') || p.includes('/exhibitors/floor-plan')) return { cta: 'catalog', form: 'catalog' };
  if (p.includes('/exhibitors/packages') || p.includes('/exhibitors/stand-construction')) return { cta: 'exhibitor', form: 'exhibitor' };
  if (p.includes('/exhibitors/') || p.includes('/exhibitors')) return { cta: 'exhibitor', form: 'exhibitor' };
  if (p.includes('/visitors/tickets')) return { cta: 'visitor', form: 'visitor' };
  if (p.includes('/visitors/access') || p.includes('/visitors/travel')) return { cta: 'group', form: 'group' };
  if (p.includes('/visitors/') || p.includes('/visitors')) return { cta: 'visitor', form: 'visitor' };
  if (p.includes('/organizers/')) return { cta: 'organizer', form: 'organizer' };
  if (p.includes('/venue/halls') || p.includes('/venue/services') || p.includes('/venue/tech-specs')) return { cta: 'organizer', form: 'organizer' };
  if (p.includes('/venue/')) return { cta: 'organizer', form: 'organizer' };
  if (p.includes('/request-stand')) return { cta: 'exhibitor', form: 'exhibitor' };
  if (p.includes('/contacts')) return { cta: 'callback', form: 'callback' };
  if (p.includes('/about/partners')) return { cta: 'sponsor', form: 'sponsor' };
  if (p.includes('/about/')) return { cta: 'callback', form: 'callback' };
  if (p.includes('/program')) return { cta: 'visitor', form: 'visitor' };
  if (p.includes('/events/')) return { cta: 'visitor', form: 'visitor' };
  return null;
}
const auto = resolveAuto(path);
const hasForm = blocks.some(b => b.type === 'form');

const t = useUI(locale);
const ru = locale === 'ru';
const L = (p: string) => localize(locale, p);
const H = (p?: string) => {
  if (!p) return '';
  if (/^(https?:|mailto:|tel:|#)/.test(p)) return p;
  if (/^\/(files|images|og)\//.test(p) || /\.[a-z0-9]+$/i.test(p)) return p;
  return L(p);
};
/** Columns for a gallery of n photos and how many of the first photos span two columns, so the
 *  last row is always full: 6 → 3 columns, 7 → 4 with the first photo wide, 5 → 3 with one wide.
 *  A ragged last row (4 + 2) read as a missing photo. `wideT` is the same for the 2-column tablet grid. */
const galLayout = (n: number) => {
  if (n <= 3) return { cols: n, wideD: 0, wideT: n === 3 ? 1 : 0 };
  const extra = (c: number) => (c - (n % c)) % c;
  const cols = extra(4) <= extra(3) ? 4 : 3;
  return { cols, wideD: extra(cols), wideT: n % 2 };
};

/** A gallery is drawn as one grid per album; a block without albums stays a flat grid. */
const galleryGroups = (b: Block): BlockAlbum[] =>
  b.albums?.length ? b.albums : [{ title: '', items: (b.items ?? []) as BlockShot[] }];
---

{
  blocks.map((b, idx) => {
    /* outline: card titles are h3 only once a section h2 exists above them; otherwise h2 */
    const H3 = blocks.slice(0, idx).some((x) => x.type === 'h2' || x.type === 'cta') ? 'h3' : 'h2';
    const wide = b.width !== 'narrow';
    const ground = (x?: Block) => (x?.tone === 'paper' || x?.tone === 'forest' || x?.tone === 'sand' ? x.tone : 'default');
    const prev = idx > 0 ? blocks[idx - 1] : undefined;
    const afterHead = prev?.type === 'h2' && ground(prev) === ground(b);
    const boundary = (x?: Block) => !x || x.type === 'hero' || x.type === 'faq';
    const sameGround = !boundary(prev) && b.type !== 'faq' && ground(prev) === ground(b);
    const leadsIn = b.type === 'h2';
    /* one reminder in the middle of a long page; the closing CTA + form come after the last
       block. Two mid strips plus the closing one put the same banner on a page three times. */
    const showMidCta = auto && !hasForm && blocks.length > 6 && idx === Math.floor(blocks.length / 2) && b.type !== 'cta';
    return (
      <>
      <section hidden={b.type === 'directory' ? true : undefined} class:list={['sec', 'block', 'reveal', `block--${b.type}`, b.type === 'directory' && 'xdir-host', b.tone === 'paper' && 'sec--paper', b.tone === 'forest' && 'sec--forest', b.tone === 'sand' && 'sec--sand', b.anchor && 'has-anchor', leadsIn && 'block--head', afterHead && 'block--after-head', sameGround && !afterHead && 'block--cont']} id={b.id}>
        <div class:list={['wrap', !wide && 'wrap--narrow']}>
          {b.type === 'hero' && (
            <div class="block__head">
              <div>
                {/* kicker inside the h1: it carries the page's query (docs/16 §2.2) */}
                <h1>{b.kicker && <span class="kicker">{b.kicker}</span>}{b.kicker && ' '}<Fragment set:html={b.title ?? ''} /></h1>
                {b.lead && <p class="lead">{b.lead}</p>}
                {b.bullets?.length ? (
                  <ul class="pill-row" style="list-style:none;padding:0;margin:1.1rem 0 0;display:flex;flex-wrap:wrap;gap:.5rem">
                    {b.bullets.map((x) => (
                      <li class="chip">
                        <Icon name="check" size={14} /> {x}
                      </li>
                    ))}
                  </ul>
                ) : null}
                {b.actions?.length ? (
                  <div class="btn-row" style="margin-top:1.4rem">
                    {b.actions.map((a, i) => (
                      <a class:list={['btn', { 'btn--gold': i === 0, 'btn--ghost': i > 0 }]} href={H(a.href)} data-quiz-open={a.href === '/request-stand/' ? '' : undefined} data-quiz-source="hero">
                        {a.label}
                      </a>
                    ))}
                  </div>
                ) : null}
              </div>
              {b.image && (
                <Photo class="block__media" src={b.image} alt={b.imageAlt ?? ''} ratio={b.mediaRatio ?? '4/3'} priority sizes="(max-width: 1080px) 130vw, 72vw" />
              )}
            </div>
          )}

          {b.type === 'tour' && b.tour && (
            <div class="tour">
              <div class="tour__head">
                <div class="tour__intro">
                  {b.kicker && <p class="kicker">{b.kicker}</p>}
                  {b.title && <h2>{b.title}</h2>}
                  {b.text && <p class="lead">{b.text}</p>}
                </div>
                <div class="tour__actions">
                  <a class="btn btn--gold" href={b.tour.href} target="_blank" rel="noopener noreferrer">
                    {b.tour.launchLabel}
                  </a>
                  <a class="btn btn--ghost" href={b.tour.planHref} target="_blank" rel="noopener noreferrer">
                    {b.tour.planLabel}
                  </a>
                </div>
              </div>
              <div class="tour__frame">
                {/* The provider's viewer needs its own scripts and fullscreen support, so it is
                    intentionally not sandboxed. The direct link remains available if embedding is blocked. */}
                <iframe
                  src={b.tour.src}
                  title={b.tour.frameTitle}
                  loading="lazy"
                  referrerpolicy="strict-origin-when-cross-origin"
                  allow="accelerometer; autoplay; clipboard-write; gyroscope; picture-in-picture; web-share; fullscreen"
                  allowfullscreen
                  width="1440"
                  height="900"
                ></iframe>
                <p class="tour__fallback">
                  {b.tour.fallback}{' '}
                  <a href={b.tour.href} target="_blank" rel="noopener noreferrer">{b.tour.launchLabel}</a>
                </p>
              </div>
              <p class="tour__note">{b.tour.notice}</p>
            </div>
          )}

          {b.type === 'h2' && (
            <div class="sec-head">
              <div>
                {b.kicker && <p class="kicker">{b.kicker}</p>}
                <h2 set:html={b.title ?? ''} />
              </div>
              {b.text && <p>{b.text}</p>}
            </div>
          )}

          {b.type === 'text' && (
            <div class:list={['prose-media', !b.image && 'prose-media--solo']}>
              <div class="prose">
                {(b.paragraphs ?? []).map((p) => (
                  <p set:html={p} />
                ))}
                {b.list?.length ? (
                  <ul>{b.list.map((x) => <li set:html={x} />)}</ul>
                ) : null}
              </div>
              {b.image && (
                <Photo class="prose-media__fig" src={b.image} alt={b.imageAlt ?? b.title ?? ''} ratio="3/2" sizes="(max-width: 1080px) 100vw, 40vw" />
              )}
            </div>
          )}

          {b.type === 'stats' && (
              <StatBand
                locale={locale}
                items={(b.items as BlockStat[] ?? []).map((s) => ({
                  value: s.value,
                  unit: s.unit,
                  ru: s.label ?? s.ru ?? '',
                  en: s.label ?? s.en ?? '',
                }))}
              />
            )}

          {b.type === 'grid' && (
            <div class:list={['grid', `g${b.cols ?? 3}`]}>
              {((b.items ?? []) as BlockCard[]).map((i) => {
                const href = i.href ? H(i.href) : undefined;
                const Tag: any = href ? 'a' : 'div';
                return (
                  <Tag class="feature" href={href}>
                    {i.image && (
                      <Photo class="feature__media" src={i.image} alt={i.imageAlt ?? i.title} ratio="16/10" zoom sizes="(max-width: 680px) 100vw, (max-width: 1080px) 50vw, 33vw" />
                    )}
                    {i.icon && (
                      <span class="ico-tile">
                        <Icon name={i.icon} size={24} />
                      </span>
                    )}
                    <H3 class="h3">{i.title}</H3>
                    {i.text && <p>{i.text}</p>}
                    {i.meta && <span class="mono-label">{i.meta}</span>}
                    {href && <span class="feature__go">→</span>}
                  </Tag>
                );
              })}
            </div>
          )}

          {b.type === 'rows' && (
            <div class="rows">
              {((b.items ?? []) as BlockRow[]).map((i, n) => (
                <article class="row">
                  <span class="row__n num">{String(n + 1).padStart(2, '0')}</span>
                  <H3 class="h3">{i.title}</H3>
                  <p>{i.text}</p>
                </article>
              ))}
            </div>
          )}

          {b.type === 'table' && (
            <TableScroll locale={locale}>
              <table class:list={['table', { 'table--rates': b.plain }]}>
                {b.head?.length ? (
                  <thead>
                    <tr>{b.head.map((h) => <th scope="col">{fig(h, locale)}</th>)}</tr>
                  </thead>
                ) : null}
                <tbody>
                  {(b.rows ?? []).map((r) => (
                    <tr>
                      {r.map((cell, i) =>
                        b.head?.length ? <td set:html={figHtml(cell, locale)} /> : <th scope="row" set:html={figHtml(cell, locale)} />,
                      )}
                    </tr>
                  ))}
                </tbody>
              </table>
            </TableScroll>
          )}

          {b.type === 'steps' && (
            <ol class="steps">
              {((b.items ?? []) as BlockRow[]).map((s, i) => (
                <li>
                  <span class="steps__n num">{i + 1}</span>
                  <div>
                    <H3 class="h3">{s.title}</H3>
                    <p>{s.text}</p>
                  </div>
                </li>
              ))}
            </ol>
          )}

          {b.type === 'checklist' && (
            <ul class="checks">
              {((b.items as unknown as string[]) ?? []).map((x) => (
                <li>
                  <Icon name="check" size={18} />
                  <span>{x}</span>
                </li>
              ))}
            </ul>
          )}

          {b.type === 'callout' && (
            <div class:list={['callout', b.tone === 'gold' && 'callout--gold', b.image && 'callout--media']}>
              <div class="callout__body">
                {b.kicker && <p class="kicker">{b.kicker}</p>}
                <H3 class="h3">{b.title}</H3>
                {b.text && <p class="muted" style="margin-bottom:1rem">{b.text}</p>}
                {b.action && (
                  <a class="btn btn--sm" href={H(b.action.href)} data-quiz-open={b.action.href === '/request-stand/' ? '' : undefined} data-quiz-source="callout">{b.action.label}</a>
                )}
              </div>
              {b.image && (
                <Photo class="callout__fig" src={b.image} alt={b.imageAlt ?? b.title ?? ''} ratio="4/3" sizes="(max-width: 780px) 100vw, 320px" />
              )}
            </div>
          )}

          {b.type === 'files' && (
            <>
            <DownloadNotice locale={locale} hrefs={((b.items ?? []) as BlockFile[]).map(f => f.href)} />
            <div class="files">
              {((b.items ?? []) as BlockFile[]).map((f) => (
                <a href={H(f.href)} target={/^https?:/.test(f.href) ? '_blank' : undefined} rel="noopener" download={!/^https?:/.test(f.href)}>
                  <span class="files__ico">
                    <Icon name={f.kind === 'video' ? 'play' : f.kind === 'link' ? 'globe' : 'doc'} size={20} />
                  </span>
                  <span>
                    <b>{f.title}</b>
                    <small>{isSampleDownload(f.href) ? t('downloads.sample') : f.note ?? (f.href.endsWith('.pdf') ? 'PDF' : ru ? 'Материалы' : 'Material')}</small>
                  </span>
                  <span class="files__go">{ru ? 'Открыть' : 'Open'} →</span>
                </a>
              ))}
            </div>
            </>
          )}

          {b.type === 'gallery' && (
            <>
              {galleryGroups(b).map((album, gi) => {
                const AlbumTitle = b.title || H3 === 'h3' ? 'h3' : 'h2';
                return (
                  <section class="gal-album">
                    {album.title && <AlbumTitle class="gal-album__title">{album.title}</AlbumTitle>}
                    <div class="gal" data-cols={galLayout((album.items ?? []).length).cols}>
                      {((album.items ?? []) as BlockShot[]).map((g, i) => (
                        <div class:list={['gal__item', { 'gal__item--wd': i < galLayout((album.items ?? []).length).wideD, 'gal__item--wt': i < galLayout((album.items ?? []).length).wideT }]}>
                          <Photo src={g.src} alt={g.alt ?? g.caption ?? ''} ratio="4/3" zoom priority={gi === 0 && i === 0} sizes={i < Math.max(galLayout((album.items ?? []).length).wideD, galLayout((album.items ?? []).length).wideT) ? '(max-width: 680px) 100vw, 66vw' : '(max-width: 680px) 100vw, (max-width: 1080px) 50vw, 33vw'} />
                          {g.caption && <p class="gal__cap">{g.caption}</p>}
                        </div>
                      ))}
                    </div>
                  </section>
                );
              })}
            </>
          )}

          {b.type === 'rail' && <CalendarRail locale={locale} tone="light" count={b.railCount ?? 6} />}

          {b.type === 'partners' && (
            <PartnerLogoWall
              locale={locale}
              event={b.event}
              kicker={b.kicker}
              title={b.title}
              text={b.text}
            />
          )}

          {b.type === 'plan' && <VenuePlan locale={locale} />}

          {b.type === 'directory' && <ExhibitorDirectory locale={locale} event={b.event} />}

          {b.type === 'map' && <MapSchema locale={locale} />}

          {b.type === 'team' && <TeamWall locale={locale} />}

          {b.type === 'quote' && (
            <figure class="quote">
              <blockquote>{b.text}</blockquote>
              <figcaption>
                {b.author ?? b.cite}
                {b.role ? ` · ${b.role}` : ''}
              </figcaption>
            </figure>
          )}

          {b.type === 'links' && (
            <nav class="links" aria-label={b.title ?? (ru ? 'Связанные разделы' : 'Related sections')}>
              <p class="mono-label">{b.title ?? (ru ? 'Читать дальше' : 'Read next')}</p>
              <div class="links__row">
                {((b.items ?? []) as BlockLink[]).map((i) => (
                  <a href={H(i.href)}>
                    <b>{i.label}</b>
                    {i.note && <span>{i.note}</span>}
                  </a>
                ))}
              </div>
            </nav>
          )}

          {/* the section already carries b.id, so the form inside gets a derived id */}
          {b.type === 'form' && (
            <>
              {(b as any).formType === 'exhibitor' && (
                <ExhibitorForm locale={locale} eventName={b.event} id={b.id ? `${b.id}-form` : 'exhibitor-form'} />
              )}
              {(b as any).formType === 'visitor' && (
                <VisitorForm locale={locale} eventName={b.event} id={b.id ? `${b.id}-form` : 'visitor-form'} />
              )}
              {(b as any).formType === 'organizer' && (
                <OrganizerForm locale={locale} id={b.id ? `${b.id}-form` : 'organizer-form'} />
              )}
              {(b as any).formType === 'sponsor' && (
                <SponsorForm locale={locale} id={b.id ? `${b.id}-form` : 'sponsor-form'} />
              )}
              {(b as any).formType === 'callback' && (
                <CallbackForm locale={locale} id={b.id ? `${b.id}-form` : 'callback-form'} title={b.title} />
              )}
              {(b as any).formType === 'catalog' && (
                <CatalogForm locale={locale} eventName={b.event} id={b.id ? `${b.id}-form` : 'catalog-form'} />
              )}
              {(b as any).formType === 'group' && (
                <GroupVisitForm locale={locale} id={b.id ? `${b.id}-form` : 'group-form'} />
              )}
              {(b as any).formType === 'press' && (
                <LeadForm
                  level={H3 === 'h2' ? 2 : 3}
                  locale={locale}
                  title={b.title}
                  subtitle={b.text}
                  note={b.note}
                  id={b.id ? `${b.id}-form` : 'press-form'}
                  intent="press"
                />
              )}
              {!(b as any).formType && (
                <LeadForm
                  level={H3 === 'h2' ? 2 : 3}
                  locale={locale}
                  title={b.title}
                  subtitle={b.text}
                  directions={b.directions}
                  areas={b.areas?.map((a) => fig(a, locale))}
                  eventName={b.event}
                  note={b.note}
                  id={b.id ? `${b.id}-form` : 'lead-form'}
                />
              )}
            </>
          )}

          {b.type === 'quiz' && (
            <div class="quiz-block">
              <QuizForm
                locale={locale}
                title={b.title}
                subtitle={b.text}
                shows={b.shows}
                areas={b.areas}
                event={b.event}
                note={b.note}
                id={b.id ? `${b.id}-quiz` : 'quiz'}
              />
            </div>
          )}

          {b.type === 'faq' && <Faq locale={locale} items={(b.items as unknown as { q: string; a: string }[]) ?? []} title={b.title} topic={b.topic} />}

          {b.type === 'cta' && (
            <div class="cta-inline">
              <div>
                {b.kicker && <p class="kicker">{b.kicker}</p>}
                <h2 set:html={b.title ?? ''} />
                {b.text && <p class="lead">{b.text}</p>}
              </div>
              <div class="btn-row">
                {(b.actions ?? []).map((a, i) => (
                  <a class:list={['btn', { 'btn--gold': i === 0, 'btn--ghost': i > 0 }]} href={H(a.href)} data-quiz-open={a.href === '/request-stand/' ? '' : undefined} data-quiz-source="cta-inline">
                    {a.label}
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      </section>
      {showMidCta && (
        <section class="sec block block--mid-cta reveal">
          <div class="wrap">
            <SmartCta locale={locale} variant="card" intent={auto!.cta} />
          </div>
        </section>
      )}
      </>
    );
  })
}
{/* Auto CTA + Form injection */}
{auto && (
  <>
    <section class="sec block block--auto-cta reveal">
      <div class="wrap">
        <SmartCta locale={locale} variant="inline" intent={auto.cta} />
      </div>
    </section>
    {!hasForm && (
      <section class="sec block block--auto-form reveal">
        <div class="wrap">
          {auto.form === 'exhibitor' && <ExhibitorForm locale={locale} id="auto-exhibitor-form" />}
          {auto.form === 'visitor' && <VisitorForm locale={locale} id="auto-visitor-form" />}
          {auto.form === 'organizer' && <OrganizerForm locale={locale} id="auto-organizer-form" />}
          {auto.form === 'sponsor' && <SponsorForm locale={locale} id="auto-sponsor-form" />}
          {auto.form === 'callback' && <CallbackForm locale={locale} id="auto-callback-form" />}
          {auto.form === 'catalog' && <CatalogForm locale={locale} id="auto-catalog-form" />}
          {auto.form === 'group' && <GroupVisitForm locale={locale} id="auto-group-form" />}
        </div>
      </section>
    )}
  </>
)}

<style>
  .sec--sand { background: var(--cream-2); }
  /* the quiz reads best as a focused column, never stretched over a wide grid */
  .quiz-block { max-width: 760px; margin-inline: auto; }
  /* 2026-10 design (docs/18 §9): the page hero is two panels side by side — a white text panel
     and the photograph as its own full-height panel — instead of one panel with a thumbnail */
  .block--hero { background: none; padding-block: 0; border-radius: 0; overflow: visible; }
  .block--hero > .wrap { max-width: none; padding-inline: 0; }
  .block--tour .tour__head { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.2rem 2rem; align-items: end; margin-bottom: 1.25rem; }
  .block--tour .tour__intro h2 { margin: .2rem 0 .5rem; color: #fff; }
  .block--tour .tour__intro .lead { max-width: 68ch; margin: 0; color: rgba(255,255,255,.78); font-size: 1rem; }
  .block--tour .tour__actions { display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; }
  .block--tour .tour__actions .btn--ghost { color: #fff; border-color: rgba(255,255,255,.4); }
  .block--tour .tour__actions .btn--ghost:hover { border-color: var(--gold-soft); }
