---
/**
 * The host's own mark. For FOODERA that is the eight-pointed star from the organiser's badge:
 * geometrically it is two equal squares, one turned 45°, drawn as thick ribbons — blue and tan gold
 * exactly as in their file. It is typeset and vector, not a pasted PNG, so it stays sharp at 16px
 * (favicon), at 34px (header) and at 1200px (social card).
 *
 * `tone` is not a cosmetic switch: on a dark ground the square goes white and the diamond tan gold;
 * on paper the square takes the brand blue and the diamond the readable gold. Both pairs are
 * contrast-measured (`docs/07` §10), and `stroke` is set from CSS because `var()` is illegal in a
 * presentation attribute.
 *
 * `withWordmark` renders the name as real text (never outlined), which is what allows a screen reader
 * and a print stylesheet to read it.
 */
import type { SourceLocale as Locale } from '@/i18n/config';
import type { HostBrand } from '@/data/brands';

const { brand, size = 34, withWordmark = false, locale = 'ru' as Locale, tone = 'auto' } = Astro.props as {
  brand: HostBrand;
  size?: number;
  withWordmark?: boolean;
  locale?: Locale;
  tone?: 'auto' | 'on-dark' | 'on-light';
};
const p = brand.palette;
---

<span class:list={['bm', `bm--${tone}`]} style={`--bm-size:${size}px`}>
  <svg class="bm__mark" viewBox="0 0 64 64" width={size} height={size} aria-hidden="true" focusable="false">
    <g fill="none" stroke-width="7" stroke-linejoin="miter">
      <rect class="bm__a" x="15" y="15" width="34" height="34" />
      <rect class="bm__b" x="15" y="15" width="34" height="34" transform="rotate(45 32 32)" />
    </g>
  </svg>
  {
    withWordmark && (
      <span class="bm__txt">
        <b>{brand.name[locale]}</b>
        <span>{brand.sub[locale]}</span>
      </span>
    )
  }
</span>

<style>
  .bm {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    flex: none;
  }

  .bm__mark {
    display: block;
    flex: none;
  }

  /*
   * Which ribbon is which colour depends on the ground, and only on the ground: the brand blue is
   * 4.12 on paper but 2.52 on the host's own dark field, tan gold is 4.44 on dark and 2.34 on paper.
   * So the two strokes swap roles per tone rather than each call site passing hexes.
   */
  .bm--on-dark {
    --bm-a: #ffffff;
    --bm-b: var(--gold-soft);
  }

  .bm--on-light {
    --bm-a: var(--brand-mark);
    --bm-b: var(--gold);
  }

  .bm--auto {
    --bm-a: var(--brand-mark);
    --bm-b: var(--gold);
  }

  .bm__a {
    stroke: var(--bm-a);
  }

  .bm__b {
    stroke: var(--bm-b);
  }

  .bm__txt {
    display: grid;
    line-height: 1.05;
  }

  .bm__txt b {
    font-family: var(--f-display);
    font-size: 1.02rem;
    font-weight: 750;
    letter-spacing: -0.01em;
  }

  .bm__txt span {
    font-family: var(--f-mono);
    font-size: 0.66rem;
    letter-spacing: 0.09em;
    color: var(--ornament);
  }

  .bm--on-light .bm__txt span {
    color: var(--ink-40);
  }
</style>
