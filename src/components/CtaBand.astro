---
import type { SourceLocale as Locale } from '@/i18n/config';
import Icon from '@/components/Icon.astro';

const { locale, kicker, title, text, primary, secondary, dark = true } = Astro.props as {
  locale: Locale;
  kicker?: string;
  title: string;
  text?: string;
  primary: { label: string; href: string };
  secondary?: { label: string; href: string };
  dark?: boolean;
};
---
<section class:list={['sec', 'cta-band', { 'sec--forest': dark }]}>
  <div class="wrap">
    <div class="cta-band__in">
      <div>
        {kicker && <p class="kicker">{kicker}</p>}
        <h2 set:html={title} />
        {text && <p class="lead" style={dark ? 'color:rgba(255, 255, 255, .82)' : undefined}>{text}</p>}
      </div>
      <div class="cta-band__actions">
        <a class:list={['btn', { 'btn--light': dark }]} href={primary.href} data-quiz-open={primary.href === '/request-stand/' ? '' : undefined} data-quiz-source="cta-band">
          <Icon name="arrow" size={17} /> {primary.label}
        </a>
        {secondary && (
          <a
            class="btn btn--ghost"
            style={dark ? 'border-color:rgba(255, 255, 255, .4);color:rgba(255,255,255,.86)' : undefined}
            href={secondary.href}
            data-quiz-open={secondary.href === '/request-stand/' ? '' : undefined} data-quiz-source="cta-band"
          >
            {secondary.label}
          </a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .cta-band__in {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, auto);
    gap: 1.6rem 2.5rem;
    align-items: center;
  }
  .cta-band.sec--forest {
    position: relative;
    overflow: hidden;
  }
  .cta-band.sec--forest::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(70% 140% at 88% 10%, rgba(29, 122, 72, 0.5), transparent 60%),
      radial-gradient(50% 120% at 8% 100%, rgba(200, 136, 44, 0.16), transparent 62%);
    pointer-events: none;
  }
  .cta-band > :global(.wrap) {
    position: relative;
  }
  .cta-band h2 {
    font-size: clamp(1.7rem, 1.25rem + 1.8vw, 2.7rem);
    letter-spacing: -0.028em;
  }
  .cta-band h2 {
    max-width: 26ch;
  }
  .cta-band__actions {
    display: flex;
    gap: .7rem;
    flex-wrap: wrap;
  }
  .cta-band:not(.sec--forest) .btn--ghost {
    border-color: var(--line);
  }
  @media (max-width: 900px) {
    .cta-band__in {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
