---
import { localize, type Locale } from '@/i18n/config';
import type { ExpoEvent } from '@/data/events';
import { bigDate, industryColor, industryLabel } from '@/lib/labels';
import Icon from '@/components/Icon.astro';

interface Props {
  locale: Locale;
  event: ExpoEvent;
  priority?: boolean;
  variant?: 'default' | 'wide';
}
const { locale, event, priority = false, variant = 'default' } = Astro.props;
const href = localize(locale, `/events/${event.slug}/`);
const ru = locale === 'ru';
const d = bigDate(event.dates.start, event.dates.end, locale);
/** the industry colour only paints the 4px line — nothing else (docs/08 §3.4) */
const ic = industryColor(event.industry);
---

<article class:list={['ev', { 'ev--wide': variant === 'wide' }]}>
  <div class="ev__top">
    <a class="ev__date" href={href} aria-label={event.dates.display[locale]} style={`border-left:4px solid ${ic}`}>
      <b>{d.days}</b>
      <span>{d.month} {d.year}</span>
    </a>
    <figure class="ev__img">
      <img
        src={event.heroImage}
        alt={event.tagline[locale]}
        width="800"
        height="500"
        loading={priority ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={priority ? 'high' : 'auto'}
      />
    </figure>
  </div>
  <div class="ev__body">
    <p class="mono-label" style="margin:0">{industryLabel(event.industry, locale)}</p>
    <h3><a href={href}>{event.brand[locale]}</a></h3>
    <p class="ev__tagline">{event.tagline[locale]}</p>
    <div class="ev__foot">
      <span class="ev__sections">
        {event.categories.length} {ru ? 'разделов' : 'sections'}
        {event.status === 'past'
          ? ` · ${ru ? 'архив' : 'archive'}`
          : ru
            ? ' · идёт набор'
            : ' · sales open'}
      </span>
      <a class="ev__more" href={href}>
        {event.status === 'past' ? (ru ? 'Итоги' : 'Report') : (ru ? 'Подробнее' : 'Details')} <Icon name="arrow" size={14} />
      </a>
    </div>
  </div>
</article>

<style>
  .ev__more {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--ink);
    font-weight: 600;
    font-size: 0.85rem;
    text-decoration: none;
    white-space: nowrap;
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 1px;
  }
  .ev__more:hover {
    border-color: var(--ink);
  }
</style>
