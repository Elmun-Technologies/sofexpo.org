---
import { fig, figHtml } from '@/lib/figures';
/**
 * Per-event hero: brand plate, dates, venue, live countdown and the three actions
 * a visitor or exhibitor actually needs. Past editions get an archive treatment.
 */
import type { SourceLocale as Locale } from '@/i18n/config';
import { localize } from '@/i18n/config';
import { useUI } from '@/i18n/ui';
import { site } from '@/data/site';
import { CURRENT_BRAND } from '@/data/hosts';
import ShowLogo from '@/components/ShowLogo.astro';
import { logoFor } from '@/lib/showLogos';
import Ornament from '@/components/Ornament.astro';
import type { ExpoEvent } from '@/data/events';
import Countdown from '@/components/Countdown.astro';
import Icon from '@/components/Icon.astro';
import Photo from '@/components/Photo.astro';
import { bigDate, industryLabel } from '@/lib/labels';
import { eventIcsPath } from '@/lib/ics';
import { archive } from '@/data/archive';
import { brandForEvent } from '@/data/brands';

const { locale, event, kicker, title, lead, variant = 'open', soloKicker = false } = Astro.props as {
  locale: Locale;
  event: ExpoEvent;
  kicker?: string;
  /** the page's own kicker is enough — do not append the edition line (show pages) */
  soloKicker?: boolean;
  title: string;
  lead?: string;
  variant?: 'open' | 'past';
};
const t = useUI(locale);
const ru = locale === 'ru';
const L = (p: string) => localize(locale, p);
const upcoming = variant === 'open';
/* a show whose logo is drawn on white gets a light hero in its own tint (brand-map.json `hero`) */
const light = brandForEvent(event.slug)?.hero === 'light';
/* the hero highlight is one sentence per show — printed on the overview only */
const showHighlight = Astro.props.showHighlight ?? true;
const d = bigDate(event.dates.start, event.dates.end, locale);
const days = Math.max(
  1,
  Math.round(
    (new Date(`${event.dates.end}T12:00:00+05:00`).getTime() -
      new Date(`${event.dates.start}T12:00:00+05:00`).getTime()) /
      864e5,
  ) + 1,
);
/* The dates of the one show you are coming to, as a file — next to the show's own page
   on the host that owns it (src/lib/ics.ts). */
const ics = eventIcsPath(event.slug, event.dates.start);
/* a finished edition offers its report and the coming shows — not a ticket, a calendar file
   or a "next edition" link that pointed back at this very page */
const report = upcoming ? undefined : archive.find((x) => x.eventSlug === event.slug);
const actions: { label: string; href: string; icon?: string; download?: boolean }[] = upcoming
  ? [
      { label: t('cta.stand'), href: L('/request-stand/') + `?event=${event.slug}` },
      { label: t('cta.ticket'), href: L('/visitors/tickets/') },
      { label: ru ? 'Программа' : 'Programme', href: L(`/events/${event.slug}/program/`) },
      ...(ics ? [{ label: ru ? 'В календарь' : 'Add to calendar', href: ics, icon: 'calendar', download: true }] : []),
    ]
  : [
      { label: ru ? 'Отчёт по итогам' : 'Post-show report', href: L(report ? `/events/past/${report.id}/` : '/events/past/') },
      { label: ru ? 'Все выставки' : 'All exhibitions', href: L('/events/') },
      { label: ru ? 'Программа' : 'Programme', href: L(`/events/${event.slug}/program/`) },
    ];
/* "Food and beverage exhibition · Specialised food and beverage exhibition in Uzbekistan"
   said the same thing twice: drop the industry label when the edition line already names it */
const lead1 = kicker ?? industryLabel(event.industry, locale);
const edition = event.edition[locale];
const norm = (v: string) => v.toLowerCase().replace(/[^\p{L}\p{N} ]/gu, '');
const words = (v: string) => norm(v).split(' ').filter((w) => w.length > 2);
const editionWords = new Set(words(edition));
const shared = words(lead1).filter((w) => editionWords.has(w)).length;
const heroKicker =
  /* a page that names its own kicker ("FOODERA 2026 programme") says enough on its own */
  kicker && soloKicker ? kicker
  : shared >= Math.ceil(words(lead1).length * 0.6) ? edition
  : norm(lead1).includes(norm(edition)) ? lead1 /* "Education exhibition · spring" + "SPRING" */
  : `${lead1} · ${edition}`;
---

<!-- 2026-10 design (docs/18 §8): two panels — the show's own ground with the logo, the H1, the
     date as the loudest figure and the booking action; beside it the hall photo carrying the
     countdown. A visitor's first screen owes them facts (dates, venue, days left). -->
<section class:list={['ehero', { 'ehero--past': !upcoming, 'ehero--light': light }]}>
  <div class="ehero__main">
    <ShowLogo slug={event.slug} height={logoFor(event.slug)?.round ? 88 : 56} class="ehero__logo" eager />
    {/* the kicker names the industry ("Food and beverage exhibition"), the query a show page
        ranks for, so it sits inside the h1 (docs/16 §2.2) */}
    <h1><span class="kicker">{heroKicker}</span> <Fragment set:html={title} /></h1>
    <p class="ehero__date">
      <b>{d.days}</b>
      <span>{d.month} {d.year}</span>
    </p>
    {lead && <p class="hero__lead">{lead}</p>}
    <ul class="ehero__facts">
      <li><Icon name="pin" size={17} /> {site.brand[locale]}</li>
      <li>
        <Icon name="clock" size={17} /> {days} {ru ? (days === 1 ? 'день' : days < 5 ? 'дня' : 'дней') : days === 1 ? 'day' : 'days'} · {ru ? 'Самарканд, Джамбайский район' : 'Samarkand, Dzhambay district'}
      </li>
      {event.status === 'open' && <li class="chip chip--live"><span class="dot" /> {ru ? 'Идёт набор участников' : 'Exhibitor sales open'}</li>}
    </ul>
    <div class="btn-row">
      {actions.map((a, i) => (
        <a
          class:list={['btn', { 'btn--show': i === 0 && upcoming, 'btn--light': i === 0 && !upcoming, 'btn--ghost': i > 0 }]}
          href={a.href}
          download={a.download ? `${event.slug}-${event.dates.start.slice(0, 4)}.ics` : undefined}
        >
          {a.icon && <Icon name={a.icon} size={15} />}
          {a.label}
        </a>
      ))}
    </div>
    {event.highlight && upcoming && showHighlight && (
      <p class="ehero__note">
        <Icon name="sparkle" size={15} /> <b>{event.highlight.label[locale]}</b> —{' '}
        {event.highlight.text[locale]}
      </p>
    )}
    {CURRENT_BRAND?.ornament && <Ornament variant="band" height={26} />}
  </div>
  <div class="ehero__media">
    <div class="ehero__photo">
      <Photo
        src={event.heroImage}
        alt={event.tagline[locale]}
        ratio="4/5"
        rounded={false}
        priority
        sizes="(max-width: 900px) 100vw, 42vw"
      />
      <div class="ehero__count">
        {upcoming ? <Countdown locale={locale} target={event.dates.start} label={ru ? 'До открытия' : 'Opening in'} /> : (
          <div class="ehero__archive">
            <p class="mono-label">{ru ? 'Прошедшая редакция' : 'Past edition'}</p>
            <ul>
              {event.facts.slice(0, 4).map((f) => <li><b class="num">{fig(f.value, locale)}</b> {f.label[locale]}</li>)}
            </ul>
          </div>
        )}
      </div>
    </div>
    <dl class="ehero__key">
      <div><dt>{ru ? 'Площадка' : 'Venue'}</dt><dd>{site.brand[locale]}</dd></div>
      <div><dt>{ru ? 'Город' : 'City'}</dt><dd>{site.location.region[locale]}</dd></div>
      <div><dt>{ru ? 'Организатор' : 'Organizer'}</dt><dd>{ru ? site.brand.legal : site.brand.legalEn}</dd></div>
    </dl>
  </div>
</section>

<style>
  /* a bare row: the two children are the panels (main > section is a panel elsewhere) */
  .ehero {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap);
    background: none;
    border-radius: 0;
    overflow: visible;
    padding: 0;
  }
  .ehero__main {
    position: relative;
    flex: 1.15 1 560px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(24px, 4vw, 56px);
    border-radius: var(--r-panel);
    background: var(--evergreen);
    color: rgba(255, 255, 255, 0.86);
    overflow: hidden;
  }
  /* the show's logo colours as a band across the top of its panel (--brand-stripe, brands.ts) */
  .ehero__main::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 6px;
    background: var(--brand-stripe);
  }
  /* the show's motif from its logo (--brand-pattern, brands.ts), fading in towards the right so
     it never sits under the headline */
  .ehero__main::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--brand-pattern, none) 0 0 / var(--brand-pattern-size, 120px) repeat;
    -webkit-mask-image: linear-gradient(105deg, transparent 38%, #000 88%);
    mask-image: linear-gradient(105deg, transparent 38%, #000 88%);
    pointer-events: none;
  }
  /* one column on a phone: the buttons span the full width, so the motif stays in the top
     corner next to the logo plate instead of running behind the actions */
  @media (max-width: 900px) {
    .ehero__main::after {
      -webkit-mask-image: radial-gradient(90% 260px at 100% 0, #000, transparent);
      mask-image: radial-gradient(90% 260px at 100% 0, #000, transparent);
    }
  }
  .ehero__main > :global(*) {
    position: relative;
    z-index: 1;
  }
  /* the main action wears the show's accent (FOODERA gold, AGROPRO sun yellow, WORLD EDU
     cyan …); gold-soft on evergreen is ≥ 4.5:1 for every show (check-brand-contrast) */
  .ehero :global(.btn--show) {
    --btn-bg: var(--gold-soft);
    --btn-fg: var(--evergreen);
    background: var(--gold-soft);
    border-color: var(--gold-soft);
    color: var(--evergreen);
  }
  .ehero :global(.btn--show:hover) {
    background: #fff;
    border-color: #fff;
    color: var(--evergreen);
  }
  .ehero__main :global(.ehero__logo) {
    margin-bottom: clamp(1.2rem, 0.6rem + 2vw, 2.4rem);
    padding: 10px 16px;
    border-radius: 16px;
    background: #fff;
  }
  .ehero h1 {
    color: #fff;
    font-size: clamp(2.125rem, 1rem + 3.6vw, 4.5rem);
    letter-spacing: -0.04em;
    line-height: 0.98;
    max-width: 16ch;
    margin: 0;
  }
  .ehero :global(h1 > .kicker) {
    color: rgba(255, 255, 255, 0.72);
    margin-bottom: 1rem;
  }
  /* the date is the loudest figure in the hero, like on the home */
  .ehero__date {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.2rem 0.8rem;
    margin: clamp(1.2rem, 0.8rem + 1.5vw, 2rem) 0 0;
  }
  .ehero__date b {
    font-family: var(--f-display);
    font-size: clamp(3.5rem, 2rem + 5vw, 6.5rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 0.9;
    color: #fff;
  }
  .ehero__date span {
    font-family: var(--f-display);
    font-size: clamp(1.1rem, 0.9rem + 0.8vw, 1.6rem);
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.6);
  }
  .hero__lead {
    color: rgba(255, 255, 255, 0.86);
    max-width: 58ch;
    margin: 1.2rem 0 0;
  }
  .ehero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
    list-style: none;
    padding: 0;
    margin: 1.4rem 0 1.6rem;
    font-size: 0.95rem;
  }
  .ehero__facts li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: rgba(255, 255, 255, 0.9);
  }
  .ehero__main .btn-row {
    margin-top: auto;
  }
  .ehero__note {
    display: block;
    margin: 1rem 0 0;
    padding: 10px 16px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.24);
    font-size: 0.875rem;
  }
  .ehero__media {
    flex: 1 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--gap);
  }
  .ehero__photo {
    position: relative;
    flex: 1;
    min-height: 320px;
    border-radius: var(--r-panel);
    overflow: hidden;
    background: var(--evergreen);
  }
  .ehero__photo :global(.ph) {
    position: absolute;
    inset: 0;
    height: 100%;
    aspect-ratio: auto;
  }
  .ehero__count {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
  }
  .ehero__count :global(.cd-wrap),
  .ehero__archive {
    padding: 14px 16px 6px;
    border-radius: var(--r-lg);
    background: color-mix(in srgb, var(--evergreen) 82%, transparent);
    backdrop-filter: blur(14px);
    color: #fff;
  }
  .ehero__count :global(.mono-label),
  .ehero__archive :global(.mono-label) {
    color: rgba(255, 255, 255, 0.8);
  }
  .ehero__archive {
    padding-bottom: 14px;
  }
  .ehero__archive ul {
    list-style: none;
    margin: 0.6rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.86);
  }
  .ehero__archive b {
    font-family: var(--f-display);
    font-size: 1.3rem;
    color: var(--gold-soft);
    margin-right: 0.3rem;
  }
  .ehero__key {
    margin: 0;
    display: grid;
    gap: 10px;
    padding: 20px 24px;
    border-radius: var(--r-panel);
    background: var(--paper);
    color: var(--ink);
    font-size: 0.9rem;
  }
  .ehero__key div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .ehero__key dt {
    color: var(--ink-60);
  }
  .ehero__key dd {
    margin: 0;
    text-align: right;
    font-weight: 600;
  }
  @media (min-width: 901px) {
    .ehero__main {
      min-height: 640px;
    }
  }

  /* ---------- light hero: logos drawn on white (FOODERA, AGROPRO, WORLD EDU) ----------
     the panel is white tinted with the show's mark colour, text in the show's own dark ink,
     the motif drawn in the mark colour, the booking action in the show's deep colour */
  .ehero--light .ehero__main {
    background: var(--brand-tint, #fff);
    color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .ehero--light .ehero__main::after {
    background: var(--brand-mark);
    opacity: 0.32;
    -webkit-mask-image: var(--brand-pattern), linear-gradient(105deg, transparent 42%, #000 92%);
    mask-image: var(--brand-pattern), linear-gradient(105deg, transparent 42%, #000 92%);
    -webkit-mask-size: var(--brand-pattern-size, 120px), 100% 100%;
    mask-size: var(--brand-pattern-size, 120px), 100% 100%;
    -webkit-mask-repeat: repeat, no-repeat;
    mask-repeat: repeat, no-repeat;
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }
  @media (max-width: 900px) {
    .ehero--light .ehero__main::after {
      -webkit-mask-image: var(--brand-pattern), radial-gradient(90% 260px at 100% 0, #000, transparent);
      mask-image: var(--brand-pattern), radial-gradient(90% 260px at 100% 0, #000, transparent);
    }
  }
  .ehero--light .ehero__main :global(.ehero__logo) {
    padding: 0;
    background: transparent;
  }
  .ehero--light h1,
  .ehero--light .ehero__date b {
    color: var(--evergreen);
  }
  .ehero--light :global(h1 > .kicker),
  .ehero--light .ehero__date span {
    color: var(--ink-60);
  }
  .ehero--light .hero__lead,
  .ehero--light .ehero__facts li {
    color: var(--ink);
  }
  .ehero--light .ehero__facts :global(svg) {
    color: var(--gold);
  }
  .ehero--light :global(.btn--show) {
    --btn-bg: var(--evergreen);
    --btn-fg: #fff;
    background: var(--evergreen);
    border-color: var(--evergreen);
    color: #fff;
  }
  .ehero--light :global(.btn--show:hover) {
    background: var(--evergreen-2);
    border-color: var(--evergreen-2);
    color: #fff;
  }
  .ehero--light :global(.btn--ghost) {
    --btn-fg: var(--ink);
    background: #fff;
    border-color: var(--line-strong);
    color: var(--ink);
  }
  .ehero--light :global(.btn--ghost:hover) {
    --btn-fg: var(--evergreen);
    background: #fff;
    border-color: var(--evergreen);
    color: var(--evergreen);
  }
  .ehero--light .ehero__note {
    background: #fff;
    border-color: var(--line);
    color: var(--ink);
  }
</style>
