---
/** Shared composition for an exhibition cluster page: hero → data blocks → authored copy → data blocks. */
import type { SourceLocale as Locale } from '@/i18n/config';
import { localize } from '@/i18n/config';
import { useUI } from '@/i18n/ui';
import type { ExpoEvent } from '@/data/events';
import type { EventPage } from '@/data/pages/event-pages';
import { abs, breadcrumbJsonLd, eventJsonLd, faqJsonLd, organizationJsonLd } from '@/lib/seo';
import { pageCrumbs } from '@/lib/nav';
import Base from '@/layouts/Base.astro';
import EventHero from '@/components/EventHero.astro';
import EventNav from '@/components/EventNav.astro';
import EventSections from '@/components/EventSections.astro';
import type { SectionKey } from '@/components/EventSections.astro';
import Blocks from '@/components/Blocks.astro';
import CtaBand from '@/components/CtaBand.astro';
import PostCard from '@/components/PostCard.astro';
import SectionHead from '@/components/SectionHead.astro';
import PartnerLogoWall from '@/components/PartnerLogoWall.astro';
import { getCollection } from 'astro:content';
import { events } from '@/data/events';
import { eventPages } from '@/data/pages/event-pages';
import { brandForEvent } from '@/data/brands';
import { speakers as speakerWall } from '@/data/speakers';

const { locale, event, page } = Astro.props as { locale: Locale; event: ExpoEvent; page: EventPage };
/* a branded show unfurls with its own social card, not the AI hall render */
const ogCard = brandForEvent(event.slug);
const t = useUI(locale);
const ru = locale === 'ru';
const L = (p: string) => localize(locale, p);
const meta = page.meta[locale];
const blocks = page.blocks[locale];
const crumbs = pageCrumbs(locale, page.path);
const heroBlocks = [page.hero];
const past = event.status === 'past';
const trail = [
  { name: 'SOF EXPO Samarkand', url: abs(`/${locale}/`) },
  { name: ru ? 'Афиша' : 'Line-up', url: abs(L('/events/')) },
  { name: event.brand[locale], url: abs(L(`/events/${event.slug}/`)) },
  ...(page.path === `/events/${event.slug}/` ? [] : [{ name: meta.title.split(' — ')[0], url: abs(L(page.path)) }]),
];
/* The 37 poster speakers live in their own dataset keyed by nothing but the edition, so the
   e-com show is the one event that can currently name a line-up. Other shows carry the
   text-only `speakers` array on the event record; both feed the same Person markup. */
const posterSpeakers = event.slug === 'ecom-retail-expo'
  ? speakerWall.map((s) => ({ name: s.name[locale], jobTitle: s.role[locale], org: s.org }))
  : (event.speakers ?? []).map((s) => ({
      name: s.name,
      jobTitle: s.role[locale],
      org: s.org,
    }));

const ld: Record<string, unknown>[] = [
  organizationJsonLd(),
  eventJsonLd({ ...event, locale, performers: posterSpeakers }),
];
const _kind = page.path.split('/').filter(Boolean)[2] ?? 'overview';
const _owner = ['exhibitors', 'overview', 'visitors', 'program'].find((k) => ((eventPages[event.slug] as any)?.[k]?.after ?? []).includes('faq'));
const renderFaq = ((page.after ?? []) as string[]).includes('faq') && _kind === _owner;
const faq = blocks.find((b) => b.type === 'faq');
if (faq?.items?.length) ld.push(faqJsonLd(faq.items as never, L(page.path)));
else if (renderFaq && event.faq.length)
  ld.push(faqJsonLd(event.faq.map((f) => ({ q: f.q[locale], a: f.a[locale] })), L(page.path)));
ld.push(breadcrumbJsonLd(trail));
/* editorial that talks about this exact show — inbound link for the article,
   reading time for the visitor, and topical depth for the cluster */
const reading = (
  await Promise.all(
    (['articles', 'news'] as const).map(async (kind) =>
      (await getCollection(kind, ({ data }: any) => !data.draft))
        .filter((e: any) => e.id.startsWith(`${locale}/`) && e.data.event === event.slug)
        .map((e: any) => ({ entry: e, kind })),
    ),
  )
)
  .flat()
  .sort((a: any, b: any) => b.entry.data.date.getTime() - a.entry.data.date.getTime())
  .slice(0, 6);

/* one CTA line per page of the cluster, so four pages of one show never repeat a paragraph */
const kind = page.path.split('/').filter(Boolean)[2] ?? 'overview';
const name = event.brand[locale];
const when = event.dates.display[locale];
const ctaText = past
  ? ru
    ? `${name} завершилась. Оставьте заявку — пришлём даты следующей редакции и условия раннего бронирования.`
    : `${name} has closed. Leave a request and we will send the next edition's dates and early-booking terms.`
  : ({
      overview: ru
        ? `${name}, ${when}, Самарканд. Укажите продукт и площадь — пришлём план зала и расчёт.`
        : `${name}, ${when}, Samarkand. Name your product and area — we send the floor plan and a quote.`,
      exhibitors: ru
        ? `Места на ${event.shortName} распределяются по дате заявки: удержим выбранную локацию на 3–5 дней без оплаты.`
        : `Space at ${event.shortName} goes in order of request: we hold the location you pick for 3–5 days, no payment.`,
      visitors: ru
        ? `Хотите не только посетить ${event.shortName}, но и показать свой продукт? Стенд можно забронировать до открытия.`
        : `Want to show your own product at ${event.shortName}, not just walk the aisles? Stands can be booked until opening.`,
      program: ru
        ? `Слоты деловой программы ${event.shortName} — для экспонентов и партнёров. Заявка на стенд открывает доступ к выступлению.`
        : `Business-programme slots at ${event.shortName} go to exhibitors and partners first — a stand request opens the door to a talk.`,
    } as Record<string, string>)[kind] ?? (ru ? `Заявка на участие в ${name}.` : `Request to exhibit at ${name}.`);

/* editorial cards: overview shows the newest three, programme the next three; the
   exhibitor/visitor pages keep their own content and do not repeat the same cards */
const readingHere = kind === 'overview' ? reading.slice(0, 3) : kind === 'program' ? (reading.slice(3, 6).length ? reading.slice(3, 6) : []) : [];
const before = (page.before ?? []) as SectionKey[];
/* The show FAQ is one set of questions; repeating it on 3–4 pages of a cluster is the
   textbook duplicate-FAQ pattern. It lives on ONE page of the cluster — exhibitors if that
   page has it, otherwise the first page that asks for it. */
const cluster = ['exhibitors', 'overview', 'visitors', 'program'];
const faqOwner = _owner;
const after = ((page.after ?? []) as SectionKey[]).filter((s) => s !== 'faq' || kind === faqOwner);
---

<Base
  {locale}
  title={meta.title}
  description={meta.description}
  path={page.path}
  image={page.image ?? (ogCard ? `/brand/${ogCard.id}/og.jpg` : event.heroImage)}
  noindex={page.noindex}
  breadcrumbs={crumbs}
  jsonLd={ld}
  preload={page.image ?? event.heroImage}
>
  <EventHero
    {locale}
    {event}
    variant={past ? 'past' : 'open'}
    kicker={page.hero.kicker[locale]}
    title={page.hero.title[locale]}
    lead={page.hero.lead[locale]}
    bullets={page.hero.bullets?.map((b) => b[locale])}
    showHighlight={kind === 'overview'}
  />
  <EventNav {locale} {event} {past} active={page.path} />
  {before.map((s) => <EventSections {locale} {event} section={s} tone={s === 'facts' ? 'forest' : 'default'} />)}
  <Blocks {blocks} {locale} />
  {after.map((s) => <EventSections {locale} {event} section={s} />)}
  {
    kind === 'overview' && (
      <section class="sec sec--sand">
        <div class="wrap">
          <PartnerLogoWall
            locale={locale}
            event={event.slug}
            kicker={ru ? 'Партнёры и соорганизаторы' : 'Partners and co-organizers'}
            title={ru ? `${event.brand[locale]} проходит при поддержке` : `${event.brand[locale]} is held with support from`}
            text={ru
              ? 'Полный список — на странице «Партнёры».'
              : 'Full list and partnership terms are on the Partners page.'}
          />
        </div>
      </section>
    )
  }
  {
    readingHere.length > 0 && (
      <section class="sec sec--sand">
        <div class="wrap">
          <SectionHead
            locale={locale}
            kicker={ru ? 'Читать по теме' : 'Read next'}
            title={ru ? 'Разборы рынка вокруг этой выставки' : 'Market breakdowns around this show'}
          />
          <div class="grid g3">
            {readingHere.map(({ entry, kind }) => (
              <PostCard {locale} post={entry} path={kind === 'articles' ? '/articles/' : '/news/'} />
            ))}
          </div>
        </div>
      </section>
    )
  }
  <CtaBand
    locale={locale}
    kicker={page.path === `/events/${event.slug}/` ? (ru ? 'Следующее событие' : 'Next event') : undefined}
    title={past
      ? ru ? 'Участвовать в следующей редакции' : 'Take part in the next edition'
      : ru ? 'Забронировать место на выставке' : 'Reserve your place at the show'}
    text={ctaText}
    primary={{ label: t('cta.stand'), href: L('/request-stand/') }}
    secondary={{ label: ru ? 'Все выставки' : 'All shows', href: L('/events/') }}
  />

  {/* mobile (docs/08 §4.13): the primary action stays reachable while the page scrolls —
      sticky, state-only, 56px; the footer and CtaBand above already serve desktop */}
  <div class="m-cta">
    <span class="m-cta__txt">
      <b>{event.shortName}</b>
      <span>{event.dates.display[locale]}</span>
    </span>
    <a class="btn btn--sm btn--light" href={past ? L(`/events/${event.slug}/`) : L('/request-stand/') + `?event=${event.slug}`}>
      {past ? (ru ? 'Следующая редакция' : 'Next edition') : t('cta.stand')}
    </a>
  </div>
</Base>

<style>
  /* mobile-first (docs/08 §4.13): on a phone the primary action stays reachable
     while the page scrolls — sticky, state-only, 56px; the footer and CtaBand
     above already serve the wide screens */
  .m-cta {
    position: sticky;
    bottom: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    min-height: 56px;
    background: var(--evergreen);
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    padding: 0.55rem var(--gutter);
  }
  .m-cta__txt {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
    min-width: 0;
  }
  .m-cta__txt b {
    font-family: var(--f-display);
    font-size: 0.95rem;
    letter-spacing: -0.01em;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .m-cta__txt span {
    font-family: var(--f-mono);
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    color: var(--gold-soft);
  }
  @media (min-width: 780px) {
    .m-cta {
      display: none;
    }
  }
</style>
