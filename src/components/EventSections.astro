---
import { fig } from '@/lib/figures';
/**
 * Data-driven sections for an exhibition page. Authored copy lives in
 * `src/data/pages/event-pages.ts`; these blocks pull the per-event facts out of
 * `src/data/events.ts` so every show reports its own numbers, sections and materials.
 */
import type { SourceLocale as Locale } from '@/i18n/config';
import { localize } from '@/i18n/config';
import type { ExpoEvent } from '@/data/events';
import { site } from '@/data/site';
import { events } from '@/data/events';
import { sectionsOf } from '@/data/pages/sections';
import { humanDate } from '@/lib/labels';
import SectionHead from '@/components/SectionHead.astro';
import FeatureGrid from '@/components/FeatureGrid.astro';
import StatBand from '@/components/StatBand.astro';
import Faq from '@/components/Faq.astro';
import EventCard from '@/components/EventCard.astro';
import Icon from '@/components/Icon.astro';
import DownloadNotice from '@/components/DownloadNotice.astro';
import { isSampleDownload } from '@/lib/downloads.mjs';
import { useUI } from '@/i18n/ui';
import SpeakerWall from '@/components/SpeakerWall.astro';
import { speakers as posterSpeakers } from '@/data/speakers';

/* the union lives in a .ts module so plain TypeScript files can import it too */
import type { SectionKey } from '@/data/pages/types';
export type { SectionKey };

const { locale, event, section, tone = 'paper' } = Astro.props as {
  locale: Locale;
  event: ExpoEvent;
  section: SectionKey;
  tone?: 'paper' | 'default' | 'forest';
};
const ru = locale === 'ru';
const L = (p: string) => localize(locale, p);
const head = {
  facts: { k: ru ? 'Цифры и факты' : 'Facts and figures', t: ru ? 'Что это за выставка в числах' : 'The show in numbers', text: event.pitch[locale] },
  categories: { k: ru ? 'Тематические разделы' : 'Sections', t: ru ? 'Что показывают на выставке' : 'What is on show', text: undefined },
  benefits: { k: ru ? 'Зачем участвовать' : 'Why take part', t: ru ? 'Четыре задачи, которые решает выставка' : 'Four jobs an exhibition actually does', text: undefined },
  programme: { k: ru ? 'Деловая программа' : 'Business programme', t: ru ? 'Программа, а не только экспозиция' : 'A programme, not only stands', text: undefined },
  audience: { k: ru ? 'Кто приходит' : 'Who attends', t: ru ? 'Аудитория выставки' : 'The audience of the show', text: undefined },
  stands: { k: ru ? 'Форматы участия' : 'Participation formats', t: ru ? 'Как можно присутствовать' : 'Ways to be present', text: undefined },
  speakers: { k: ru ? 'Спикеры' : 'Speakers', t: ru ? 'Кто выступает' : 'Who speaks', text: undefined },
  materials: { k: ru ? 'Материалы' : 'Materials', t: ru ? 'Скачать до переговоров' : 'Download before you negotiate', text: undefined },
  faq: { k: '', t: '', text: undefined },
  buyers: { k: ru ? 'Программа закупщика' : 'Buyer programme', t: ru ? 'Приезжайте на переговоры, а не на прогулку' : 'Arrive for meetings, not for a walk', text: undefined },
  matchmaking: { k: ru ? 'Биржа контактов' : 'Meeting marketplace', t: ru ? 'Встречи, назначенные до открытия' : 'Meetings booked before the doors open', text: undefined },
  award: { k: ru ? 'Конкурс' : 'Contest', t: ru ? 'Лучший продукт выставки' : 'Best product of the show', text: undefined },
  related: { k: ru ? 'Другие события' : 'Other events', t: ru ? 'Следующие выставки центра' : 'Next shows at the centre', text: undefined },
  venue: { k: ru ? 'Где проходит' : 'Where', t: ru ? 'Один зал, одна площадка, минимум логистики' : 'One hall, one site, minimal logistics', text: undefined },
}[section];

const segments = sectionsOf(event.slug);
const peers = events.filter((e) => e.slug !== event.slug).slice(0, 3);

/* E-COM & RETAIL is the one show whose speaker line-up arrived as finished poster artwork
   (37 cards, two editions). Where that exists it replaces the text-only cards entirely. */
const hasPosters = event.slug === 'ecom-retail-expo' && posterSpeakers.length > 0;

/* Programme grouped by show day: the number becomes a real date (20 октября), the way
   Ekspocentr and Crocus present theirs. Entries without `day` fall into day 1. */
const progDays: { day: number; label: string; items: typeof event.program }[] = (() => {
  if (section !== 'programme') return [];
  const byDay = new Map<number, typeof event.program>();
  for (const p of event.program) {
    const d = p.day ?? 1;
    byDay.set(d, [...(byDay.get(d) ?? []), p]);
  }
  return [...byDay.entries()].sort((a, b) => a[0] - b[0]).map(([day, items]) => {
    const date = new Date(`${event.dates.start}T12:00:00+05:00`);
    date.setDate(date.getDate() + (day - 1));
    return { day, label: humanDate(date, locale), items };
  });
})();
---

{
  section === 'facts' && (
    <section class:list={['sec', 'reveal', `sec--${tone}`]}>
      <div class="wrap">
        <SectionHead locale={locale} kicker={head.k} title={head.t} text={head.text} />
        <StatBand
          locale={locale}
          items={event.facts.map((f) => ({ value: f.value, ru: f.label.ru, en: f.label.en }))}
        />
      </div>
    </section>
  )
}

{
  section === 'categories' && (
    <section class:list={['sec', 'reveal', `sec--${tone}`]}>
      <div class="wrap">
        <SectionHead locale={locale} kicker={head.k} title={head.t} text={head.text} />
        {/* docs/13 §P1-2 (FHA): where a show has a landing page per segment, the
            category list becomes a directory of links with a line of copy each —
            twelve crawlable entries, not twelve labels. Shows without section
            pages keep the plain chips, so nothing else changes. */}
        {segments.length > 0 ? (
          <div class="cats cats--dir">
            {event.categories.map((c) => {
              const seg = segments.find((x) => x.title.en === c.name.en);
              return seg ? (
                <a class="cats__seg" href={L(`/events/${event.slug}/sections/${seg.slug}/`)}>
                  <span class="cats__h">
                    <Icon name={c.icon} size={18} />
                    {seg.title[locale]}
                  </span>
                  <span class="cats__lead">{seg.lead[locale]}</span>
                </a>
              ) : (
                <span class="cats__i">
                  <Icon name={c.icon} size={18} />
                  {c.name[locale]}
                </span>
              );
            })}
          </div>
        ) : (
          <div class="cats">
            {event.categories.map((c) => (
              <span class="cats__i">
                <Icon name={c.icon} size={18} />
                {c.name[locale]}
              </span>
            ))}
          </div>
        )}
      </div>
    </section>
  )
}

{
  section === 'benefits' && (
    <section class:list={['sec', 'reveal', `sec--${tone}`]}>
      <div class="wrap">
        <SectionHead locale={locale} kicker={head.k} title={head.t} text={head.text} />
        <FeatureGrid
          locale={locale}
          cols={2}
          items={event.benefits.map((b) => ({ title: b.title[locale], text: b.text[locale], icon: 'check' }))}
        />
      </div>
    </section>
  )
}

{
  section === 'programme' && (
    <section class:list={['sec', 'reveal', `sec--${tone}`]}>
      <div class="wrap">
        <SectionHead locale={locale} kicker={head.k} title={head.t} text={head.text}>
          <a slot="aside" class="btn btn--sm btn--ghost" href={L('/visitors/programme/')}>
            {ru ? 'Как устроены сессии' : 'How sessions work'}
          </a>
        </SectionHead>
        <div class="prog">
          {progDays.map((g) => (
            <div class="prog__day">
              <div class="prog__head">
                <span class="prog__n num">{String(g.day).padStart(2, '0')}</span>
                <div>
                  <b>{g.label}</b>
                  <small>{ru ? `День ${g.day} · ${g.items.length} ${g.items.length === 1 ? 'мероприятие' : g.items.length < 5 ? 'мероприятия' : 'мероприятий'}` : `Day ${g.day} · ${g.items.length} item${g.items.length === 1 ? '' : 's'}`}</small>
                </div>
              </div>
              <ul>
                {g.items.map((p) => (
                  <li>
                    <b>{p.title[locale]}</b>
                    <span>{p.text[locale]}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

{
  section === 'audience' && (
    <section class:list={['sec', 'reveal', `sec--${tone}`]}>
      <div class="wrap">
        <SectionHead locale={locale} kicker={head.k} title={head.t} text={head.text} />
        <ul class="aud">
          {event.audience.map((a) => (
            <li>
              <Icon name="users" size={18} />
              <span>{a.label[locale]}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

{
  section === 'stands' && (
    <section class:list={['sec', 'reveal', `sec--${tone}`]}>
      <div class="wrap">
        <SectionHead locale={locale} kicker={head.k} title={head.t} text={head.text} />
        <div class="pkg">
          {event.stands.map((s) => (
            <article class:list={['card', s.best && 'card--best']}>
              {s.best && <p class="pkg__flag">{ru ? 'Выбирают чаще всего' : 'Most often chosen'}</p>}
              <p class="mono-label">{fig(s.area, locale)}</p>
              <h3>{s.name[locale]}</h3>
              <p class="muted">{s.note[locale]}</p>
              {s.includes?.length ? (
                <ul class="pkg__list">
                  {s.includes.map((i) => (
                    <li>{i[locale]}</li>
                  ))}
                </ul>
              ) : null}
              <a class="btn btn--sm" href={L('/request-stand/')}>{ru ? 'Забронировать' : 'Reserve'}</a>
            </article>
          ))}
        </div>
        <p class="small muted" style="margin-top:1rem">
          {ru
            ? `Ставки ${event.shortName} за метр и услуги — в разделе «Пакеты участия и цены».`
            : `Per-m² rates and services for ${event.shortName} are in the packages section.`}
        </p>
      </div>
    </section>
  )
}

{
  section === 'speakers' && hasPosters && (
    <section class:list={['sec', 'reveal', `sec--${tone}`]}>
      <div class="wrap">
        <SpeakerWall
          locale={locale}
          kicker={head.k}
          title={ru ? 'Спикеры деловой программы' : 'Business programme speakers'}
          text={ru
            ? 'Практики рынка: маркетплейсы, фулфилмент, финтех и топ-селлеры Uzum Market — те, кто реально считает юнит-экономику, а не рассказывает о ней.'
            : 'Market practitioners: marketplaces, fulfilment, fintech and the top Uzum Market sellers — people who actually run the unit economics.'}
        />
      </div>
    </section>
  )
}

{
  section === 'speakers' && !hasPosters && event.speakers.length > 0 && (
    <section class:list={['sec', 'reveal', `sec--${tone}`]}>
      <div class="wrap">
        <SectionHead locale={locale} kicker={head.k} title={head.t} />
        <div class="grid g4">
          {event.speakers.map((s) => (
            <article class="card card--flat">
              <h3 style="font-size:1.05rem">{s.name}</h3>
              <p class="small muted">{s.role[locale]}</p>
              <p class="mono-label">{s.org}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}

{
  section === 'materials' && (
    <section class:list={['sec', 'reveal', `sec--${tone}`]}>
      <div class="wrap">
        <SectionHead locale={locale} kicker={head.k} title={head.t} text={head.text} />
        <DownloadNotice locale={locale} hrefs={event.materials.map(m => m.href)} />
        <div class="files">
          {event.materials.map((m) => (
            <a href={m.href.startsWith('http') ? m.href : m.href} rel="noopener" download={!m.href.startsWith('http')}>
              <span class="files__ico">
                <Icon name={m.type === 'video' ? 'play' : m.type === 'photo' ? 'image' : 'doc'} size={20} />
              </span>
              <span>
                <b>{m.title[locale]}</b>
                <small>{isSampleDownload(m.href) ? useUI(locale)('downloads.sample') : m.type === 'catalog' ? (ru ? 'Каталог · PDF' : 'Catalogue · PDF') : m.type === 'video' ? (ru ? 'Видео' : 'Video') : m.type === 'photo' ? (ru ? 'Фотоотчёт' : 'Photo report') : 'PDF'}</small>
              </span>
              <span class="files__go">{ru ? 'Открыть' : 'Open'} →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}

{
  section === 'faq' && <Faq locale={locale} topic={event.brand[locale]} title={ru ? `${event.shortName}: частые вопросы` : `${event.shortName}: frequently asked questions`} items={event.faq.map((f) => ({ q: f.q[locale], a: f.a[locale] }))} />
}

{
  section === 'related' && (
    <section class:list={['sec', 'reveal', `sec--${tone}`]}>
      <div class="wrap">
        <SectionHead locale={locale} kicker={head.k} title={head.t} text={head.text} />
        <div class="grid g3">
          {peers.map((e) => <EventCard locale={locale} event={e} />)}
        </div>
      </div>
    </section>
  )
}

{
  section === 'venue' && (
    <section class:list={['sec', 'reveal', `sec--${tone}`]}>
      <div class="wrap">
        <SectionHead locale={locale} kicker={head.k} title={head.t} text={head.text}>
          <a slot="aside" class="btn btn--sm btn--ghost" href={L('/venue/')}>
            {ru ? 'О площадке' : 'About the venue'}
          </a>
        </SectionHead>
        <div class="grid g4">
          {[
            ['cube', ru ? 'Крытый зал' : 'Indoor hall', `${site.venue.indoorM2.toLocaleString(ru ? 'ru-RU' : 'en-GB')} m²`],
            ['sun', ru ? 'Открытая площадка' : 'Open-air area', `${site.venue.outdoorM2.toLocaleString(ru ? 'ru-RU' : 'en-GB')} m²`],
            ['zap', ru ? 'Электричество' : 'Power', `${site.venue.powerKW} kW · ${site.venue.voltage}`],
            ['cup', ru ? 'Кафе' : 'Catering', ru ? `${site.venue.cafeSeats} мест` : `${site.venue.cafeSeats} seats`],
          ].map(([ic, ttl, val]) => (
            <div class="vcard">
              <Icon name={ic as string} size={20} />
              <p class="mono-label">{ttl}</p>
              <b>{val}</b>
            </div>
          ))}
        </div>
        <p class="small muted" style="margin-top:1.1rem">{ru ? `Как добраться на ${event.shortName}: ${site.location.airport.ru} · ${site.location.station.ru}` : `Getting to ${event.shortName}: ${site.location.airport.en} · ${site.location.station.en}`}</p>
      </div>
    </section>
  )
}

{
  section === 'buyers' && event.buyerProgram && (
    <section class:list={['sec', 'reveal', `sec--${tone}`]}>
      <div class="wrap">
        <SectionHead locale={locale} kicker={head.k} title={head.t}>
          <div class="prog__deadline" slot="aside">
            <span class="mono-label">{event.buyerProgram.deadline.label[locale]}</span>
            <b>{event.buyerProgram.deadline.value[locale]}</b>
          </div>
        </SectionHead>
        <p class="lead">{event.buyerProgram.intro[locale]}</p>
        <ol class="prog">
          {event.buyerProgram.steps.map((s, i) => (
            <li class="prog__i">
              <span class="prog__n">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <p class="prog__when">{s.when[locale]}</p>
                <h3>{s.label[locale]}</h3>
                <p class="muted">{s.text[locale]}</p>
              </div>
            </li>
          ))}
        </ol>
        <h4 class="prog__sub">{ru ? 'Что получает закупщик' : 'What a buyer receives'}</h4>
        <div class="grid g3">
          {event.buyerProgram.privileges.map((p) => (
            <div class="vcard">
              <Icon name="check" size={20} />
              <p class="mono-label">{p.title[locale]}</p>
              <span class="muted">{p.text[locale]}</span>
            </div>
          ))}
        </div>
        {event.buyerProgram.note ? <p class="small muted" style="margin-top:1rem">{event.buyerProgram.note[locale]}</p> : null}
      </div>
    </section>
  )
}

{
  section === 'matchmaking' && event.matchmaking && (
    <section class:list={['sec', 'reveal', `sec--${tone}`]}>
      <div class="wrap">
        <SectionHead locale={locale} kicker={head.k} title={head.t}>
          <div class="prog__deadline" slot="aside">
            <span class="mono-label">{ru ? 'Длительность встречи' : 'One meeting'}</span>
            <b>{event.matchmaking.duration[locale]}</b>
          </div>
        </SectionHead>
        <p class="lead">{event.matchmaking.intro[locale]}</p>
        <div class="grid g3">
          {event.matchmaking.steps.map((s, i) => (
            <div class="vcard">
              <p class="mono-label">{ru ? `Шаг ${i + 1}` : `Step ${i + 1}`}</p>
              <b>{s.title[locale]}</b>
              <span class="muted">{s.text[locale]}</span>
            </div>
          ))}
        </div>
        <p class="small muted" style="margin-top:1rem">
          {ru ? `Столов в зоне переговоров: ${event.matchmaking.slots}.` : `Tables in the negotiation area: ${event.matchmaking.slots}.`}
          {event.matchmaking.note ? ` ${event.matchmaking.note[locale]}` : ''}
        </p>
      </div>
    </section>
  )
}

{
  section === 'award' && event.award && (
    <section class:list={['sec', 'reveal', `sec--${tone}`]}>
      <div class="wrap">
        <SectionHead locale={locale} kicker={head.k} title={event.award.name[locale]} />
        <p class="lead">{event.award.intro[locale]}</p>
        <div class="grid g4">
          {event.award.nominations.map((n) => (
            <div class="vcard">
              <Icon name="star" size={20} />
              <p class="mono-label">{ru ? 'Номинация' : 'Category'}</p>
              <b>{n[locale]}</b>
            </div>
          ))}
        </div>
        <h4 class="prog__sub">{ru ? 'Сроки' : 'Timeline'}</h4>
        <ol class="prog prog--flat">
          {event.award.timeline.map((s) => (
            <li class="prog__i">
              <span class="prog__n" aria-hidden="true">—</span>
              <div>
                <p class="prog__when">{s.when[locale]}</p>
                <h3>{s.label[locale]}</h3>
              </div>
            </li>
          ))}
        </ol>
        <div class="callout">
          <p class="mono-label">{ru ? 'Что получает победитель' : 'What the winner receives'}</p>
          <p>{event.award.prize[locale]}</p>
        </div>
        {event.award.note ? <p class="small muted" style="margin-top:1rem">{event.award.note[locale]}</p> : null}
      </div>
    </section>
  )
}

<style>
  .cats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
  .cats__i {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: var(--paper);
    font-size: 0.92rem;
  }
  .cats__i :global(svg) {
    color: var(--moss);
  }
  .cats--dir {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 0.7rem;
  }
  .cats__seg {
    display: grid;
    gap: 0.35rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--paper);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .cats__seg:hover {
    border-color: var(--gold);
    transform: translateY(-2px);
  }
  .cats__h {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--f-display);
    font-size: 1rem;
    line-height: 1.25;
  }
  .cats__h :global(svg) {
    color: var(--moss);
    flex: none;
  }
  .cats__lead {
    font-size: 0.88rem;
    color: color-mix(in srgb, var(--ink) 64%, transparent);
  }
  .prog {
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
  }
  .prog__day {
    background: var(--paper);
    padding: clamp(1.1rem, .7rem + 1.4vw, 1.7rem) clamp(1.2rem, .8rem + 1.4vw, 1.8rem);
  }
  .prog__head {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .prog__n {
    width: 40px;
    height: 40px;
    flex: none;
    border-radius: var(--r);
    background: var(--evergreen);
    color: var(--gold-soft);
    display: grid;
    place-items: center;
    font-size: .95rem;
  }
  .prog__head b {
    display: block;
    font-family: var(--f-display);
    font-size: 1.18rem;
    letter-spacing: -.01em;
  }
  .prog__head small {
    color: var(--ink-40);
    font-size: .82rem;
  }
  .prog ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: .9rem;
  }
  .prog li {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: .25rem;
    padding-bottom: .9rem;
    border-bottom: 1px dashed var(--line);
  }
  .prog li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .prog li b {
    font-size: 1.02rem;
  }
  .prog li span {
    color: var(--ink-60);
    font-size: .94rem;
  }
  .aud {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
  }
  .aud li {
    background: var(--paper);
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.9rem;
    padding: 0.95rem 1.2rem;
  }
  .aud li :global(svg) {
    color: var(--moss);
  }
  .aud b {
    font-family: var(--f-display);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
