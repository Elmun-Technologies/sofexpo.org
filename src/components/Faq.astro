---
import type { Locale } from '@/i18n/config';
import Icon from '@/components/Icon.astro';

const { locale, items, title } = Astro.props as {
  locale: Locale;
  title?: string;
  items: { q: string; a: string }[];
};
---
<section class="sec sec--paper" id="faq">
  <div class="wrap wrap--narrow">
    <p class="kicker">{locale === 'ru' ? 'Частые вопросы' : 'Frequently asked'}</p>
    <h2 style="margin-bottom:1.4rem">{title ?? (locale === 'ru' ? 'Что спрашивают перед участием' : 'What people ask before joining')}</h2>
    <div class="acc">
      {
        items.map((item, i) => (
          <details open={i === 0}>
            <summary>
              <span>{item.q}</span>
            </summary>
            <div class="acc__body">{item.a}</div>
          </details>
        ))
      }
    </div>
    <p class="small muted" style="margin-top:1.2rem">
      <Icon name="telegram" size={15} /> {locale === 'ru'
        ? 'Нет ответа на ваш вопрос? Напишите менеджеру — отвечаем в рабочее время за 15 минут.'
        : 'Missing an answer? Message the manager — we reply within 15 minutes during office hours.'}
    </p>
  </div>
</section>
