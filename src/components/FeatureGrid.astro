---
import type { SourceLocale as Locale } from '@/i18n/config';
import Icon from '@/components/Icon.astro';
import Photo from '@/components/Photo.astro';

const { locale, items, cols = 3 } = Astro.props as {
  locale: Locale;
  cols?: 2 | 3 | 4;
  items: {
    icon?: string;
    title: string;
    text?: string;
    href?: string;
    meta?: string;
    /** optional photo at the top of the card */
    image?: string;
    imageAlt?: string;
  }[];
};
---
<div class:list={['grid', `g${cols}`]}>
  {
    items.map((item) => {
      const Tag = item.href ? 'a' : 'div';
      return (
        <Tag class="feature" href={item.href} {...item.href ? { rel: 'noopener' } : {}}>
          {item.image && (
            <Photo
              class="feature__media"
              src={item.image}
              alt={item.imageAlt ?? item.title}
              ratio="16/10"
              zoom
              sizes={cols === 2 ? '(max-width: 680px) 100vw, 50vw' : cols === 4 ? '(max-width: 680px) 100vw, (max-width: 1080px) 50vw, 25vw' : '(max-width: 680px) 100vw, (max-width: 1080px) 50vw, 33vw'}
            />
          )}
          {item.icon && (
            <span class="ico-tile">
              <Icon name={item.icon} size={24} />
            </span>
          )}
          <h3 class="feature__t">{item.title}</h3>
          {item.text && <p>{item.text}</p>}
          {item.meta && <span class="mono-label">{item.meta}</span>}
          {item.href && <span class="feature__go">→</span>}
        </Tag>
      );
    })
  }
</div>

<style>
  .feature {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r-img);
    padding: clamp(1.1rem, .7rem + 1.4vw, 1.7rem);
    text-decoration: none;
    color: inherit;
    transition: box-shadow var(--tr), border-color var(--tr), transform var(--tr);
  }
  a.feature:hover {
    border-color: transparent;
    box-shadow: var(--shadow-lift);
    transform: translateY(-3px);
  }
  .feature__t {
    font-size: clamp(1.05rem, .98rem + .35vw, 1.25rem);
    margin: 0 0 .35em;
  }
  .feature p {
    margin: 0;
    color: var(--ink-60);
    font-size: .95rem;
  }
  .feature__go {
    position: absolute;
    top: clamp(1.1rem, .7rem + 1vw, 1.6rem);
    right: clamp(1.1rem, .7rem + 1vw, 1.6rem);
    color: var(--moss);
    opacity: 0.55;
    transition: opacity var(--tr), color var(--tr);
  }
  .feature:hover .feature__go {
    opacity: 1;
  }
  .feature__media {
    margin: calc(-1 * clamp(1.1rem, .7rem + 1.4vw, 1.7rem)) calc(-1 * clamp(1.1rem, .7rem + 1.4vw, 1.7rem)) 1.2rem;
    border-radius: 0;
    border-top-left-radius: calc(var(--r-img) - 1px);
    border-top-right-radius: calc(var(--r-img) - 1px);
  }
  .feature__go {
    margin-top: auto;
    position: static;
    align-self: flex-start;
    padding-top: .9rem;
  }
  .feature .mono-label {
    display: block;
    margin-top: .8rem;
    font-size: .74rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--moss);
  }
</style>
