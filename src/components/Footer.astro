---
import { footerColumns, site } from '@/data/site';
import { CURRENT_BRAND, CURRENT_EVENT } from '@/data/hosts';
import ShowLogo from '@/components/ShowLogo.astro';
import { logoFor } from '@/lib/showLogos';
import BrandMark from '@/components/BrandMark.astro';
import Ornament from '@/components/Ornament.astro';
import { localize, type SourceLocale as Locale } from '@/i18n/config';
import { useUI } from '@/i18n/ui';
import Icon from '@/components/Icon.astro';

const { locale } = Astro.props as { locale: Locale; path?: string };
const t = useUI(locale);
const P = (p: string) => localize(locale, p);
const year = 2026;
const ru = locale === 'ru';
---

<footer class="ftr">
  {/* 2026-10 design (docs/18 §3): a blue booking card and a white sales card above the black
      footer panel — the last screen of every page still offers the two actions that matter */}
  <div class="ftr__top">
    <a class="ftr__cta" href={P('/request-stand/')} data-quiz-open data-quiz-source="footer">
      <span class="ftr__cta-t">{ru ? 'Ваш стенд — на следующей выставке' : 'Put your stand at the next show'}</span>
      <span class="arr arr--xl" aria-hidden="true"><Icon name="arrow-ne" size={30} /></span>
    </a>
    <div class="ftr__sales">
      <span class="ftr__sales-k">{ru ? 'Отдел продаж · Пн–Пт 09:00–18:00' : 'Sales desk · Mon–Fri 09:00–18:00'}</span>
      <a class="ftr__phone" href={`tel:${site.contacts.phoneMain.replace(/\s/g, '')}`}>{site.contacts.phoneMain}</a>
      <span class="ftr__pills">
        <a class="pill" href={`mailto:${site.contacts.email}`}>{site.contacts.email}</a>
        <a class="pill" href={site.contacts.telegramManager} rel="noopener" target="_blank">{ru ? 'Менеджер в Telegram' : 'Telegram manager'}</a>
        <a class="pill" href={site.contacts.whatsapp} rel="noopener" target="_blank">WhatsApp</a>
      </span>
    </div>
  </div>
  <div class="ftr__main">
    {CURRENT_BRAND?.ornament && <Ornament variant="band" height={20} flip />}
  <div class="wrap">
    <div class="ftr__grid">
      <div>
        <a class="logo" href={P('/')} style="color:#ffffff">
          {logoFor(CURRENT_EVENT) ? (
            <ShowLogo slug={CURRENT_EVENT} height={40} />
          ) : CURRENT_BRAND?.mark === 'star' ? (
            <BrandMark brand={CURRENT_BRAND} locale={locale} withWordmark size={30} tone="on-dark" />
          ) : CURRENT_BRAND ? (
            <span class="logo__txt">
              <b style="color:#ffffff">{CURRENT_BRAND.name[locale]}</b>
              <span style="color:rgba(255, 255, 255, .6)">{CURRENT_BRAND.sub[locale]}</span>
            </span>
          ) : (
            <>
              {/* the centre's horizontal mark, drawn white for the black panel */}
              <img class="logo__h" src="/brand/sofexpo-horizontal-white.png" alt={site.brand[locale]} width="274" height="96" loading="lazy" decoding="async" />
            </>
          )}
        </a>
        <p class="ftr__about">{t('footer.about')}</p>
        <p class="ftr__about">{site.location.region[locale]}</p>
        <div class="socials" style="margin-top:1rem">
          {
            Object.entries({
              telegram: { icon: 'telegram', href: site.contacts.telegramChannel, label: 'Telegram' },
              instagram: { icon: 'instagram', href: site.contacts.instagram, label: 'Instagram' },
              facebook: { icon: 'facebook', href: site.contacts.facebook, label: 'Facebook' },
              youtube: { icon: 'youtube', href: site.contacts.youtube, label: 'YouTube' },
            }).map(
              ([, s]) => (
                <a class="ftr__social" href={s.href} aria-label={s.label} rel="noopener" target="_blank">
                  <Icon name={s.icon} size={18} />
                </a>
              ),
            )
          }
        </div>
      </div>

      {
        footerColumns.map((col) => (
          <div>
            <h3>{t(col.title as never)}</h3>
            <ul>
              {col.links.map((l) => (
                <li>
                  <a href={P(l.path)}>
                    {'key' in l ? t((l as { key: never }).key) : ru ? (l as { ru: string }).ru : (l as { en: string }).en}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="ftr__bottom">
      <p style="margin:0">
        © {year} {site.brand[locale]}. {t('footer.rights')} {ru ? site.brand.legal : site.brand.legalEn}.
      </p>
      <p style="margin:0">
        <a href={P('/legal/privacy/')}>{t('form.privacy')}</a> · <a href={P('/legal/terms/')}>{ru ? 'Пользовательское соглашение' : 'Terms of use'}</a>
      </p>
      <a href="#top" style="display:inline-flex;gap:.4rem;align-items:center">
        <Icon name="arrow-up" size={14} /> {t('misc.scrollToTop')}
      </a>
    </div>
    <p class="small" style="margin:1rem 0 0;color:rgba(255, 255, 255, .7)">{t('footer.made')}</p>
  </div>
  </div>
</footer>
