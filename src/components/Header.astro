---
import { nav, site } from '@/data/site';
import { CURRENT_BRAND, CURRENT_EVENT } from '@/data/hosts';
import ShowLogo from '@/components/ShowLogo.astro';
import { logoFor } from '@/lib/showLogos';
import { events } from '@/data/events';
import BrandMark from '@/components/BrandMark.astro';
import { localize, localeMeta, supportedLocales, type SourceLocale as Locale } from '@/i18n/config';
import { useUI } from '@/i18n/ui';
import Icon from '@/components/Icon.astro';
import Photo from '@/components/Photo.astro';

interface Props {
  locale: Locale;
  /** path without the locale prefix */
  path: string;
}

const { locale, path } = Astro.props;
const t = useUI(locale);
const current = localize(locale, path);
const t0 = localize(locale, '/');
const P = (p: string) => localize(locale, p);
const active = (base: string) => (base === '/' ? current === '/' : path.startsWith(base));
/* event page context: the quiz dialog focuses on this show instead of asking a general question */
const pageEvent = events.find((e) => path.startsWith(`/events/${e.slug}/`));
const quizEvent = pageEvent ? pageEvent.brand[locale] : undefined;
const ru = locale === 'ru';
const portalBase = (() => {
  const raw = String(import.meta.env.PUBLIC_PORTAL_URL ?? '').trim().replace(/\/+$/, '');
  if (!raw) return '';
  if (raw.startsWith('/') && !raw.startsWith('//')) return raw;
  try {
    const url = new URL(raw);
    return ['http:', 'https:'].includes(url.protocol) && !url.username && !url.password && url.pathname === '/' && !url.search && !url.hash
      ? url.origin
      : '';
  } catch { return ''; }
})();
const visitorPortalHref = portalBase ? `${portalBase}/cabinet?type=visitor&lang=${locale}` : '';
const exhibitorPortalHref = portalBase ? `${portalBase}/cabinet?type=exhibitor&lang=${locale}` : '';
/* the mega-menu's featured card: the next show that is still open */
const nextShow = events
  .filter((e) => e.status !== 'past')
  .sort((a, b) => a.dates.start.localeCompare(b.dates.start))[0];
/**
 * One bar, six items (docs/08 §3.1). The old utility bar (address · phone · hours · telegram)
 * moved to /contacts/ and the footer; «Новости» is in the footer — the first screen belongs
 * to the calendar, not to service contacts.
 */
const items = nav.filter((i) => i.key !== 'nav.news');
/* 2026-10 design (docs/18 §3): every mega panel ends in a photo card that leads somewhere
   concrete — the next show, the hall plan, the packages, free registration, the conference
   hall, the company. */
const featured: Record<string, { img: string; alt: string; kicker: string; date?: string; title: string; href: string }> = {
  '/events/': {
    img: nextShow.heroImage,
    alt: nextShow.tagline[locale],
    kicker: ru ? 'Ближайшая выставка' : 'Next exhibition',
    date: nextShow.dates.display[locale],
    title: nextShow.brand[locale],
    href: `/events/${nextShow.slug}/`,
  },
  '/venue/': { img: '/images/hall-panorama.jpg', alt: ru ? 'Зал SOF EXPO в день открытия' : 'The SOF EXPO hall on opening day', kicker: t('nav.venue'), title: ru ? 'Залы и площади' : 'Halls and areas', href: '/venue/halls/' },
  '/exhibitors/': { img: '/images/stand-exhibitor.jpg', alt: ru ? 'Стенд экспонента' : 'An exhibitor stand', kicker: ru ? 'Стенд' : 'Stand', title: ru ? 'Выберите пакет' : 'Choose a package', href: '/exhibitors/packages/' },
  '/visitors/': { img: '/images/opening-crowd.jpg', alt: ru ? 'Гости на церемонии открытия' : 'Guests at the opening ceremony', kicker: t('nav.visitors'), title: ru ? 'Бесплатная регистрация' : 'Free registration', href: '/visitors/tickets/' },
  '/organizers/': { img: '/images/conference-stage.jpg', alt: ru ? 'Сцена конференц-зала' : 'The conference hall stage', kicker: ru ? 'Аренда' : 'Rental', title: ru ? 'Конференц-зал' : 'Conference hall', href: '/organizers/conferences/' },
  '/about/': { img: '/images/venue-flags.jpg', alt: ru ? 'Здание SOF EXPO с флагами' : 'The SOF EXPO building with flags', kicker: t('nav.about'), title: ru ? 'О SOF EXPO' : 'About SOF EXPO', href: '/about/' },
};
---

<header class="hdr" id="top">
  <div class="wrap hdr__in">
    <a class="logo" href={P('/')} aria-label={`${CURRENT_BRAND ? CURRENT_BRAND.name[locale] + ' ' + CURRENT_BRAND.sub[locale] : site.brand[locale]} — ${t('breadcrumbs.home')}`}>
      {CURRENT_BRAND?.headerLogo ? (
        /* the show's horizontal lockup: its round badge is illegible at header height */
        <picture>
          <source type="image/webp" srcset={CURRENT_BRAND.headerLogo.webp} />
          <img class="logo__h logo__h--show" src={CURRENT_BRAND.headerLogo.src} alt={`${CURRENT_BRAND.name[locale]} ${CURRENT_BRAND.sub[locale]}`} width={CURRENT_BRAND.headerLogo.width / 2} height={CURRENT_BRAND.headerLogo.height / 2} loading="eager" decoding="async" fetchpriority="high" />
        </picture>
      ) : logoFor(CURRENT_EVENT) ? (
        /* the show's own logo, cut from the organiser's artwork (docs/15 §10) */
        <ShowLogo slug={CURRENT_EVENT} height={40} eager />
      ) : CURRENT_BRAND?.mark === 'star' ? (
        <BrandMark brand={CURRENT_BRAND} locale={locale} withWordmark size={32} tone="on-light" />
      ) : CURRENT_BRAND ? (
        /* badge not delivered yet: the wordmark in the host's palette is the identity, no placeholder glyph */
        <span class="logo__txt">
          <b>{CURRENT_BRAND.name[locale]}</b>
          <span>{CURRENT_BRAND.sub[locale]}</span>
        </span>
      ) : (
        <>
          {/* the centre's real mark (three figures around the SOF EXPO roundel), not a
              two-letter placeholder — served at 2x for retina, sized in CSS */}
          <img
            class="logo__h"
            src="/brand/sofexpo-horizontal.png"
            alt=""
            aria-hidden="true"
            width="274"
            height="96"
            loading="eager"
            decoding="async"
          />
        </>
      )}
    </a>

    <nav class="nav" aria-label={t('nav.menu')}>
      {
        items.map((item) => {
          /* the section's own page leads the panel; its children fill the link columns */
          const home = item.children.find((c) => c.path === item.base);
          const links = item.children.filter((c) => c.path !== item.base);
          return (
            <div class="nav__item">
              <a class="nav__link" href={P(item.base)} aria-current={active(item.base) ? 'page' : undefined}>
                {t(item.key as never)}
                <svg class="nav__caret" aria-hidden="true" width="10" height="7" viewBox="0 0 10 7"><path d="m1 1 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
              </a>
              <div class="mega">
                <div class="mega__in">
                  <div class="mega__intro">
                    <p class="mega__title">{t(item.key as never)}</p>
                    <p class="mega__lead">{t(item.desc as never)}</p>
                    <a class="mega__all" href={P(item.base)}>
                      {home ? (locale === 'ru' ? home.ru : home.en) : t(item.key as never)}
                      <Icon name="arrow" size={15} />
                    </a>
                  </div>
                  <ul class:list={['mega__links', { 'mega__links--3': links.length > 6 }]}>
                    {links.map((child) => (
                      <li>
                        <a href={P(child.path)} aria-current={current === P(child.path) ? 'page' : undefined}>
                          <span class="mega__t">{locale === 'ru' ? child.ru : child.en}</span>
                          {child.note && <span class="mega__d">{locale === 'ru' ? child.note.ru : child.note.en}</span>}
                        </a>
                      </li>
                    ))}
                  </ul>
                  {featured[item.base] && (
                    <a class="mega__photo" href={P(featured[item.base].href)}>
                      <Photo src={featured[item.base].img} alt={featured[item.base].alt} ratio="4/5" sizes="300px" rounded={false} />
                      <span class="mega__photo-card">
                        <span><small>{featured[item.base].kicker}</small><b>{featured[item.base].title}</b>{featured[item.base].date && <small class="mega__photo-date">{featured[item.base].date}</small>}</span>
                        <span class="arr" aria-hidden="true"><Icon name="arrow-ne" size={14} /></span>
                      </span>
                    </a>
                  )}
                </div>
              </div>
            </div>
          );
        })
      }
    </nav>

    <div class="hdr__tools">
      <details class="language-picker">
        <summary aria-label={t('topbar.lang')}><Icon name="globe" size={16} /><span>{localeMeta[locale].flag}</span><svg aria-hidden="true" width="10" height="7" viewBox="0 0 10 7"><path d="m1 1 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" /></svg></summary>
        <div class="language-picker__menu">
          {supportedLocales.map((l) => (
            <a href={current.replace(`/${locale}/`, `/${l}/`)} hreflang={localeMeta[l].html} lang={localeMeta[l].html} aria-current={l === locale ? 'true' : undefined}>
              <span>{localeMeta[l].label}</span><span class="language-code">{l.toUpperCase()}</span>
            </a>
          ))}
        </div>
      </details>
      {portalBase && (
        <details class="account-picker">
          <summary aria-label={ru ? 'Личный кабинет' : 'Account'} title={ru ? 'Личный кабинет' : 'Account'}><span aria-hidden="true">◎</span><svg aria-hidden="true" width="9" height="6" viewBox="0 0 10 7"><path d="m1 1 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" /></svg></summary>
          <div class="account-picker__menu">
            <a href={visitorPortalHref} data-portal-language>{ru ? 'Кабинет посетителя' : 'Visitor account'}<small>{ru ? 'Планируйте посещение' : 'Plan your visit'}</small></a>
            <a href={exhibitorPortalHref} data-portal-language>{ru ? 'Кабинет экспонента' : 'Exhibitor account'}<small>{ru ? 'Заявка на участие' : 'Apply to exhibit'}</small></a>
          </div>
        </details>
      )}
      <a class="header-search" href={P('/search/')} aria-label={t('cta.search')}><Icon name="search" size={19} /></a>
      <a class="header-call" href={`tel:${site.contacts.phoneMain.replace(/\s/g, '')}`} aria-label={`${ru ? 'Позвонить' : 'Call'} ${site.contacts.phoneMain}`}><Icon name="phone" size={18} /></a>
      <a class="btn btn--sm btn--desk" href={P('/request-stand/')} data-quiz-open data-quiz-event={quizEvent} data-quiz-source="header">
        {t('cta.stand')}
      </a>
      <button class="burger" type="button" aria-controls="mnav" aria-expanded="false" aria-label={t('nav.menu')}>
        <span></span>
      </button>
    </div>
  </div>

  <div class="mnav" id="mnav">
    <nav aria-label={t('nav.menu')}>
      {
        items.map((item) => (
          <details name="mnav-section">
            <summary>{t(item.key as never)}</summary>
            <div class="mnav__list">
              <a href={P(item.base)}>{t('nav.sectionHome')}</a>
              {item.children
                .filter((c) => c.path !== item.base)
                .map((child) => (
                  <a href={P(child.path)}>{locale === 'ru' ? child.ru : child.en}</a>
                ))}
            </div>
          </details>
        ))
      }
      <div class="mnav__ctas">
        <a class="btn btn--accent" href={P('/request-stand/')} data-quiz-open data-quiz-event={quizEvent} data-quiz-source="menu">{t('cta.stand')}</a>
        <a class="btn btn--ghost" href={P('/visitors/tickets/')}>{t('cta.ticket')}</a>
        {portalBase && (
          <>
            <a class="btn btn--ghost" href={visitorPortalHref} data-portal-language>{ru ? 'Кабинет посетителя' : 'Visitor account'}</a>
            <a class="btn btn--ghost" href={exhibitorPortalHref} data-portal-language>{ru ? 'Кабинет экспонента' : 'Exhibitor account'}</a>
          </>
        )}
        <a class="btn btn--ghost" href={P('/events/')}>{t('nav.lineup')}</a>
        <a class="btn btn--ghost" href={P('/search/')}>{t('cta.search')}</a>
        <a class="btn btn--ghost" href={`tel:${site.contacts.phoneMain.replace(/\s/g, '')}`}>
          {t('topbar.phone')}
        </a>
        <div class="pill-row">{supportedLocales.map((l) => <a class="chip" href={localize(l, path)} hreflang={localeMeta[l].html}>{localeMeta[l].label}</a>)}</div>
        <a class="chip" href={t0}>{t('misc.backHome')}</a>
      </div>
    </nav>
  </div>
</header>

<script is:inline translate="no">
  (() => {
    const burger = document.querySelector('.burger');
    const mnav = document.getElementById('mnav');
    if (!burger || !mnav) return;
    const set = (open) => {
      document.body.classList.toggle('nav-open', open);
      burger.setAttribute('aria-expanded', String(open));
      document.documentElement.style.overflow = open ? 'hidden' : '';
      document.querySelectorAll('main, .ftr').forEach(el => open ? el.setAttribute('inert','') : el.removeAttribute('inert'));
      if (open) mnav.style.maxHeight = `${window.innerHeight - document.querySelector('.hdr').getBoundingClientRect().bottom}px`;
    };
    set(false);
    burger.addEventListener('click', () => set(!document.body.classList.contains('nav-open')));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && document.body.classList.contains('nav-open')) { set(false); burger.focus(); } });
    mnav.addEventListener('click', (e) => e.target.closest('a') && set(false));
    document.querySelectorAll('header a[hreflang]').forEach(link => {
      const target = new URL(link.href, location.href);
      target.search = location.search;
      target.hash = location.hash;
      link.href = target.href;
    });
    const pageLocale = document.documentElement.lang.toLowerCase().split('-')[0];
    const portalLocale = ['uz', 'ru', 'en', 'tr', 'zh'].includes(pageLocale) ? pageLocale : 'en';
    document.querySelectorAll('[data-portal-language]').forEach(link => {
      try {
        const target = new URL(link.href, location.href);
        target.searchParams.set('lang', portalLocale);
        link.href = target.href;
      } catch { /* invalid portal URL remains hidden by the build configuration */ }
    });
    const picker = document.querySelector('.language-picker');
    const accountPicker = document.querySelector('.account-picker');
    /* phone menu: one section open at a time (`name` does this natively; the listener covers
       browsers without exclusive <details>), so two lists never run together */
    document.querySelectorAll('.mnav details[name="mnav-section"]').forEach((d, _, all) => {
      d.addEventListener('toggle', () => { if (d.open) all.forEach((o) => { if (o !== d) o.open = false; }); });
    });
    /* the two header drop-downs never stack: opening one closes the other */
    picker?.addEventListener('toggle', () => { if (picker.open && accountPicker) accountPicker.open = false; });
    accountPicker?.addEventListener('toggle', () => { if (accountPicker.open && picker) picker.open = false; });
    document.addEventListener('click', (e) => {
      if (picker && !picker.contains(e.target)) picker.open = false;
      if (accountPicker && !accountPicker.contains(e.target)) accountPicker.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (picker?.open) { picker.open = false; picker.querySelector('summary').focus(); }
      if (accountPicker?.open) { accountPicker.open = false; accountPicker.querySelector('summary').focus(); }
    });
    /* hide-on-scroll for the compact header (≤1280px): down = away, up = back, never while
       the phone menu is open or near the top of the page */
    {
      const compact = matchMedia('(max-width: 1280px)');
      let lastY = scrollY;
      let ticking = false;
      const update = () => {
        ticking = false;
        const y = scrollY;
        const root = document.documentElement;
        if (!compact.matches || document.body.classList.contains('nav-open') || y < 160) root.classList.remove('hdr-away');
        else if (y > lastY + 6) root.classList.add('hdr-away');
        else if (y < lastY - 6) root.classList.remove('hdr-away');
        lastY = y;
      };
      addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
      document.addEventListener('focusin', (e) => { if (e.target.closest?.('.hdr')) document.documentElement.classList.remove('hdr-away'); });
    }
    const desktop = matchMedia('(min-width: 1281px)');
    desktop.addEventListener('change', (e) => { if (e.matches) set(false); });
    window.addEventListener('resize', () => { if (document.body.classList.contains('nav-open')) set(true); });
    document.querySelectorAll('.nav__item').forEach(item => {
      item.addEventListener('pointerenter', () => {
        item.removeAttribute('data-dismissed');
        /* only one panel open: the pointer moving onto another item closes a panel that
           keyboard focus or ArrowDown had opened, so it cannot reappear underneath */
        if (picker) picker.open = false;
        if (accountPicker) accountPicker.open = false;
        document.querySelectorAll('.nav__item').forEach((other) => {
          if (other === item) return;
          other.removeAttribute('data-keyboard-open');
          if (other.contains(document.activeElement)) document.activeElement.blur();
        });
      });
      item.addEventListener('focusin', () => {
        item.removeAttribute('data-dismissed');
        if (picker) picker.open = false;
        if (accountPicker) accountPicker.open = false;
      });
      item.addEventListener('focusout', (e) => {
        if (!item.contains(e.relatedTarget)) item.removeAttribute('data-keyboard-open');
      });
      item.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown' && e.target.matches('.nav__link')) {
          e.preventDefault();
          item.removeAttribute('data-dismissed');
          item.setAttribute('data-keyboard-open', '');
          item.querySelector('.mega a')?.focus();
        }
      });
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      document.querySelectorAll('.nav__item').forEach(item => {
        if (getComputedStyle(item.querySelector('.mega')).visibility !== 'visible') return;
        if (item.contains(document.activeElement)) item.querySelector('.nav__link').focus();
        item.removeAttribute('data-keyboard-open');
        item.setAttribute('data-dismissed', '');
      });
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab' || !document.body.classList.contains('nav-open')) return;
      const focusable = [burger, ...Array.from(mnav.querySelectorAll('a, summary')).filter(el => el.getClientRects().length)];
      const first = focusable[0], last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    });
  })();
</script>


