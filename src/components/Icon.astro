<svg
  class:list={['ico', { 'ico--lg': dim > 24 }]}
  width={dim}
  height={dim}
  viewBox="0 0 24 24"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  focusable="false"
  {...label ? { 'aria-label': label } : {}}
>
  <path d={d} />
</svg>
