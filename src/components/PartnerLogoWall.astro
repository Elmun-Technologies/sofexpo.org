---
/**
 * PartnerLogoWall — a restrained, greyscale logo strip (official-consortium style).
 *
 * The client sends the real logos (per edition + the shared SOF EXPO set,
 * docs/08 §7 Q4). Until then each tile renders a typographic monogram on a soft
 * paper ground, so the layout and the relationship are already in place and a
 * real SVG dropped into `public/images/partners/<id>.svg` simply appears.
 *
 * Every tile has the same anatomy — a fixed-height mark slot (the logo, or the name set
 * as a wordmark while the artwork is pending), then the name and the role — so a row
 * of mixed tiles still lines up. Logos are sized optically (logoBox: equal visible area,
 * clamped to the slot) and shown in their own colours: the masters are cut free of their
 * plates (scripts/build-partner-logos.mjs), and a greyscale filter only turned the
 * coloured badges into grey boxes.
 */
import type { SourceLocale as Locale } from '@/i18n/config';
import { sitePartners, partnersForEvent, partnerSrc, logoBox, type Partner } from '@/lib/partners';

interface Props {
  locale: Locale;
  /** exhibition slug — narrows the wall to that show's own partners */
  event?: string | null;
  title?: string;
  kicker?: string;
  text?: string;
  /** show the shared SOF EXPO set together with the event set */
  includeSite?: boolean;
}

const { locale, event, title, kicker, text, includeSite = true } = Astro.props as Props;
const ru = locale === 'ru';

const eventPartners = event ? partnersForEvent(event) : [];
const shared = includeSite ? sitePartners() : [];
const list: Partner[] = [...eventPartners, ...shared];

const L = {
  kicker: kicker ?? (ru ? 'Партнёры' : 'Partners'),
  title: title ?? (ru ? 'Выставку делают вместе с нами' : 'Built together with our partners'),
  text:
    text ??
    (ru
      ? 'Ассоциации, государственные программы, отели и сервисы — каждый партнёр берёт на себя конкретную часть работы на выставке.'
      : 'Associations, state programmes, hotels and services — each partner carries a concrete part of the show.'),
  countable: ru ? 'организаций' : 'organizations',
};

---


<div class="pwl">
  <div class="pwl__head">
    <div>
      {L.kicker && <p class="kicker">{L.kicker}</p>}
      <h3>{L.title}</h3>
      {L.text && <p>{L.text}</p>}
    </div>
    {list.length > 0 && (
      <span class="mono-label pwl__count">{list.length} {L.countable}</span>
    )}
  </div>

  <ul class="pwl__grid">
    {
      list.map((p) => {
        const name = p.name[ru ? 'ru' : 'en'];
        const box = p.hasLogo ? logoBox(p.id, { area: 5000, maxW: 128, maxH: 54 }) : null;
        const inner = (
          <>
            <span class="pwl__mark">
              {box ? (
                /* the partner's name is printed right under the logo, so the image would only
                   repeat it to a screen reader — it is aria-hidden and the name is read; the alt stays
                   filled for search engines (Bing flags alt="" as missing) */
                <img class="pwl__logo" src={partnerSrc(p.id)} alt={name} aria-hidden="true" width={box.width} height={box.height} loading="lazy" decoding="async" />
              ) : (
                /* no artwork yet: the name itself is the wordmark — two-letter "PE", "TI"
                   initials read as placeholders, not as partners (docs/15 §11) */
                <span class="pwl__word">{name}</span>
              )}
            </span>
            {box && <span class="pwl__name">{name}</span>}
            {p.note && <span class="pwl__note">{p.note[ru ? 'ru' : 'en']}</span>}
          </>
        );
        return (
          <li class="pwl__item" data-kind={p.kind}>
            {p.url ? (
              <a class="pwl__link" href={p.url} target="_blank" rel="noopener noreferrer">
                {inner}
              </a>
            ) : (
              inner
            )}
          </li>
        );
      })
    }
  </ul>
</div>

<style>
  .pwl__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.8rem;
    margin-bottom: 1.4rem;
  }
  .pwl__head h3 {
    margin: 0.4rem 0 0.5rem;
    font-size: var(--t-h3);
  }
  .pwl__head p:last-child {
    margin: 0;
    max-width: 62ch;
    color: var(--ink-60);
    font-size: 0.95rem;
  }
  .pwl__count {
    flex: none;
    color: var(--ink-40);
  }
  .pwl__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    /* never a single column: on a phone 15 full-width tiles were a long, empty scroll */
    grid-template-columns: repeat(auto-fill, minmax(min(156px, calc(50% - 0.4rem)), 1fr));
    gap: 0.8rem;
  }
  .pwl__item {
    display: flex;
    min-width: 0;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r);
    transition: border-color var(--tr), box-shadow var(--tr);
  }
  .pwl__item:has(a):hover {
    border-color: var(--line-strong);
    box-shadow: 0 6px 18px -12px rgb(0 0 0 / 0.25);
  }
  .pwl__link {
    flex: 1;
  }
  /* the tile content: mark slot on top, name and role under it — same in every tile */
  .pwl__item,
  .pwl__link {
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 0.5rem;
    padding: 1.1rem 0.8rem 1rem;
    text-align: center;
  }
  .pwl__link {
    display: flex;
    margin: -1.1rem -0.8rem -1rem;
    color: inherit;
    text-decoration: none;
    border-radius: inherit;
  }
  .pwl__link:hover .pwl__name,
  .pwl__link:hover .pwl__word {
    color: var(--evergreen);
  }
  .pwl__link:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 3px;
  }
  .pwl__mark {
    flex: none;
    width: 100%;
    min-height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pwl__logo {
    display: block;
    max-width: 100%;
    height: auto;
  }
  .pwl__word {
    font-family: var(--f-display);
    font-size: 1rem;
    font-weight: 650;
    line-height: 1.22;
    letter-spacing: -0.01em;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .pwl__name {
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .pwl__note {
    font-size: 0.72rem;
    line-height: 1.3;
    color: var(--ink-60);
  }
</style>
