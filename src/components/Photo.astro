---
/**
 * One image element for the whole site.
 *
 * Every photograph in `public/images/` is built by `scripts/build-photos.mjs` into a
 * 640/1024/1600 WebP ladder plus a JPEG fallback, so a call site only ever names the
 * photo and the shape it should take — never a width, never a format:
 *
 *   <Photo src="/images/hall-stand.jpg" alt="…" ratio="16/10" sizes="(max-width:900px) 100vw, 33vw" />
 *
 * `priority` marks the LCP image (eager + high fetch priority + no lazy decode); everything
 * else is lazy and async, which is what keeps a photo-led page cheap. The wrapper carries the
 * aspect ratio so the layout never shifts while the bytes are in flight.
 */
import photos from '@/data/photos.json';
import photoMeta from '@/data/photo-meta.json';

const {
  src,
  alt,
  ratio = '16/10',
  sizes = '100vw',
  priority = false,
  class: klass = '',
  rounded = true,
  zoom = false,
  fit = 'cover',
  position,
  loading,
} = Astro.props as {
  src: string;
  alt: string;
  ratio?: string;
  sizes?: string;
  priority?: boolean;
  class?: string;
  rounded?: boolean;
  zoom?: boolean;
  fit?: 'cover' | 'contain';
  position?: string;
  loading?: 'eager' | 'lazy';
};

/** "/images/hall-stand.jpg" → "/images/hall-stand" (a built ladder) or null (a stray asset) */
const m = /^\/images\/([a-z0-9-]+)\.(jpg|jpeg|png|webp)$/i.exec(src);
const name = m?.[1];
/* the manifest is written by scripts/build-photos.mjs: it lists the rungs that were actually
   produced for each photo, so a 768px original never advertises a 1600w candidate (a 404 per
   card) and a 2048px one is not capped at 1024 for no reason. */
const rungs: number[] = (name && (photos as Record<string, number[]>)[name]) || [];
/* photo-meta.json (scripts/build-photos.mjs): the rungs' own aspect, the focal point libvips
   found, and whether an AVIF ladder exists next to the WebP one */
const info = (name && (photoMeta as Record<string, { r?: number; p?: string; a?: number }>)[name]) || {};
const srcset = rungs.length
  ? rungs.map((w) => `/images/${name}-${w}.webp ${w}w`).join(', ')
  : undefined;
const avifSet = rungs.length && info.a
  ? rungs.map((w) => `/images/${name}-${w}.avif ${w}w`).join(', ')
  : undefined;
const objectPosition = position ?? info.p ?? 'center';
const fallback = name ? `/images/${name}.jpg` : src;
const [rw, rh] = ratio.split('/').map((n) => Number(n.trim()) || 1);
/* A frame taller than the photograph shows only its middle with object-fit: cover, so the
   browser needs a wider file than the frame's own width: a 300px-wide 4:5 card of a 3:2
   photo on a 2x screen needs 1125 source pixels, not 600. `sizes` is scaled by that crop
   factor (calc() is valid inside sizes), which is what kept portrait cards soft on retina.
   Rungs keep the photo's own aspect (info.r); legacy 16:10 rungs fall back to 1.6. */
const crop = fit === 'cover' ? (info.r ?? 1.6) / (rw / rh) : 1;
const finalSizes =
  crop > 1.05
    ? sizes
        .split(',')
        .map((part) => {
          const mm = /^(\(.*\)\s+)?(.+)$/.exec(part.trim());
          return mm ? `${mm[1] ?? ''}calc(${mm[2]} * ${crop.toFixed(2)})` : part;
        })
        .join(', ')
    : sizes;
---

<figure
  class:list={['ph', klass, { 'ph--round': rounded, 'ph--zoom': zoom }]}
  style={`--ph-ratio:${rw} / ${rh};--ph-fit:${fit};--ph-pos:${objectPosition}`}
>
  <picture>
    {avifSet && <source type="image/avif" srcset={avifSet} sizes={finalSizes} />}
    {srcset && <source type="image/webp" srcset={srcset} sizes={finalSizes} />}
    <img
      src={fallback}
      alt={alt}
      width={1600}
      height={Math.round((1600 * rh) / rw)}
      loading={loading ?? (priority ? 'eager' : 'lazy')}
      decoding={priority ? 'sync' : 'async'}
      fetchpriority={priority ? 'high' : 'auto'}
      sizes={finalSizes}
    />
  </picture>
  <slot />
</figure>

<style>
  .ph {
    position: relative;
    margin: 0;
    overflow: hidden;
    display: block;
    background: var(--cream-2);
    aspect-ratio: var(--ph-ratio);
  }
  .ph--round {
    border-radius: var(--r-img);
  }
  .ph img {
    width: 100%;
    height: 100%;
    object-fit: var(--ph-fit);
    object-position: var(--ph-pos);
    display: block;
    transition: transform 600ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .ph--zoom:hover img,
  a:hover > .ph--zoom img,
  a:hover .ph--zoom img {
    transform: scale(1.045);
  }
  @media (prefers-reduced-motion: reduce) {
    .ph img {
      transition: none;
    }
    .ph--zoom:hover img {
      transform: none;
    }
  }
</style>
