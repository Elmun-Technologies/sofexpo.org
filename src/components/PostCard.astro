---
import type { SourceLocale as Locale } from '@/i18n/config';
import { postHref, type PostKind } from '@/lib/contentOwnership';
import { formatDate } from '@/lib/nav';
import { getEvent } from '@/data/events';
import { industryLabel } from '@/lib/labels';
import Icon from '@/components/Icon.astro';
import Photo from '@/components/Photo.astro';

const { locale, post, path, variant = 'default', priority = false } = Astro.props as {
  locale: Locale;
  post: {
    id: string;
    data: {
      title: string;
      description: string;
      date: Date;
      tags?: string[];
      category?: string;
      hero?: string;
      event?: string;
      readingMinutes?: number;
    };
  };
  path: string;
  variant?: 'default' | 'lead' | 'row';
  priority?: boolean;
};
const ru = locale === 'ru';
const slug = post.id.split('/').slice(1).join('/');
/* a piece tagged with a show that owns a hostname is published THERE — the centre's index
   card therefore carries an absolute URL, and on the show's own host it stays relative */
const href = postHref(locale, path.replace(/^\/|\/$/g, '') as PostKind, slug);
const relatedEvent = post.data.event ? getEvent(post.data.event) : undefined;
/** never a phantom path: poster of the linked show, otherwise the hall photo */
const hero = post.data.hero ?? relatedEvent?.heroImage ?? '/images/hero-hall.jpg';
const Hx = variant === 'lead' ? 'h2' : 'h3';
---

<article class:list={['pc', `pc--${variant}`]}>
  {variant !== 'row' && (
    <a class="pc__media" href={href} tabindex="-1" aria-hidden="true">
      <Photo src={hero} alt={post.data.title} ratio={variant === 'lead' ? '3/2' : '16/10'} rounded={false} zoom priority={priority} sizes={variant === 'lead' ? '(max-width: 900px) 100vw, 55vw' : '(max-width: 680px) 100vw, 33vw'} />
    </a>
  )}
  <div class="pc__body">
    <p class="pc__meta">
      <span class="mono-label">{industryLabel(post.data.category, locale)}</span>
      <span>·</span>
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date.toISOString().slice(0, 10), locale)}</time>
      {post.data.readingMinutes ? <span class="pc__rt"><Icon name="clock" size={13} /> {post.data.readingMinutes} {ru ? 'мин' : 'min'}</span> : null}
    </p>
    <Hx class:list={[variant === 'lead' ? 'pc__t--lead' : 'pc__t', 'h3']}>
      <a href={href}>{post.data.title}</a>
    </Hx>
    <p class="pc__d">{post.data.description}</p>
    <p class="pc__go">
      <a href={href}>{ru ? 'Читать' : 'Read'} →</a>
      {relatedEvent ? <span class="mono-label">· {relatedEvent.shortName}</span> : null}
    </p>
    {post.data.tags?.length ? (
      <ul class="tag-list">
        {post.data.tags.map((tg) => <li>{tg}</li>)}
      </ul>
    ) : null}
  </div>
</article>

<style>
  .pc {
    display: grid;
    gap: 0.9rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r-img);
    overflow: hidden;
    padding-bottom: clamp(1rem, .7rem + 1vw, 1.4rem);
    transition: box-shadow var(--tr), border-color var(--tr), transform var(--tr);
  }
  .pc:not(.pc--row):hover {
    border-color: transparent;
    box-shadow: var(--shadow-lift);
    transform: translateY(-3px);
  }
  .pc__media {
    display: block;
  }
  .pc__media img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    display: block;
  }
  /* the lead card runs full width on the index: photo beside the text, not a 520px billboard above it */
  @media (min-width: 900px) {
    .pc--lead {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: center;
      padding-bottom: 0;
    }
    .pc--lead .pc__media,
    .pc--lead .pc__media img {
      height: 100%;
    }
    .pc--lead .pc__media img {
      aspect-ratio: auto;
      min-height: 340px;
    }
    .pc--lead .pc__body {
      padding-block: clamp(1.2rem, 0.8rem + 1.4vw, 2rem);
    }
  }
  .pc__body {
    padding: 0 clamp(1rem, .7rem + 1vw, 1.5rem);
  }
  .pc__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 0.5rem;
    font-size: 0.8rem;
    color: var(--ink-40);
  }
  .pc__rt {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  .pc__t,
  .pc__t--lead {
    margin: 0 0 0.45rem;
    font-size: 1.08rem;
    line-height: 1.25;
    letter-spacing: -0.012em;
  }
  .pc__t--lead {
    font-size: clamp(1.3rem, 1.05rem + 1vw, 1.85rem);
    max-width: 22ch;
  }
  .pc :is(h2, h3) a {
    color: inherit;
    text-decoration: none;
  }
  .pc :is(h2, h3) a:hover {
    color: var(--moss);
  }
  .pc__go {
    margin: 0.7rem 0 0;
  }

  .pc__go a {
    font-weight: 600;
    transition: color var(--tr);
  }

  .pc__d {
    margin: 0;
    color: var(--ink-60);
    font-size: 0.95rem;
  }
  .pc--row {
    grid-template-columns: minmax(0, 1fr);
    padding-top: 1.1rem;
    border-radius: 0;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: transparent;
  }
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
    margin: 0.8rem 0 0;
  }
  .tag-list li {
    font-size: 0.75rem;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    color: var(--ink-60);
  }
</style>
