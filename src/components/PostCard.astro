---
import type { Locale } from '@/i18n/config';
import { localize } from '@/i18n/config';
import { formatDate } from '@/lib/nav';
import Icon from '@/components/Icon.astro';

const { locale, post, path, variant = 'default', priority = false } = Astro.props as {
  locale: Locale;
  post: {
    id: string;
    data: {
      title: string;
      description: string;
      date: Date;
      tags?: string[];
      category?: string;
      hero?: string;
      readingMinutes?: number;
    };
  };
  path: string;
  variant?: 'default' | 'lead' | 'row';
  priority?: boolean;
};
const ru = locale === 'ru';
const slug = post.id.split('/').slice(1).join('/');
const href = localize(locale, `${path}${slug}/`);
const hero = post.data.hero ?? '/images/venue-gallery.jpg';
---

<article class:list={['pc', `pc--${variant}`]}>
  {variant !== 'row' && (
    <a class="pc__media" href={href} tabindex="-1" aria-hidden="true">
      <img src={hero} alt="" width={variant === 'lead' ? 1200 : 800} height={variant === 'lead' ? 700 : 520} loading={priority ? 'eager' : 'lazy'} decoding="async" />
    </a>
  )}
  <div class="pc__body">
    <p class="pc__meta">
      <span class="mono-label">{post.data.category ?? (ru ? 'заметка' : 'note')}</span>
      <span>·</span>
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date.toISOString().slice(0, 10), locale)}</time>
      {post.data.readingMinutes ? <span class="pc__rt"><Icon name="clock" size={13} /> {post.data.readingMinutes} {ru ? 'мин' : 'min'}</span> : null}
    </p>
    <h3 class:list={[variant === 'lead' ? 'pc__t--lead' : 'pc__t']}>
      <a href={href}>{post.data.title}</a>
    </h3>
    <p class="pc__d">{post.data.description}</p>
    {post.data.tags?.length ? (
      <ul class="tag-list">
        {post.data.tags.map((tg) => <li>{tg}</li>)}
      </ul>
    ) : null}
  </div>
</article>

<style>
  .pc {
    display: grid;
    gap: 0.9rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
    padding-bottom: clamp(1rem, .7rem + 1vw, 1.4rem);
  }
  .pc__media {
    display: block;
  }
  .pc__media img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    display: block;
  }
  .pc__body {
    padding: 0 clamp(1rem, .7rem + 1vw, 1.5rem);
  }
  .pc__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 0.5rem;
    font-size: 0.8rem;
    color: var(--ink-40);
  }
  .pc__rt {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  .pc__t,
  .pc__t--lead {
    margin: 0 0 0.4rem;
    font-size: clamp(1.1rem, 1rem + .5vw, 1.45rem);
    line-height: 1.22;
  }
  .pc__t--lead {
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.4rem);
    max-width: 26ch;
  }
  .pc h3 a {
    color: inherit;
    text-decoration: none;
  }
  .pc h3 a:hover {
    color: var(--moss);
  }
  .pc__d {
    margin: 0;
    color: var(--ink-60);
    font-size: 0.95rem;
  }
  .pc--row {
    grid-template-columns: minmax(0, 1fr);
    padding-top: 1.1rem;
    border-radius: 0;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: transparent;
  }
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
    margin: 0.8rem 0 0;
  }
  .tag-list li {
    font-size: 0.75rem;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    color: var(--ink-60);
  }
</style>
