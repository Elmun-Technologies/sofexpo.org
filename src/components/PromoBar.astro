---
/**
 * Next-event strip (docs/08 §3.1): one line, 36px, only on the pages that need the calendar
 * — the home and the line-up. Every other page has its own CTA; the strip used to sit above
 * the fold on all 152 pages and pushed the content 40px down.
 * Driven entirely by `events.ts` — when the date passes, the strip moves to the next show,
 * and if nothing is upcoming it is not rendered at all.
 */
import { localize, type SourceLocale as Locale } from '@/i18n/config';
import { nextEvent } from '@/data/events';
import { daysUntil } from '@/lib/labels';
import Icon from '@/components/Icon.astro';

const { locale, hideFor = '' } = Astro.props as { locale: Locale; hideFor?: string };
const ru = locale === 'ru';
const L = (p: string) => localize(locale, p);

const event = nextEvent();
/** home and the line-up only; not on the event's own page (its hero already says all this) */
const show =
  !!event &&
  event.status !== 'past' &&
  !!event.highlight &&
  (hideFor === '/' || (hideFor.startsWith('/events/') && !hideFor.startsWith(`/events/${event.slug}/`)));
const days = daysUntil(event?.dates.start ?? '');
const countdown =
  days > 1
    ? ru
      ? `через ${days} ${days === 1 ? 'день' : days < 5 ? 'дня' : days < 21 || days > 24 ? 'дней' : 'дня'}`
      : `in ${days} days`
    : days === 1
      ? ru
        ? 'завтра'
        : 'tomorrow'
      : ru
        ? 'идёт сейчас'
        : 'running now';
---

{
  show && (
    <div class="promo" data-promo={event!.slug}>
      <div class="wrap promo__in">
        <a class="promo__txt" href={L(`/events/${event!.slug}/`)}>
          <span class="dot" aria-hidden="true"></span>
          <b>{event!.brand[locale]}</b>
          <span class="promo__date">{event!.dates.display[locale]}</span>
          <span class="promo__count">{countdown}</span>
          <Icon name="arrow" size={13} />
        </a>
        <a class="btn btn--sm btn--light" href={`${L('/request-stand/')}?event=${event!.slug}`}>
          <Icon name="sparkle" size={14} />
          {ru ? 'Стенд' : 'Stand'}
        </a>
      </div>
    </div>
  )
}
