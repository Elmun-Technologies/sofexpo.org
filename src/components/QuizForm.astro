---
/**
 * Lead quiz — a Rush-Agency-style multi-step funnel adapted to the centre's design
 * system (docs: tap-only choice steps, contact fields last, one promise line).
 *
 * Mechanics absorbed from rush-agency.ru:
 *   1. three single-tap questions before any typing (a person who answered two
 *      questions does not abandon the third),
 *   2. progress "Step N of 4" + bar, with a Back control,
 *   3. contact-channel choice (phone call / Telegram) on the final step,
 *   4. a working-hours reply promise next to the submit button,
 *   5. a success state that confirms the selection and offers the next action.
 *
 * No-JS contract mirrors `LeadForm.astro`: every step is server-rendered and visible
 * without JavaScript, so the quiz degrades to one long form that still submits.
 * All localized strings come from `src/i18n/ui.ts` (`quiz.*`) — the inline script
 * contains no human-readable literals, so the zh/tr editions stay deterministic.
 */
import { useUI } from '@/i18n/ui';
import { localize, type Locale } from '@/i18n/config';
import { events } from '@/data/events';
import { site } from '@/data/site';
import Icon from '@/components/Icon.astro';

const {
  locale,
  title,
  subtitle,
  note = '',
  id = 'quiz',
  shows = [],
  areas = [],
  compact = false,
  /** focused mode: the show is already known (event page) — step 1 collapses to a
      hidden field and the funnel becomes three steps (goal → area → contact) */
  event = '',
} = Astro.props as {
  locale: Locale;
  title?: string;
  subtitle?: string;
  note?: string;
  id?: string;
  /** stand-show option labels; defaults to the current line-up */
  shows?: string[];
  /** stand-area option labels; defaults to the standard ladder */
  areas?: string[];
  compact?: boolean;
  event?: string;
};

const t = useUI(locale);
const ru = locale === 'ru';
const endpoint = (import.meta.env.PUBLIC_LEAD_ENDPOINT ?? '').trim();
const focused = !!event;

const defaultShows = [...events.map((e) => e.brand[locale] ?? e.brand.en), t('quiz.q1any')];
const showList = shows.length ? [...shows, t('quiz.q1any')] : defaultShows;
const goalList: { value: string; label: string }[] = [
  { value: 'sales', label: t('quiz.goal.sales') },
  { value: 'export', label: t('quiz.goal.export') },
  { value: 'brand', label: t('quiz.goal.brand') },
  { value: 'dealers', label: t('quiz.goal.dealers') },
  { value: 'other', label: t('quiz.goal.other') },
];
const areaList = areas.length ? [...areas, t('quiz.q3any')] : ['9 m²', '12 m²', '18 m²', '36 m²', '50+ m²', t('quiz.q3any')];

const steps = focused
  ? [t('quiz.step1of3'), t('quiz.step2of3'), t('quiz.step3of3')]
  : [t('quiz.step1'), t('quiz.step2'), t('quiz.step3'), t('quiz.step4')];
/* data-step numbering shifts by one in focused mode: the show question is a hidden field */
const goalStep = focused ? 1 : 2;
const areaStep = focused ? 2 : 3;
const contactStep = focused ? 3 : 4;
const barWidth = focused ? '33%' : '25%';
/* both label sets ship server-rendered: a modal quiz can be re-focused to three
   steps at runtime, and translations must not be computed in the client */
const labelSets = focused
  ? [{ mode: '3', labels: steps }]
  : [
      { mode: '4', labels: steps },
      { mode: '3', labels: [t('quiz.step1of3'), t('quiz.step2of3'), t('quiz.step3of3')] },
    ];
const phoneCodes = ['+998', '+7', '+90', '+86', '+996', '+992', '+966', '+971', '+48', '+49', '+44', '+1'];
const tgHref = site.contacts.telegramManager;
const telHref = `tel:${site.contacts.phoneMain.replace(/\s/g, '')}`;
const mailto = `mailto:${site.contacts.emailAlt}?subject=${encodeURIComponent(ru ? 'Заявка на участие' : 'Participation request')}`;
---

<div class:list={['quiz', 'card', { 'quiz--compact': compact }]} data-quiz data-quiz-mode={focused ? '3' : '4'} data-endpoint={endpoint || undefined} data-ok={t('form.sent')} data-err={t('form.error')} data-fallback={ru ? 'Мы получили ваш контакт только в этом браузере — отправьте заявку также на почту.' : 'Your request was kept in this browser only — please also send it by email.'}>
  {(title || subtitle) && (
    <div class="quiz__head">
      {title && <h3>{title}</h3>}
      {subtitle && <p class="muted small" data-nosnippet>{subtitle}</p>}
    </div>
  )}

  <div class="quiz__progress" aria-hidden="true">
    <div class="quiz__labels">
      {labelSets.map((set) =>
        set.labels.map((label) => (
          <span data-step-label data-mode={set.mode} hidden>
            {label}
          </span>
        )),
      )}
    </div>
    <span class="quiz__bar">
      <span class="quiz__fill" data-quiz-bar style={barWidth}></span>
    </span>
  </div>

  <form data-quiz-form novalidate>
    {/* Focused mode carries the show as a hidden field instead of question 1 */}
    {focused && <input type="hidden" name="event" value={event} />}

    {!focused && (
      <fieldset class="quiz__step" data-step="1">
        <legend tabindex="-1">{t('quiz.q1')}</legend>
        <div class="quiz__opts">
          {showList.map((label, i) => (
            <label class="quiz__opt">
              <input type="radio" name="event" value={label} data-unsure={i === showList.length - 1 ? '1' : undefined} />
              <span class="quiz__opt-label">{label}</span>
              <span class="quiz__opt-check">
                <Icon name="check" size={15} />
              </span>
            </label>
          ))}
        </div>
        <button class="quiz__back" type="button" data-quiz-back hidden>
          <Icon name="arrow" size={14} /> {t('quiz.back')}
        </button>
      </fieldset>
    )}

    {/* The goal. One tap. */}
    <fieldset class="quiz__step" data-step={goalStep}>
      <legend tabindex="-1">{t('quiz.q2')}</legend>
      <div class="quiz__opts">
        {goalList.map((g) => (
          <label class="quiz__opt">
            <input type="radio" name="goal" value={g.label} />
            <span class="quiz__opt-label">{g.label}</span>
            <span class="quiz__opt-check">
              <Icon name="check" size={15} />
            </span>
          </label>
        ))}
      </div>
      <button class="quiz__back" type="button" data-quiz-back hidden>
        <Icon name="arrow" size={14} /> {t('quiz.back')}
      </button>
    </fieldset>

    {/* Step 3 — the area. Measurement strings stay locale-neutral. */}
    <fieldset class="quiz__step" data-step={areaStep}>
      <legend tabindex="-1">{t('quiz.q3')}</legend>
      <div class="quiz__opts quiz__opts--row">
        {areaList.map((label, i) => (
          <label class="quiz__opt quiz__opt--chip">
            <input type="radio" name="area" value={label} data-unsure={i === areaList.length - 1 ? '1' : undefined} />
            <span class="quiz__opt-label">{label}</span>
            <span class="quiz__opt-check">
              <Icon name="check" size={15} />
            </span>
          </label>
        ))}
      </div>
      <button class="quiz__back" type="button" data-quiz-back hidden>
        <Icon name="arrow" size={14} /> {t('quiz.back')}
      </button>
    </fieldset>

    {/* Step 4 — contact. The only typing step; everything above it is already answered. */}
    <fieldset class="quiz__step" data-step={contactStep} data-quiz-contact>
      <legend tabindex="-1">{t('quiz.contact')}</legend>

      <div class="form quiz-form-grid">
        <div class="field">
          <label for={`${id}-name`}>{t('form.name')} *</label>
          <input id={`${id}-name`} name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for={`${id}-company`}>{t('form.company')} *</label>
          <input id={`${id}-company`} name="company" type="text" autocomplete="organization" required />
        </div>
        <div class="field">
          <label for={`${id}-phone`}>{t('form.phone')} *</label>
          <span class="quiz-tel">
            <select name="phone_code" aria-label={t('form.phone')}>
              {phoneCodes.map((code, i) => (
                <option selected={i === 0}>
                  {code}
                </option>
              ))}
            </select>
            <input id={`${id}-phone`} name="phone" type="tel" autocomplete="tel" required placeholder="90 123 45 67" />
          </span>
        </div>
        <div class="field">
          <label for={`${id}-email`}>{t('form.email')}</label>
          <input id={`${id}-email`} name="email" type="email" autocomplete="email" />
        </div>
      </div>

      <div class="quiz__channel" role="group" aria-label={t('quiz.channel')}>
        <span class="quiz__channel-label">{t('quiz.channel')}</span>
        <label class="quiz__seg">
          <input type="radio" name="channel" value="call" checked />
          <Icon name="phone" size={15} /> {t('quiz.channel.call')}
        </label>
        <label class="quiz__seg">
          <input type="radio" name="channel" value="telegram" />
          <Icon name="telegram" size={15} /> Telegram
        </label>
      </div>

      <div class="field">
        <label for={`${id}-comment`}>{t('form.comment')}</label>
        <textarea id={`${id}-comment`} name="comment" rows="2"></textarea>
      </div>

      <label class="quiz__consent">
        <input type="checkbox" name="consent" required />
        <span>{t('form.consent')}</span>
      </label>

      <div class="quiz__actions">
        <button class="btn btn--gold" type="submit">{t('form.submit')}</button>
        <a class="btn btn--ghost btn--sm" href={mailto}>{ru ? 'Написать на почту' : 'Or write an email'}</a>
      </div>

      <p class="quiz__trust">
        <Icon name="zap" size={15} /> <span>{t('quiz.trust')}</span> <a href={telHref}>{site.contacts.phoneMain}</a>
      </p>
      {note && <p class="form__note">{note}</p>}
      <p class="form__msg" role="status" aria-live="polite" hidden></p>
      <button class="quiz__back" type="button" data-quiz-back hidden>
        <Icon name="arrow" size={14} /> {t('quiz.back')}
      </button>
    </fieldset>
  </form>

  {/* Success: confirm the selection (endowment) and hand over the next action. */}
  <div class="quiz__done" data-quiz-done hidden>
    <p class="quiz__done-title" data-nosnippet>
      <Icon name="check" size={18} /> {t('form.sent')}
    </p>
    <dl class="quiz__summary">
      <div>
        <dt>{t('form.event')}</dt>
        <dd data-quiz-summary="event">—</dd>
      </div>
      <div>
        <dt>{t('quiz.goal.label')}</dt>
        <dd data-quiz-summary="goal">—</dd>
      </div>
      <div>
        <dt>{t('form.area')}</dt>
        <dd data-quiz-summary="area">—</dd>
      </div>
    </dl>
    <div class="quiz__done-links">
      <a class="btn btn--sm btn--gold" href={localize(locale, '/events/')}>
        <Icon name="calendar" size={15} /> {t('quiz.done.calendar')}
      </a>
      <a class="btn btn--sm btn--ghost" href={tgHref} target="_blank" rel="noopener">
        <Icon name="telegram" size={15} /> {t('quiz.done.manager')}
      </a>
    </div>
  </div>
</div>

<script is:inline>
  /* No human-readable literals here: every localized string is read from the DOM,
     so the strict zh/tr localization can rewrite the markup without touching JS. */
  (function () {
    var init = function (root) {
      if (root.dataset.quizReady) return;
      root.dataset.quizReady = '1';
      var form = root.querySelector('[data-quiz-form]');
      var done = root.querySelector('[data-quiz-done]');
      var bar = root.querySelector('[data-quiz-bar]');
      var labels = root.querySelectorAll('[data-step-label]');
      var steps = root.querySelectorAll('[data-step]');
      var backs = root.querySelectorAll('[data-quiz-back]');
      var msg = root.querySelector('.form__msg');
      if (!form || !steps.length) return;
      var current = 1;
      var total = steps.length;
      var mode = root.dataset.quizMode || '4';
      var started = false;

      /* funnel telemetry: safe without any tag manager — GA4/Yandex Metrika pick
         these up from window.dataLayer as soon as a container is added */
      var track = function (name, data) {
        try {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push(Object.assign({ event: name, quiz: 'stand' }, data || {}));
        } catch (err) {}
      };

      var render = function () {
        root.classList.add('quiz--on');
        for (var i = 0; i < steps.length; i++) {
          var n = Number(steps[i].dataset.step);
          steps[i].hidden = root.classList.contains('quiz--on') && n !== current;
          steps[i].classList.toggle('quiz__step--active', n === current);
        }
        if (bar) bar.style.width = Math.round((current / total) * 100) + '%';
        var shown = 0;
        for (var j = 0; j < labels.length; j++) {
          var inSet = labels[j].dataset.mode === mode;
          labels[j].hidden = !inSet || shown !== current - 1;
          if (inSet) shown += 1;
        }
        for (var k = 0; k < backs.length; k++) backs[k].hidden = current === 1;
      };

      /* Any tap on a choice (fresh or repeat) moves forward. The click handler covers
         re-clicking an already-selected option — the case `change` never fires for,
         which used to dead-end a step after returning to it via Back. `change` covers
         keyboard selection; the timestamp guard prevents the double advance. */
      var lastClick = 0;
      var choice = function (el) {
        return el && el.type === 'radio' && el.name !== 'channel' && el.closest('[data-step]:not([data-quiz-contact])');
      };
      var move = function () {
        if (current < total) {
          if (!started) {
            started = true;
            track('quiz_start', { step: current, total: total });
          }
          current += 1;
          render();
          track('quiz_step', { step: current, total: total });
          var legend = steps[current - 1].querySelector('legend');
          if (legend) legend.focus({ preventScroll: true });
          steps[current - 1].scrollIntoView({ block: 'nearest' });
        }
      };
      form.addEventListener('click', function (e) {
        var el = e.target && e.target.closest ? e.target.closest('input[type=radio]') : null;
        if (!choice(el)) return;
        lastClick = Date.now();
        if (el.checked) move();
      });
      form.addEventListener('change', function (e) {
        var el = e.target;
        if (!choice(el)) return;
        if (Date.now() - lastClick < 250) return; /* the click handler already moved */
        move();
      });
      for (var b = 0; b < backs.length; b++) {
        backs[b].addEventListener('click', function () {
          if (current > 1) {
            current -= 1;
            render();
            track('quiz_step', { step: current, total: total, back: 1 });
            var legend = steps[current - 1].querySelector('legend');
            if (legend) legend.focus({ preventScroll: true });
          }
        });
      }

      /* Runtime re-focus (rush-agency.ru behaviour): a trigger carrying
         data-quiz-event turns the general quiz into the focused three-step funnel
         for that show. Only meaningful while the visitor is still on step 1. */
      root.addEventListener('quiz:focus', function (e) {
        if (root.dataset.quizFocused === '1' || current !== 1) return;
        var name = e.detail && e.detail.event;
        if (!name) return;
        var show = form.querySelector('fieldset[data-step="1"]');
        if (!show || !show.querySelector('input[name=event]')) return; /* already focused */
        show.hidden = true;
        show.removeAttribute('data-step'); /* leave the step numbering to the live set */
        show.querySelectorAll('input').forEach(function (el) {
          el.disabled = true;
        });
        var carry = document.createElement('input');
        carry.type = 'hidden';
        carry.name = 'event';
        carry.value = name;
        form.insertBefore(carry, form.firstChild);
        var ordered = Array.prototype.filter.call(steps, function (fs) {
          return fs !== show;
        });
        ordered.forEach(function (fs, i) {
          fs.dataset.step = String(i + 1);
        });
        steps = ordered;
        total = ordered.length;
        mode = '3';
        root.dataset.quizFocused = '1';
        render();
      });

      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        if (msg) {
          msg.hidden = true;
          msg.textContent = '';
        }
        var data = new FormData(form);
        if (!form.checkValidity()) {
          form.querySelectorAll(':invalid').forEach(function (el) {
            el.style.borderColor = 'var(--danger)';
          });
          if (msg) {
            msg.hidden = false;
            msg.textContent = root.dataset.err || '';
            msg.style.background = '#fbe9e7';
            msg.style.borderColor = 'rgba(178,58,47,.3)';
            msg.style.color = 'var(--danger)';
          }
          return;
        }
        var payload = Object.fromEntries(data.entries());
        /* radio values are the visible labels — the manager reads the answer, not an id */
        payload.phone = (payload.phone_code || '') + (payload.phone ? ' ' + payload.phone : '');
        delete payload.phone_code;
        payload.quiz = 'stand';
        payload.page = location.pathname;
        payload.ts = new Date().toISOString();
        /* attribution captured at open time (StandQuizModal) and at first landing */
        try {
          var actx = JSON.parse(sessionStorage.getItem('sofexpo.leadctx') || '{}');
          payload.src = root.dataset.source || actx.src || '';
          payload.landing = actx.landing || '';
          payload.referrer = actx.ref || '';
          var aqs = new URLSearchParams(location.search);
          ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'].forEach(function (k) {
            var v = aqs.get(k) || (actx.utm && actx.utm[k]);
            if (v) payload[k] = v;
          });
        } catch (err) {}
        track('quiz_submit', { show: payload.event, goal: payload.goal, area: payload.area, channel: payload.channel, src: payload.src || 'inline' });
        var endpoint = root.dataset.endpoint;
        if (msg) {
          msg.hidden = false;
          msg.style.background = '';
          msg.style.borderColor = '';
          msg.style.color = '';
        }
        if (endpoint) {
          try {
            var res = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
            if (!res.ok) throw new Error('bad status');
          } catch (err) {
            if (msg) msg.textContent = root.dataset.fallback || '';
            return;
          }
        } else {
          try {
            var key = 'sofexpo.leads';
            var all = JSON.parse(localStorage.getItem(key) || '[]');
            all.push(payload);
            localStorage.setItem(key, JSON.stringify(all));
          } catch (err) {}
        }
        var fill = function (name, value) {
          var slot = done && done.querySelector('[data-quiz-summary=' + name + ']');
          if (slot) slot.textContent = value;
        };
        fill('event', payload.event);
        fill('goal', payload.goal);
        fill('area', payload.area);
        form.hidden = true;
        var head = root.querySelector('.quiz__progress');
        if (head) head.hidden = true;
        if (done) done.hidden = false;
        if (done) done.scrollIntoView({ block: 'nearest' });
      });

      render();
    };
    var scan = function () {
      document.querySelectorAll('[data-quiz]').forEach(init);
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', scan);
    else scan();
  })();
</script>

<style>
  .quiz {
    display: grid;
    gap: 1.1rem;
    scroll-margin-top: 110px;
    border-radius: var(--r-lg);
    box-shadow: var(--shadow);
    padding: clamp(1.4rem, 1rem + 1.6vw, 2.2rem);
  }
  .quiz--compact {
    padding: clamp(1.1rem, 0.9rem + 1vw, 1.5rem);
    gap: 0.9rem;
  }
  .quiz__head h3 {
    margin-bottom: 0.25em;
  }
  .quiz__head p {
    margin: 0;
  }

  /* progress — labels swap under JS, the bar fills a quarter per step */
  .quiz__progress {
    display: grid;
    gap: 0.45rem;
  }
  .quiz__labels {
    min-height: 1.1em;
    font-family: var(--f-mono);
    font-size: var(--t-kicker);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-40);
  }
  .quiz__bar {
    display: block;
    height: 4px;
    border-radius: var(--r-pill);
    background: var(--cream-2);
    overflow: hidden;
  }
  .quiz__fill {
    display: block;
    height: 100%;
    background: var(--moss);
    transition: width var(--tr);
  }

  fieldset.quiz__step {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }
  .quiz__step legend {
    font-weight: 700;
    font-size: var(--t-h3);
    font-family: var(--f-display);
    padding: 0;
    margin-bottom: 0.85rem;
    outline: none;
  }
  .quiz__opts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: 0.55rem;
  }
  .quiz__opts--row {
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
  }
  .quiz__opt {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: #fff;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.95rem;
    transition: border-color var(--tr), background var(--tr), box-shadow var(--tr);
  }
  .quiz__opt:hover {
    border-color: var(--moss);
  }
  .quiz__opt:has(input:checked) {
    border-color: var(--evergreen);
    background: #f2f7f3;
    box-shadow: inset 0 0 0 1px var(--evergreen);
  }
  .quiz__opt:has(input:focus-visible) {
    outline: none;
    box-shadow: 0 0 0 4px rgba(29, 122, 72, 0.16);
  }
  .quiz__opt input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .quiz__opt-check {
    color: var(--moss);
    opacity: 0;
    flex: none;
    transition: opacity var(--tr);
  }
  .quiz__opt:has(input:checked) .quiz__opt-check {
    opacity: 1;
  }
  .quiz__opt--chip {
    justify-content: center;
    text-align: center;
    padding-block: 0.7rem;
  }
  .quiz__opt--chip .quiz__opt-check {
    display: none;
  }

  .quiz__back {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.9rem;
    border: 0;
    background: none;
    padding: 0;
    font: inherit;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--ink-60);
    cursor: pointer;
  }
  .quiz__back svg {
    transform: rotate(180deg);
  }
  .quiz__back:hover {
    color: var(--ink);
  }

  /* contact step */
  .quiz-form-grid {
    margin-bottom: 0.4rem;
  }
  .quiz-tel {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 0.5rem;
  }
  .quiz-tel select {
    font: inherit;
    padding: 0.85rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: #fff;
    color: var(--ink);
