---
/** Reusable building blocks for page composition. */
const { locale, kicker, title, text, align = 'left', level = 2 } = Astro.props as {
  locale: 'ru' | 'en';
  kicker?: string;
  title: string;
  text?: string;
  align?: 'left' | 'center';
  /** heading level: 1 on index pages that own the page title, 2 inside a page */
  level?: 1 | 2;
};
---
<div class:list={['sec-head', { 'sec-head--center': align === 'center' }]}>
  <div>
    {/* on an index page the kicker is part of the h1 — it names the query (docs/16 §2.2) */}
    {kicker && level !== 1 && <p class="kicker">{kicker}</p>}
    {level === 1 ? <h1 class="h1">{kicker && <span class="kicker">{kicker}</span>}{kicker && ' '}<Fragment set:html={title} /></h1> : <h2 set:html={title} />}
  </div>
  {text && <p>{text}</p>}
  <slot name="aside" />
</div>
