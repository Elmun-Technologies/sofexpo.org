---
/**
 * The SOF EXPO team wall.
 *
 * The client's posters are finished 1:1 artboards — name, role, the brand frame and,
 * on three of them, a direct phone number — so the card is shown whole (never cropped)
 * and the text beneath it exists for the people the picture cannot serve: screen
 * readers, search engines and anyone who needs to copy a name. Items are grouped by
 * `kind` so the wall reads in the order a visitor actually wants it: leadership and
 * commercial decision-makers first, then the customer-facing managers, then the
 * back-office staff.
 */
import type { Locale } from "@/i18n/config";
import { team, teamKinds, type TeamMember } from "@/data/team";

const { locale, kicker, title, text } = Astro.props as {
  locale: Locale;
  kicker?: string;
  title?: string;
  text?: string;
};

const ru = locale === "ru";
const total = team.length;

/* The wall is the only place these 17 people are named on the site, and a team page
   is exactly the kind of thing people search for by name. Without Person markup the
   poster is an opaque image and the caption is loose text; with it each team member
   becomes an addressable entity that can surface for "<name> Samarkand" queries.
   ItemList preserves the wall order, which is also the order of responsibility. */
const personLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: team.map((m, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "Person",
      name: m.name[locale],
      jobTitle: m.role[locale],
      image: `https://sofexpo.org/images/team/${m.card}.jpg`,
      worksFor: { "@type": "Organization", name: "SOF EXPO Samarkand" },
      ...(m.phone ? { telephone: m.phone } : {}),
    },
  })),
};

/* group once so the markup can render each band with its own heading */
const ORDER: TeamMember["kind"][] = [
  "leadership",
  "sales",
  "client",
  "technical",
  "operations",
  "support",
];
const groups = ORDER.map((k) => ({
  kind: k,
  label: teamKinds[k][locale],
  list: team.filter((m) => m.kind === k),
})).filter((g) => g.list.length > 0);
---

<script type="application/ld+json" set:html={JSON.stringify(personLd)} is:inline />

<div class="tw">
  {(kicker || title || text) && (
    <div class="sec-head">
      <div>
        {kicker && <p class="kicker">{kicker}</p>}
        {title && <h2>{title}</h2>}
        {text && <p style="margin-top:.6rem">{text}</p>}
      </div>
      <p class="mono-label tw__count">
        {total} {ru ? "сотрудников" : "people"}
      </p>
    </div>
  )}

  {groups.map((g) => (
    <section class="tw__band">
      <h3 class="tw__band-h">{g.label}</h3>
      <ul class="tw__grid">
        {g.list.map((m, i) => (
          <li class="tw__item">
            <figure class="tw__card">
              <picture>
                <source
                  type="image/webp"
                  srcset={`/images/team/${m.card}-400.webp 400w, /images/team/${m.card}-800.webp 800w, /images/team/${m.card}-1200.webp 1200w`}
                  sizes="(max-width: 560px) 50vw, (max-width: 900px) 33vw, 25vw"
                />
                <img
                  src={`/images/team/${m.card}.jpg`}
                  alt={`${m.name[locale]} — ${m.role[locale]}${m.blurb ? `. ${m.blurb[locale]}` : ""}`}
                  width="1200"
                  height="1200"
                  loading={i < 4 ? "eager" : "lazy"}
                  decoding="async"
                />
              </picture>
            </figure>
            <div class="tw__meta">
              <b>{m.name[locale]}</b>
              <span>{m.role[locale]}</span>
              {m.phone && (
                <a class="tw__phone mono-label" href={`tel:${m.phone.replace(/\s+/g, "")}`}>
                  {m.phone}
                </a>
              )}
            </div>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  .tw__count {
    white-space: nowrap;
  }
  .tw__band + .tw__band {
    margin-top: clamp(2.2rem, 1.4rem + 2vw, 3.4rem);
  }
  .tw__band-h {
    margin: 0 0 1rem;
    font-family: var(--f-mono);
    font-size: .78rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--moss);
  }
  .tw__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, .6rem + 1.4vw, 1.8rem);
  }
  .tw__item {
    display: flex;
    flex-direction: column;
    gap: .8rem;
  }
  .tw__card {
    margin: 0;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--cream-2);
    box-shadow: var(--shadow-soft);
    transition:
      transform var(--tr),
      box-shadow var(--tr);
  }
  .tw__item:hover .tw__card {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lift);
  }
  .tw__card img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    background: #0a1f3d;
  }
  .tw__meta {
    display: grid;
    gap: .15rem;
    line-height: 1.35;
  }
  .tw__meta b {
    font-family: var(--f-display);
    font-size: 1rem;
    letter-spacing: -.012em;
  }
  .tw__meta span {
    font-size: .85rem;
    color: var(--ink-60);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .tw__phone {
    margin-top: .35rem;
    color: var(--evergreen);
    text-decoration: none;
    width: max-content;
  }
  .tw__phone:hover {
    color: var(--moss);
  }
  @media (max-width: 900px) {
    .tw__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 480px) {
    .tw__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: .8rem;
    }
    .tw__meta b {
      font-size: .92rem;
    }
    .tw__meta span {
      font-size: .78rem;
    }
  }
</style>