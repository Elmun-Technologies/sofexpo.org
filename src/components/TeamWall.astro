---
/**
 * The SOF EXPO team wall.
 *
 * The client's posters are finished 1:1 artboards — name, role, the brand frame and,
 * on three of them, a direct phone number — so the card is shown whole (never cropped)
 * and the text beneath it exists for the people the picture cannot serve: screen
 * readers, search engines and anyone who needs to copy a name.
 *
 * The wall is grouped by `kind` into numbered bands, 01–07: leadership first, then
 * media and marketing, then show sales, then the client managers a buyer gets routed
 * to, then the technical, operations and support staff who keep the centre running.
 * Each band is its own reveal section with a per-card 70ms stagger, so scrolling the
 * wall reads like turning pages instead of one long grid.
 */
import type { SourceLocale as Locale } from "@/i18n/config";
import { team, teamKinds, type TeamMember } from "@/data/team";

const { locale, kicker, title, text } = Astro.props as {
  locale: Locale;
  kicker?: string;
  title?: string;
  text?: string;
};

const ru = locale === "ru";
const total = team.length;

/* RU plurals: 1 сотрудник / 2 сотрудника / 5 сотрудников; EN: 1 person / N people */
const people = (n: number) =>
  ru
    ? `${n} ${
        n % 10 === 1 && n % 100 !== 11
          ? "сотрудник"
          : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14)
            ? "сотрудника"
            : "сотрудников"
      }`
    : `${n} ${n === 1 ? "person" : "people"}`;

/* The wall is the only place these 17 people are named on the site, and a team page
   is exactly the kind of thing people search for by name. Without Person markup the
   poster is an opaque image and the caption is loose text; with it each team member
   becomes an addressable entity that can surface for "<name> Samarkand" queries.
   ItemList preserves the wall order, which is also the order of responsibility. */
const personLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: team.map((m, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "Person",
      name: m.name[locale],
      jobTitle: m.role[locale],
      image: `https://sofexpo.org/images/team/${m.card}.jpg`,
      worksFor: { "@type": "Organization", name: "SOF EXPO Samarkand" },
      ...(m.phone ? { telephone: m.phone } : {}),
    },
  })),
};

/* group once so the markup can render each band with its own heading. `team` in
   src/data/team.ts is authored in this same order, so the rendered wall and the
   ItemList above always tell the same story. */
const ORDER: TeamMember["kind"][] = [
  "leadership",
  "media",
  "sales",
  "client",
  "technical",
  "operations",
  "support",
];
const groups = ORDER.map((k) => ({
  kind: k,
  label: teamKinds[k][locale],
  list: team.filter((m) => m.kind === k),
})).filter((g) => g.list.length > 0);
---

<script type="application/ld+json" set:html={JSON.stringify(personLd)} is:inline />

<div class="tw">
  {(kicker || title || text) && (
    <div class="sec-head">
      <div>
        {kicker && <p class="kicker">{kicker}</p>}
        {title && <h2>{title}</h2>}
        {text && <p style="margin-top:.6rem">{text}</p>}
      </div>
      <p class="mono-label tw__count">{people(total)}</p>
    </div>
  )}

  {groups.map((g, n) => (
    <section class="tw__band reveal" id={`team-${g.kind}`}>
      <header class="tw__band-h">
        <span class="num tw__num" aria-hidden="true">
          {String(n + 1).padStart(2, "0")}
        </span>
        <h3>{g.label}</h3>
        <span class="tw__hairline" aria-hidden="true" />
        <span class="mono-label tw__chip">{people(g.list.length)}</span>
      </header>
      <ul class:list={["tw__grid", g.kind === "leadership" && "tw__grid--lead"]}>
        {g.list.map((m, i) => (
          <li class="tw__item" style={`--i:${i}`}>
            <figure class="tw__card">
              <picture>
                <source
                  type="image/webp"
                  srcset={`/images/team/${m.card}-400.webp 400w, /images/team/${m.card}-800.webp 800w, /images/team/${m.card}-1200.webp 1200w`}
                  sizes={
                    g.kind === "leadership"
                      ? "(max-width: 900px) 50vw, 45vw"
                      : "(max-width: 560px) 50vw, (max-width: 900px) 33vw, 25vw"
                  }
                />
                <img
                  src={`/images/team/${m.card}.jpg`}
                  alt={`${m.name[locale]} — ${m.role[locale]}${m.blurb ? `. ${m.blurb[locale]}` : ""}`}
                  width="1200"
                  height="1200"
                  loading={n === 0 ? "eager" : "lazy"}
                  decoding="async"
                />
              </picture>
            </figure>
            <div class="tw__meta">
              <b>{m.name[locale]}</b>
              <span>{m.role[locale]}</span>
              {m.phone && (
                <a class="tw__phone mono-label" href={`tel:${m.phone.replace(/\s+/g, "")}`}>
                  {m.phone}
                </a>
              )}
            </div>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  .tw__count {
    white-space: nowrap;
  }
  .tw__band {
    /* band anchors (#team-leadership … #team-support) land clear of the sticky header */
    scroll-margin-top: 100px;
  }
  .tw__band + .tw__band {
    margin-top: clamp(2.2rem, 1.4rem + 2vw, 3.4rem);
  }
  .tw__band-h {
    display: flex;
    align-items: center;
    gap: .9rem;
    margin: 0 0 1.1rem;
  }
  .tw__num {
    font-size: 1rem;
    color: var(--gold);
  }
  .tw__band-h h3 {
    margin: 0;
    font-family: var(--f-mono);
    font-size: .8rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--moss);
  }
  .tw__hairline {
    flex: 1;
    height: 1px;
    background: var(--line);
  }
  .tw__chip {
    white-space: nowrap;
  }
  /* mobile-first: two cards per row on a phone (the square portraits need the room),
     four only at ≥900px (docs/04 §5) */
  .tw__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .8rem;
  }
  /* leadership gets the two big cards — the names a visitor scans for first */
  .tw__grid--lead {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.2rem, .8rem + 2vw, 2.4rem);
  }
  .tw__item {
    display: flex;
    flex-direction: column;
    gap: .8rem;
    /* the band reveals as one section; the cards walk in behind it, 70ms apart */
    transition:
      opacity 620ms cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 620ms cubic-bezier(0.22, 0.61, 0.36, 1);
    transition-delay: calc(var(--i, 0) * 70ms);
  }
  .reveal-pending .tw__item {
    opacity: 0;
    transform: translateY(16px);
  }
  .reveal-in .tw__item {
    opacity: 1;
    transform: none;
  }
  .tw__card {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--cream-2);
    transition: transform var(--tr), border-color var(--tr);
  }
  .tw__item:hover .tw__card {
    transform: translateY(-3px);
    border-color: var(--sage);
  }
  .tw__card img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    background: #0a1f3d;
    transition: transform 600ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .tw__item:hover .tw__card img {
    transform: scale(1.035);
  }
  .tw__meta {
    display: grid;
    gap: .15rem;
    line-height: 1.35;
  }
  .tw__meta b {
    font-family: var(--f-display);
    font-size: .92rem;
    letter-spacing: -.012em;
    transition: color var(--tr);
  }
  .tw__item:hover .tw__meta b {
    color: var(--evergreen);
  }
  .tw__meta span {
    font-size: .78rem;
    color: var(--ink-60);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .tw__phone {
    margin-top: .35rem;
    color: var(--evergreen);
    text-decoration: none;
    width: max-content;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: .3rem .75rem;
    transition:
      background-color var(--tr),
      border-color var(--tr),
      color var(--tr);
  }
  .tw__phone:hover {
    background: var(--moss);
    border-color: var(--moss);
    color: #fff;
  }
  @media (prefers-reduced-motion: reduce) {
    .tw__item {
      transition: none;
    }
    .tw__card img {
      transition: none;
      transform: none;
    }
  }
  @media print {
    /* a not-yet-revealed card must never print invisible */
    .reveal-pending .tw__item {
      opacity: 1 !important;
      transform: none !important;
    }
  }
  @media (min-width: 481px) {
    .tw__grid {
      gap: clamp(1rem, .6rem + 1.4vw, 1.8rem);
    }
    .tw__meta b {
      font-size: 1rem;
    }
    .tw__meta span {
      font-size: .85rem;
    }
  }
  @media (min-width: 900px) {
    .tw__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
