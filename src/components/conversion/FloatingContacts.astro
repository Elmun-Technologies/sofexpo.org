---
/**
 * FloatingContacts — always-visible TG/WA/Phone on mobile + desktop side rail
 * Contact hold: never lose a lead
 */
import { conversionConfig } from '@/data/conversion';
import type { SourceLocale as Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
  variant?: 'fab' | 'rail' | 'both';
}

const { locale, variant = 'both' } = Astro.props as Props;
const ru = locale === 'ru';
const channels = conversionConfig.channels[ru ? 'ru' : 'en'].filter(c => c.primary);
const phone = conversionConfig.contacts.phoneDisplay;

const L = {
  tg: ru ? 'Telegram' : 'Telegram',
  wa: ru ? 'WhatsApp' : 'WhatsApp',
  call: ru ? 'Позвонить' : 'Call',
  write: ru ? 'Написать' : 'Write us',
};
---

<!-- Desktop rail (left side) -->
<div translate="no">
{ (variant === 'rail' || variant === 'both') && (
  <div class="fc-rail" aria-label={L.write}>
    {channels.map(ch => (
      <a class="fc-rail__btn" href={ch.href} target="_blank" rel="noopener" data-channel={ch.id} data-source="rail" style={`--ch:${ch.color}`} aria-label={ch.label} title={ch.label}>
        <span class="fc-rail__icon">
          {ch.id === 'telegram' && (
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2Zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75l-.88-.58c-.5-.33-.17-.51.11-.82.24-.25 4.4-4.03 4.48-4.38.01-.04.02-.14-.1-.2s-.2-.04-.29-.02c-.12.02-1.95 1.24-5.5 3.65-.52.36-.99.53-1.41.52-.46-.01-1.35-.26-2.01-.48-.81-.26-1.45-.4-1.4-.84.02-.23.35-.47.96-.71 3.76-1.64 6.27-2.72 7.53-3.25 3.58-1.5 4.33-1.76 4.82-1.77.1 0 .33.02.48.14a.34.34 0 0 1 .14.27c-.01.06-.02.14-.03.22Z"/></svg>
          )}
          {ch.id === 'whatsapp' && (
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19.05 4.91A9.82 9.82 0 0 0 12.04 2C6.56 2 2.11 6.45 2.11 10.93c0 1.58.41 3.11 1.19 4.47L2 22l6.77-1.78a9.78 9.78 0 0 0 4.68 1.19h.01c5.48 0 9.93-4.45 9.93-9.93a9.78 9.78 0 0 0-2.88-6.97l-.46.5.46-.5ZM12.05 19.6a7.8 7.8 0 0 1-3.98-1.09l-.29-.17-4.02 1.05 1.07-3.92-.19-.4a7.82 7.82 0 0 1-1.2-4.14c0-4.32 3.51-7.83 7.84-7.83a7.8 7.8 0 0 1 5.53 2.29 7.8 7.8 0 0 1 2.29 5.54c0 4.32-3.52 7.83-7.84 7.83h-.21Zm4.29-5.86c-.23-.12-1.37-.68-1.58-.75-.21-.08-.37-.12-.52.12s-.6.75-.74.91c-.13.15-.27.17-.5.06-.23-.12-.97-.36-1.85-1.14-.68-.61-1.14-1.36-1.28-1.59-.13-.23-.01-.36.1-.47.1-.1.23-.27.35-.4.11-.13.15-.23.23-.38.08-.15.04-.28-.02-.4-.06-.11-.52-1.26-.71-1.72-.19-.45-.38-.39-.52-.4h-.44c-.15 0-.4.06-.61.28-.21.23-.8.78-.8 1.9s.82 2.21.93 2.36c.11.15 1.61 2.46 3.9 3.45.54.23.97.37 1.3.48.55.17 1.05.15 1.44.09.44-.07 1.37-.56 1.56-1.1.19-.54.19-1 .13-1.1-.06-.1-.21-.15-.44-.27Z"/></svg>
          )}
        </span>
        <span class="fc-rail__label">{ch.name}</span>
      </a>
    ))}
    <a class="fc-rail__btn fc-rail__btn--phone" href={`tel:${conversionConfig.contacts.phone}`} data-channel="phone" data-source="rail" aria-label={L.call} title={phone}>
      <span class="fc-rail__icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07A19.5 19.5 0 0 1 5 12.07 19.8 19.8 0 0 1 1.93 3.44 2 2 0 0 1 3.92 1h3a2 2 0 0 1 2 1.72c.12 1 .39 2 .8 2.94a2 2 0 0 1-.45 2.11L9 8a16 16 0 0 0 6 6l.77-1.27a2 2 0 0 1 2.11-.45c.94.41 1.94.68 2.94.8A2 2 0 0 1 22 14.92Z"></path></svg>
      </span>
      <span class="fc-rail__label">{phone}</span>
    </a>
  </div>
)}

<!-- Mobile bottom bar (only on mobile, hidden when form in viewport) -->
{ (variant === 'fab' || variant === 'both') && (
  <div class="fc-mob" id="fc-mob" data-locale={locale}>
    <div class="fc-mob__in">
      <a class="fc-mob__btn fc-mob__btn--tg" href={channels.find(c=>c.id==='telegram')?.href} target="_blank" rel="noopener" data-channel="telegram" data-source="mobile-bar">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2Zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75l-.88-.58c-.5-.33-.17-.51.11-.82.24-.25 4.4-4.03 4.48-4.38.01-.04.02-.14-.1-.2s-.2-.04-.29-.02c-.12.02-1.95 1.24-5.5 3.65-.52.36-.99.53-1.41.52-.46-.01-1.35-.26-2.01-.48-.81-.26-1.45-.4-1.4-.84.02-.23.35-.47.96-.71 3.76-1.64 6.27-2.72 7.53-3.25 3.58-1.5 4.33-1.76 4.82-1.77.1 0 .33.02.48.14a.34.34 0 0 1 .14.27c-.01.06-.02.14-.03.22Z"/></svg>
        Telegram
      </a>
      <a class="fc-mob__btn fc-mob__btn--wa" href={channels.find(c=>c.id==='whatsapp')?.href} target="_blank" rel="noopener" data-channel="whatsapp" data-source="mobile-bar">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19.05 4.91A9.82 9.82 0 0 0 12.04 2C6.56 2 2.11 6.45 2.11 10.93c0 1.58.41 3.11 1.19 4.47L2 22l6.77-1.78a9.78 9.78 0 0 0 4.68 1.19h.01c5.48 0 9.93-4.45 9.93-9.93a9.78 9.78 0 0 0-2.88-6.97l-.46.5.46-.5ZM12.05 19.6a7.8 7.8 0 0 1-3.98-1.09l-.29-.17-4.02 1.05 1.07-3.92-.19-.4a7.82 7.82 0 0 1-1.2-4.14c0-4.32 3.51-7.83 7.84-7.83a7.8 7.8 0 0 1 5.53 2.29 7.8 7.8 0 0 1 2.29 5.54c0 4.32-3.52 7.83-7.84 7.83h-.21Zm4.29-5.86c-.23-.12-1.37-.68-1.58-.75-.21-.08-.37-.12-.52.12s-.6.75-.74.91c-.13.15-.27.17-.5.06-.23-.12-.97-.36-1.85-1.14-.68-.61-1.14-1.36-1.28-1.59-.13-.23-.01-.36.1-.47.1-.1.23-.27.35-.4.11-.13.15-.23.23-.38.08-.15.04-.28-.02-.4-.06-.11-.52-1.26-.71-1.72-.19-.45-.38-.39-.52-.4h-.44c-.15 0-.4.06-.61.28-.21.23-.8.78-.8 1.9s.82 2.21.93 2.36c.11.15 1.61 2.46 3.9 3.45.54.23.97.37 1.3.48.55.17 1.05.15 1.44.09.44-.07 1.37-.56 1.56-1.1.19-.54.19-1 .13-1.1-.06-.1-.21-.15-.44-.27Z"/></svg>
        WhatsApp
      </a>
      <a class="fc-mob__btn fc-mob__btn--phone" href={`tel:${conversionConfig.contacts.phone}`} data-channel="phone" data-source="mobile-bar">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07A19.5 19.5 0 0 1 5 12.07 19.8 19.8 0 0 1 1.93 3.44 2 2 0 0 1 3.92 1h3a2 2 0 0 1 2 1.72c.12 1 .39 2 .8 2.94a2 2 0 0 1-.45 2.11L9 8a16 16 0 0 0 6 6l.77-1.27a2 2 0 0 1 2.11-.45c.94.41 1.94.68 2.94.8A2 2 0 0 1 22 14.92Z"></path></svg>
        {ru ? 'Звонок' : 'Call'}
      </a>
    </div>
  </div>
)}
</div>

<style>
  /* Desktop rail — left side, vertical; hidden by default (mobile-first: the
     bottom bar is the phone layout), the rail is a ≥901px enhancement */
  .fc-rail {
    position: fixed;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    z-index: 40;
    display: none;
    flex-direction: column;
    gap: 2px;
    padding: 6px 0;
    background: var(--paper);
    border: 1px solid var(--line);
    border-left: 0;
    border-radius: 0 12px 12px 0;
    box-shadow: var(--shadow);
  }
  .fc-rail__btn {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px 10px 12px;
    text-decoration: none;
    color: var(--ink);
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
    position: relative;
    overflow: hidden;
    transition: all var(--tr);
  }
  .fc-rail__btn:hover {
    background: color-mix(in srgb, var(--ch, var(--evergreen)) 10%, white);
    color: var(--ch, var(--evergreen));
    padding-right: 18px;
  }
  .fc-rail__icon {
    width: 36px;
    height: 36px;
    border-radius: 9px;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--ch, var(--evergreen)) 14%, white);
    color: var(--ch, var(--evergreen));
    flex: none;
  }
  .fc-rail__btn--phone {
    --ch: var(--evergreen);
  }
  .fc-rail__label {
    max-width: 0;
    overflow: hidden;
    opacity: 0;
    transition: all var(--tr);
  }
  .fc-rail:hover .fc-rail__label {
    max-width: 160px;
    opacity: 1;
  }
  .fc-rail__btn--phone .fc-rail__label {
    font-family: var(--f-mono);
    font-size: 12px;
  }

  /* Mobile bottom bar */
  .fc-mob {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 39;
    padding: 8px 10px max(8px, env(safe-area-inset-bottom));
    background: rgba(255,255,255,0.92);
    backdrop-filter: blur(18px) saturate(160%);
    border-top: 1px solid var(--line);
    transform: translateY(0);
    transition: transform 0.32s cubic-bezier(0.22, 0.61, 0.36, 1);
    display: block;
  }
  .fc-mob.is-hidden {
    transform: translateY(110%);
  }
  .fc-mob__in {
    display: grid;
    grid-template-columns: 1fr 1fr 92px;
    gap: 8px;
    max-width: 480px;
    margin: 0 auto;
  }
  .fc-mob__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 12px;
    border-radius: 12px;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid transparent;
    transition: transform var(--tr), box-shadow var(--tr);
  }
  .fc-mob__btn:active {
    transform: scale(0.98);
  }
  .fc-mob__btn--tg {
    background: #229ED9;
    color: #fff;
  }
  .fc-mob__btn--wa {
    background: #25D366;
    color: #fff;
  }
  .fc-mob__btn--phone {
    background: var(--evergreen);
    color: #fff;
  }

  /* mobile-first: the bottom bar reserves room in the document flow on every
     phone; the ≥901px tier swaps to the side rail and releases the padding */
  :global(body) {
    padding-bottom: 72px;
  }
  @media (min-width: 901px) {
    .fc-rail { display: flex; }
    .fc-mob { display: none !important; }
    :global(body) {
      padding-bottom: 0;
    }
  }
</style>

<script>
  /* NOTE: must stay a plain <script> (no is:inline / no translate="no"): Astro then
     transpiles this TypeScript and bundles it as a deferred module. Extra attributes
     make Astro emit it raw, which breaks in every browser. The i18n build pass
     rewrites only the known UI strings inside it (scripts/localization.mjs). */
  (() => {
    const bar = document.getElementById('fc-mob');
    if (!bar) return;
    const hideWhenFormVisible = () => {
      const forms = document.querySelectorAll('form[data-lead-form], .form-wrap');
      if (!forms.length) return;
      const io = new IntersectionObserver((entries) => {
        const anyVisible = entries.some(e => e.isIntersecting);
        bar.classList.toggle('is-hidden', anyVisible);
      }, { threshold: 0.2 });
      forms.forEach(f => io.observe(f));
    };
    // hide on scroll down, show on scroll up
    let lastY = window.scrollY;
    let ticking = false;
    const onScroll = () => {
      const y = window.scrollY;
      if (Math.abs(y - lastY) < 12) return;
      if (y > lastY && y > 300) bar.classList.add('is-hidden');
      else bar.classList.remove('is-hidden');
      lastY = y;
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(onScroll);
        ticking = true;
      }
    }, { passive: true });

    // track clicks
    bar.querySelectorAll('[data-channel]').forEach(a => {
      a.addEventListener('click', () => {
        const ch = (a as HTMLElement).dataset.channel;
        const src = (a as HTMLElement).dataset.source;
        try { (window as any).sofTrack?.('channel_click', { channel: ch, source: src, locale: bar.dataset.locale }); } catch {}
      });
    });
    document.querySelectorAll('.fc-rail [data-channel]').forEach(a => {
      a.addEventListener('click', () => {
        const ch = (a as HTMLElement).dataset.channel;
        try { (window as any).sofTrack?.('channel_click', { channel: ch, source: 'rail' }); } catch {}
      });
    });

    hideWhenFormVisible();
  })();
</script>
