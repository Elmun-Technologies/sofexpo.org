---
/**
 * FormHandler — central handler for all conversion forms
 * Handles validation, endpoint, localStorage fallback, tracking, success states
 */
---

<script>
  /* NOTE: must stay a plain <script> (no is:inline / no translate="no"): Astro then
     transpiles this TypeScript and bundles it as a deferred module. Extra attributes
     make Astro emit it raw, which breaks in every browser. It skips forms already
     bound by LeadForm's inline handler (dataset.handlerBound). */
  import { conversionConfig } from '@/data/conversion';
  const CONTACTS = conversionConfig.contacts;

  (() => {
    const ENDPOINT = (import.meta.env.PUBLIC_LEAD_ENDPOINT || '').trim();
    const LEADS_KEY = 'sofexpo.leads';
    const FORMS_SELECTOR = 'form[data-lead-form]';

    const getForms = () => Array.from(document.querySelectorAll(FORMS_SELECTOR));

    /* The manager reads the relayed message, so its labels are Russian whatever the
       page language; unknown keys pass through as they are. */
    const RELAY_LABELS = {
      formType: 'Форма', event: 'Выставка', name: 'Имя', company: 'Компания', position: 'Должность',
      phone: 'Телефон', email: 'Email', direction: 'Направление', area: 'Площадь', goal: 'Цель',
      purpose: 'Цель', industry: 'Отрасль', package: 'Пакет', eventType: 'Формат', attendees: 'Гостей',
      count: 'Человек', date: 'Дата', time: 'Время', channel: 'Связь', messenger: 'Мессенджер',
      comment: 'Комментарий', page: 'Страница',
    };
    const RELAY_SKIP = new Set(['consent', 'ts', 'locale', 'url', 'referrer', 'source', '_error', 'utm_source', 'utm_medium', 'utm_campaign']);
    const relayText = (payload) => {
      const lines = ['Заявка с сайта SOF EXPO'];
      for (const [k, v] of Object.entries(payload)) {
        if (RELAY_SKIP.has(k) || v == null || String(v).trim() === '') continue;
        lines.push(`${RELAY_LABELS[k] || k}: ${String(v).trim()}`);
      }
      return lines.join('\n');
    };
    /** Show the fallback notice plus WhatsApp / email links carrying the whole request.
     *  Shared with LeadForm and the quiz (window.sofLeadRelay). */
    const relay = (root, payload, msg) => {
      if (msg) {
        msg.hidden = false;
        msg.textContent = root.dataset.fallback || 'Your request was kept in this browser only — please also send it by email.';
        msg.className = 'form__msg form__ok';
        msg.style.background = '#fef3c7';
        msg.style.borderColor = '#fcd34d';
        msg.style.color = '#92400e';
        msg.style.display = 'block';
      }
      const text = relayText(payload);
      let box = root.querySelector('.lead-relay');
      if (!box) {
        box = document.createElement('div');
        box.className = 'lead-relay btn-row';
        (msg && msg.parentNode === root ? msg : root.lastElementChild)?.after(box);
      }
      box.replaceChildren();
      const link = (href, label, channel) => {
        const a = document.createElement('a');
        a.className = 'btn btn--sm';
        a.href = href;
        a.textContent = label;
        a.dataset.channel = channel;
        if (channel !== 'email') { a.target = '_blank'; a.rel = 'noopener'; }
        box.append(a);
      };
      link(`${CONTACTS.whatsapp}?text=${encodeURIComponent(text)}`, 'WhatsApp', 'whatsapp');
      link(`mailto:${CONTACTS.email}?subject=${encodeURIComponent('Заявка с сайта SOF EXPO')}&body=${encodeURIComponent(text)}`, 'Email', 'email');
      link(CONTACTS.telegramManager, 'Telegram', 'telegram');
    };
    window.sofLeadRelay = relay;

    const initForm = (form) => {
      if (form.dataset.handlerBound === '1') return;
      form.dataset.handlerBound = '1';

      const msg = form.querySelector('.form__msg, .form-ex__msg, [role="status"]');
      const endpoint = form.dataset.endpoint || ENDPOINT;
      const formType = form.dataset.formType || 'generic';
      const source = form.dataset.source || form.id || 'unknown';

      // Track start
      let started = false;
      form.addEventListener('input', () => {
        if (!started) {
          started = true;
          try { window.sofTrack?.('form_start', { form: formType, source, id: form.id }); } catch {}
        }
      }, { once: true });

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(form);
        // validation
        if (!form.checkValidity()) {
          form.querySelectorAll(':invalid').forEach(el => {
            el.style.borderColor = 'var(--danger, #a33518)';
            el.addEventListener('input', () => { el.style.borderColor = ''; }, { once: true });
          });
          if (msg) {
            msg.hidden = false;
            msg.textContent = form.dataset.err || 'Please fill required fields';
            msg.className = 'form__msg form__ok';
            msg.style.background = '#fbe9e7';
            msg.style.borderColor = 'rgba(178,58,47,.3)';
            msg.style.color = 'var(--danger, #a33518)';
            msg.style.display = 'block';
          }
          try { window.sofTrack?.('form_error', { form: formType, source, reason: 'validation' }); } catch {}
          return;
        }

        const payload = Object.fromEntries(fd.entries());
        payload.page = location.pathname;
        payload.formType = formType;
        payload.source = source;
        payload.ts = new Date().toISOString();
        payload.locale = document.documentElement.lang || 'ru';
        payload.url = location.href;
        payload.referrer = document.referrer || '';
        // UTM
        try {
          const params = new URLSearchParams(location.search);
          payload.utm_source = params.get('utm_source') || '';
          payload.utm_medium = params.get('utm_medium') || '';
          payload.utm_campaign = params.get('utm_campaign') || '';
        } catch {}

        if (msg) { msg.hidden = true; msg.textContent = ''; }
        form.querySelector('.lead-relay')?.remove();

        const submitBtn = form.querySelector('button[type="submit"]');
        const origBtnText = submitBtn ? submitBtn.textContent : '';
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.dataset.origText = origBtnText;
          submitBtn.textContent = `${origBtnText} …`;
        }

        let delivered = false;
        if (endpoint) {
          try {
            const res = await fetch(endpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });
            if (!res.ok) throw new Error('bad status ' + res.status);
            delivered = true;
          } catch (err) {
            console.warn('[Form] endpoint failed', err);
            payload._error = String(err);
          }
        }

        /* Not delivered (no endpoint configured, or it failed): never say "received".
           Keep the fields, keep a local copy, and hand the visitor the same request
           ready to send by WhatsApp or email — the lead still reaches a manager. */
        if (!delivered) {
          try {
            const all = JSON.parse(localStorage.getItem(LEADS_KEY) || '[]');
            all.push({ ...payload, _fallback: true });
            localStorage.setItem(LEADS_KEY, JSON.stringify(all));
          } catch {}
          relay(form, payload, msg);
          try { window.sofTrack?.('form_submit', { form: formType, source, id: form.id, success: false, fallback: true }); } catch {}
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = origBtnText;
          }
          return;
        }
        const success = true;

        if (success) {
          if (msg) {
            msg.textContent = form.dataset.ok || 'Request received!';
            msg.style.background = '#e7efe8';
            msg.style.borderColor = 'var(--sage, #dfe8e0)';
            msg.style.color = 'var(--evergreen-2, #14402a)';
            msg.style.display = 'block';
          }
          // clear fields
          form.querySelectorAll('input:not([type=checkbox]):not([type=radio]):not([readonly]), textarea').forEach(el => {
            if (el.type !== 'hidden') el.value = '';
          });
          form.querySelectorAll('input[type=checkbox], input[type=radio]').forEach(el => {
            if (el.name === 'consent') el.checked = false;
          });
          form.querySelectorAll('select').forEach(el => { el.selectedIndex = 0; });

          try { window.sofTrack?.('form_submit', { form: formType, source, id: form.id, success: true }); } catch {}

          // Optional: show thank you popup or redirect
          // If catalog form, trigger download
          if (formType === 'catalog') {
            setTimeout(() => {
              const link = document.createElement('a');
              link.href = '/files/catalog-' + (payload.event || 'general') + '.pdf';
              link.download = '';
              // fallback to general catalog
              link.href = '/files/foodera-2026-presentation.pdf';
              // don't auto download without user gesture in some browsers, but try
              try { link.click(); } catch {}
            }, 800);
          }

        }

        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = origBtnText;
        }
      });
    };

    /* A link that names the show (/request-stand/?event=foodera-expo, or sofexpo.uz's
       ?exhibition=<slug>) should arrive with the show already chosen: one field less to
       fill is one field less to abandon. The show names live in the form itself — the
       script matches the slug's first word against whatever the page renders, in any
       language, so nothing has to be duplicated here. */
    const prefillEvent = () => {
      let raw = '';
      try {
        const qs = new URLSearchParams(location.search);
        raw = (qs.get('event') || qs.get('exhibition') || '').trim();
      } catch (err) {
        return;
      }
      if (!raw) return;
      const norm = (v) => String(v || '').toLowerCase().replace(/[^a-z0-9а-яё]+/g, '');
      const token = norm(raw.split('-')[0]);
      if (!token) return;
      let label = '';
      /* Values are set silently: the stand quiz advances on `change`, so firing one here
         would scroll the visitor past the hero and log a quiz start they never made.
         The selected card is visible, and one tap on it moves the quiz on as usual. */
      document.querySelectorAll('select[name="event"]').forEach((sel) => {
        const hit = Array.from(sel.options).find((o) => norm(o.textContent || o.value).includes(token));
        if (!hit) return;
        sel.value = hit.value;
        label = label || hit.value;
      });
      document.querySelectorAll('input[type="radio"][name="event"]').forEach((radio) => {
        if (!norm(radio.value).includes(token)) return;
        radio.checked = true;
        label = label || radio.value;
      });
      if (!label) return;
      document.querySelectorAll('input[name="event"]:not([type="hidden"])').forEach((input) => {
        if (!input.value) input.value = label;
      });
    };

    const initAll = () => {
      prefillEvent();
      getForms().forEach(initForm);
    };

    // Init on DOM ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }

    // Watch for dynamically added forms (popups)
    const observer = new MutationObserver(() => initAll());
    observer.observe(document.body, { childList: true, subtree: true });

    // Expose
    window.sofFormHandler = { initAll, initForm };
  })();
</script>
