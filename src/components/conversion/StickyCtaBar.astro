---
/**
 * StickyCtaBar — ideal CTA placement system
 * Shows after scroll, hides when form visible, per-page variants
 */
import { conversionConfig } from '@/data/conversion';
import type { SourceLocale as Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
  pageType?: 'home' | 'exhibitors' | 'visitors' | 'organizers' | 'event' | 'venue' | 'other';
  eventName?: string;
}

const { locale, pageType = 'other', eventName = '' } = Astro.props as Props;
const ru = locale === 'ru';

const ctas = {
  exhibitor: {
    label: ru ? 'Забронировать стенд' : 'Book a stand',
    sub: ru ? 'Ответ за 15 минут · план зала в подарок' : 'Reply in 15 min · floor plan free',
    href: `/${locale}/request-stand/`,
    action: 'open-exhibitor-form',
  },
  visitor: {
    label: ru ? 'Получить билет' : 'Get ticket',
    sub: ru ? 'Бесплатно для специалистов' : 'Free for trade visitors',
    href: `/${locale}/visitors/tickets/`,
    action: 'open-visitor-form',
  },
  organizer: {
    label: ru ? 'Забронировать зал' : 'Book a hall',
    sub: ru ? '4400 м² + 5000 м² улица' : '4400 m² + 5000 m² outdoor',
    href: `/${locale}/organizers/`,
    action: 'open-organizer-form',
  },
};

let activeCta = ctas.exhibitor;
if (pageType === 'visitors') activeCta = ctas.visitor;
if (pageType === 'organizers') activeCta = ctas.organizer;
if (pageType === 'event' && eventName) {
  activeCta = {
    ...ctas.exhibitor,
    label: ru ? `Стенд на ${eventName}` : `Stand at ${eventName}`,
  };
}

const L = {
  tg: ru ? 'Telegram' : 'Telegram',
  wa: ru ? 'WhatsApp' : 'WhatsApp',
  dismiss: ru ? 'Скрыть' : 'Dismiss',
};
---

<div id="sticky-cta" class="s-cta" data-page-type={pageType} translate="no" hidden>
  <div class="s-cta__in wrap">
    <div class="s-cta__txt">
      <b class="s-cta__title">{activeCta.label}</b>
      <span class="s-cta__sub">{activeCta.sub}</span>
    </div>
    <div class="s-cta__actions">
      <a class="btn btn--sm s-cta__btn" href={activeCta.href} data-cta={activeCta.action} data-source="sticky-bar">
        {activeCta.label}
      </a>
      <div class="s-cta__messengers">
        <a class="s-cta__m" href={conversionConfig.contacts.telegramManager} target="_blank" rel="noopener" data-channel="telegram" data-source="sticky-bar" aria-label={L.tg}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2Zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75l-.88-.58c-.5-.33-.17-.51.11-.82.24-.25 4.4-4.03 4.48-4.38.01-.04.02-.14-.1-.2s-.2-.04-.29-.02c-.12.02-1.95 1.24-5.5 3.65-.52.36-.99.53-1.41.52-.46-.01-1.35-.26-2.01-.48-.81-.26-1.45-.4-1.4-.84.02-.23.35-.47.96-.71 3.76-1.64 6.27-2.72 7.53-3.25 3.58-1.5 4.33-1.76 4.82-1.77.1 0 .33.02.48.14a.34.34 0 0 1 .14.27c-.01.06-.02.14-.03.22Z"/></svg>
        </a>
        <a class="s-cta__m s-cta__m--wa" href={conversionConfig.contacts.whatsapp} target="_blank" rel="noopener" data-channel="whatsapp" data-source="sticky-bar" aria-label={L.wa}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M19.05 4.91A9.82 9.82 0 0 0 12.04 2C6.56 2 2.11 6.45 2.11 10.93c0 1.58.41 3.11 1.19 4.47L2 22l6.77-1.78a9.78 9.78 0 0 0 4.68 1.19h.01c5.48 0 9.93-4.45 9.93-9.93a9.78 9.78 0 0 0-2.88-6.97l-.46.5.46-.5ZM12.05 19.6a7.8 7.8 0 0 1-3.98-1.09l-.29-.17-4.02 1.05 1.07-3.92-.19-.4a7.82 7.82 0 0 1-1.2-4.14c0-4.32 3.51-7.83 7.84-7.83a7.8 7.8 0 0 1 5.53 2.29 7.8 7.8 0 0 1 2.29 5.54c0 4.32-3.52 7.83-7.84 7.83h-.21Zm4.29-5.86c-.23-.12-1.37-.68-1.58-.75-.21-.08-.37-.12-.52.12s-.6.75-.74.91c-.13.15-.27.17-.5.06-.23-.12-.97-.36-1.85-1.14-.68-.61-1.14-1.36-1.28-1.59-.13-.23-.01-.36.1-.47.1-.1.23-.27.35-.4.11-.13.15-.23.23-.38.08-.15.04-.28-.02-.4-.06-.11-.52-1.26-.71-1.72-.19-.45-.38-.39-.52-.4h-.44c-.15 0-.4.06-.61.28-.21.23-.8.78-.8 1.9s.82 2.21.93 2.36c.11.15 1.61 2.46 3.9 3.45.54.23.97.37 1.3.48.55.17 1.05.15 1.44.09.44-.07 1.37-.56 1.56-1.1.19-.54.19-1 .13-1.1-.06-.1-.21-.15-.44-.27Z"/></svg>
        </a>
      </div>
      <button class="s-cta__close" type="button" aria-label={L.dismiss}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"></path></svg>
      </button>
    </div>
  </div>
</div>

<style>
  /* mobile-first: on a phone the bar floats above the contact bar (bottom: 64px)
     and runs compact; the full-height desktop bar is a ≥901px tier */
  .s-cta {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 64px; /* above mobile contact bar */
    z-index: 38;
    background: rgba(255,255,255,0.96);
    backdrop-filter: blur(18px) saturate(160%);
    border-top: 1px solid var(--line);
    box-shadow: 0 -8px 32px rgba(16, 46, 41, 0.12);
    transform: translateY(0);
    transition: transform 0.38s cubic-bezier(0.22, 0.61, 0.36, 1), opacity 0.28s ease;
  }
  .s-cta[hidden] {
    display: block !important;
    transform: translateY(110%);
    opacity: 0;
    pointer-events: none;
  }
  .s-cta.is-hidden {
    transform: translateY(110%);
  }
  .s-cta__in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 10px;
    padding-inline: 14px;
    min-height: 56px;
  }
  .s-cta__txt {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .s-cta__title {
    font-family: var(--f-display);
    font-size: 13px;
    font-weight: 650;
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* the sub-line drops out on the smallest phones; it returns at ≥481px */
  .s-cta__sub {
    font-size: 11px;
    color: var(--ink-60);
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: none;
  }
  .s-cta__actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: none;
  }
  .s-cta__btn {
    min-height: 36px;
    padding: 0 14px;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
  }
  .s-cta__messengers {
    display: none;
    gap: 6px;
  }
  .s-cta__m {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    background: #eef4ff;
    color: #229ED9;
    text-decoration: none;
    border: 1px solid #dbeafe;
    transition: all var(--tr);
  }
  .s-cta__m--wa {
    background: #e8f8ee;
    color: #25D366;
    border-color: #c6f0d2;
  }
  .s-cta__m:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-soft);
  }
  .s-cta__close {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: #fff;
    color: var(--ink-40);
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .s-cta__close:hover {
    color: var(--ink);
    border-color: var(--ink-40);
  }

  @media (min-width: 481px) {
    .s-cta__sub {
      display: block;
    }
  }
  @media (min-width: 901px) {
    .s-cta {
      bottom: 0;
    }
    .s-cta__in {
      /* back to the .wrap gutter (the mobile tier used a fixed 14px) */
      padding-inline: var(--gutter);
      min-height: 64px;
    }
    .s-cta__title {
      font-size: 15px;
    }
    .s-cta__sub {
      font-size: 12px;
    }
    .s-cta__btn {
      padding: 0 18px;
      font-size: 13px;
      min-height: 40px;
    }
    .s-cta__messengers {
      display: flex;
    }
  }
</style>

<script>
  /* NOTE: must stay a plain <script> (no is:inline / no translate="no"): Astro then
     transpiles this TypeScript and bundles it as a deferred module. Extra attributes
     make Astro emit it raw, which breaks in every browser. The i18n build pass
     rewrites only the known UI strings inside it (scripts/localization.mjs). */
  (() => {
    const bar = document.getElementById('sticky-cta');
    if (!bar) return;
    const closeBtn = bar.querySelector('.s-cta__close') as HTMLButtonElement;
    const SHOW_AFTER = 420;
    const STORAGE_KEY = 'sofexpo.sticky.dismissed';
    const PAGE_TYPE = bar.dataset.pageType || 'other';

    // Don't show if dismissed recently (session)
    try {
      const dismissed = sessionStorage.getItem(STORAGE_KEY);
      if (dismissed && Date.now() - parseInt(dismissed, 10) < 1000 * 60 * 30) return; // 30 min
    } catch {}

    let shown = false;
    const show = () => {
      if (shown) return;
      bar.hidden = false;
      requestAnimationFrame(() => {
        bar.classList.remove('is-hidden');
      });
      shown = true;
      try { (window as any).sofTrack?.('cta_show', { type: 'sticky-bar', pageType: PAGE_TYPE }); } catch {}
    };
    const hide = (permanent = false) => {
      bar.classList.add('is-hidden');
      setTimeout(() => { bar.hidden = true; }, 380);
      if (permanent) {
        try { sessionStorage.setItem(STORAGE_KEY, String(Date.now())); } catch {}
      }
    };

    // Show after scroll threshold
    const onScroll = () => {
      if (window.scrollY > SHOW_AFTER && !shown) show();
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    // also check after 3s if already scrolled a bit
    setTimeout(() => {
      if (window.scrollY > 100) show();
    }, 3000);

    // Hide when form in viewport (avoid double CTA)
    const forms = document.querySelectorAll('form[data-lead-form], .form-wrap');
    if (forms.length) {
      const io = new IntersectionObserver((entries) => {
        const anyVisible = entries.some(e => e.isIntersecting && e.intersectionRatio > 0.3);
        if (anyVisible && shown) bar.classList.add('is-hidden');
        else if (!anyVisible && shown) bar.classList.remove('is-hidden');
      }, { threshold: [0.3] });
      forms.forEach(f => io.observe(f));
    }

    closeBtn?.addEventListener('click', () => hide(true));

    // track clicks
    bar.querySelectorAll('[data-cta], [data-channel]').forEach(el => {
      el.addEventListener('click', () => {
        const cta = (el as HTMLElement).dataset.cta || (el as HTMLElement).dataset.channel;
        try { (window as any).sofTrack?.('cta_click', { cta, source: 'sticky-bar', pageType: PAGE_TYPE }); } catch {}
      });
    });

    // Hide on mobile contact bar hidden? Keep above
    const mobBar = document.getElementById('fc-mob');
    if (mobBar) {
      const mo = new MutationObserver(() => {
        if (mobBar.classList.contains('is-hidden')) {
          (bar as HTMLElement).style.bottom = '0';
        } else {
          (bar as HTMLElement).style.bottom = window.innerWidth <= 900 ? '64px' : '0';
        }
      });
      mo.observe(mobBar, { attributes: true, attributeFilter: ['class'] });
    }
  })();
</script>
