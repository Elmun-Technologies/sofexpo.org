---
/**
 * ExhibitorForm — individual form for stand booking
 * Different from generic LeadForm: has industry, area, budget, urgency
 */
import type { SourceLocale as Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
  eventName?: string;
  compact?: boolean;
  id?: string;
  source?: string;
}

const { locale, eventName = '', compact = false, id = 'exhibitor-form', source = 'exhibitor' } = Astro.props as Props;
const ru = locale === 'ru';
const endpoint = (import.meta.env.PUBLIC_LEAD_ENDPOINT ?? '').trim();

const L = {
  title: ru ? 'Забронировать стенд' : 'Book a stand',
  sub: ru ? 'План зала + расчёт за 15 минут. Без оплаты сейчас.' : 'Floor plan + quote in 15 min. No payment now.',
  name: ru ? 'Имя и фамилия' : 'Full name',
  company: ru ? 'Компания / бренд' : 'Company / brand',
  phone: ru ? 'Телефон (WhatsApp/Telegram)' : 'Phone (WhatsApp/Telegram)',
  email: 'Email',
  industry: ru ? 'Направление' : 'Industry',
  industries: ru
    ? ['Продукты и напитки', 'Стройматериалы', 'Агротехника', 'Авто и мото', 'E-commerce', 'Образование', 'Другое']
    : ['Food & beverage', 'Construction', 'Agro', 'Auto & moto', 'E-commerce', 'Education', 'Other'],
  area: ru ? 'Площадь стенда' : 'Stand area',
  areas: ['9 m²', '18 m²', '27 m²', '36 m²', '54 m²', '72 m²+', ru ? 'Не знаю, нужна консультация' : 'Not sure, need advice'],
  budget: ru ? 'Бюджет' : 'Budget',
  budgets: ru
    ? ['До $2 000', '$2 000–5 000', '$5 000–10 000', '$10 000+', 'Обсудим']
    : ['Up to $2 000', '$2 000–5 000', '$5 000–10 000', '$10 000+', "Let's discuss"],
  event: ru ? 'Выставка' : 'Exhibition',
  urgency: ru ? 'Когда планируете?' : 'When planning?',
  urgencies: ru
    ? ['В этом месяце', 'В ближайшие 3 месяца', 'Через 3–6 месяцев', 'Изучаю варианты']
    : ['This month', 'Next 3 months', 'In 3–6 months', 'Exploring'],
  comment: ru ? 'Что покажете на стенде?' : 'What will you showcase?',
  submit: ru ? 'Получить план зала и расчёт' : 'Get floor plan & quote',
  consent: ru ? 'Отправляя, вы соглашаетесь с обработкой данных. Ответим за 15 минут.' : 'By sending you agree to data processing. Reply in 15 min.',
  ok: ru ? 'Заявка принята! Менеджер пришлёт план зала и расчёт в течение 15 минут в Telegram/WhatsApp.' : 'Request received! Manager will send floor plan and quote within 15 min via Telegram/WhatsApp.',
  err: ru ? 'Заполните обязательные поля' : 'Please fill required fields',
  tg: 'Telegram',
  wa: 'WhatsApp',
  alt: ru ? 'Или напишите сразу:' : 'Or write directly:',
};

const events = [
  'FOODERA EXPO 2026',
  'BUILDPRO EXPO 2026',
  'AGROPRO EXPO 2027',
  'WORLD EDU EXPO 2027',
  'ECOM & RETAIL EXPO 2027',
  ru ? 'Не знаю, подберите' : "Don't know, please advise",
];
---

<form translate="no" class:list={['form-ex', { 'form-ex--compact': compact }]} id={id} data-lead-form data-form-type="exhibitor" data-source={source} data-endpoint={endpoint || undefined} data-ok={L.ok} data-err={L.err} novalidate>
  <div class="form-ex__head">
    <div>
      <p class="form-ex__kicker">{ru ? 'Экспонентам · от 9 м²' : 'For exhibitors · from 9 m²'}</p>
      <h3 class="form-ex__title">{L.title}</h3>
      <p class="form-ex__sub">{L.sub}</p>
    </div>
    <div class="form-ex__trust">
      <span class="form-ex__trust-item">⚡ 15 {ru ? 'мин' : 'min'}</span>
      <span class="form-ex__trust-item">📐 {ru ? 'план зала' : 'floor plan'}</span>
      <span class="form-ex__trust-item">💬 TG/WA</span>
    </div>
  </div>

  <div class="form-ex__grid">
    <div class="field">
      <label for={`${id}-name`}>{L.name} *</label>
      <input id={`${id}-name`} name="name" required autocomplete="name" placeholder={ru ? 'Алишер Алиев' : 'John Smith'} />
    </div>
    <div class="field">
      <label for={`${id}-company`}>{L.company} *</label>
      <input id={`${id}-company`} name="company" required autocomplete="organization" placeholder={ru ? 'ООО Ваш Бренд' : 'Your Brand LLC'} />
    </div>
    <div class="field">
      <label for={`${id}-phone`}>{L.phone} *</label>
      <input id={`${id}-phone`} name="phone" type="tel" required autocomplete="tel" placeholder="+998" />
    </div>
    <div class="field">
      <label for={`${id}-email`}>{L.email}</label>
      <input id={`${id}-email`} name="email" type="email" autocomplete="email" placeholder="info@company.com" />
    </div>
    <div class="field">
      <label for={`${id}-industry`}>{L.industry} *</label>
      <select id={`${id}-industry`} name="industry" required>
        <option value="">—</option>
        {L.industries.map(i => <option>{i}</option>)}
      </select>
    </div>
    <div class="field">
      <label for={`${id}-area`}>{L.area} *</label>
      <select id={`${id}-area`} name="area" required>
        <option value="">—</option>
        {L.areas.map(a => <option>{a}</option>)}
      </select>
    </div>
    <div class="field">
      <label for={`${id}-budget`}>{L.budget}</label>
      <select id={`${id}-budget`} name="budget">
        <option value="">—</option>
        {L.budgets.map(b => <option>{b}</option>)}
      </select>
    </div>
    <div class="field">
      <label for={`${id}-urgency`}>{L.urgency}</label>
      <select id={`${id}-urgency`} name="urgency">
        {L.urgencies.map(u => <option>{u}</option>)}
      </select>
    </div>
    <div class="field form-ex__full">
      <label for={`${id}-event`}>{L.event}</label>
      <select id={`${id}-event`} name="event">
        {eventName && <option selected>{eventName}</option>}
        {events.map(e => <option>{e}</option>)}
      </select>
    </div>
    <div class="field form-ex__full">
      <label for={`${id}-comment`}>{L.comment}</label>
      <textarea id={`${id}-comment`} name="comment" rows={compact ? 2 : 3} placeholder={ru ? 'Например: оборудование для пекарен, хотим 18 м² у входа' : 'E.g.: bakery equipment, want 18 m² near entrance'}></textarea>
    </div>
  </div>

  <label class="form-ex__consent">
    <input type="checkbox" name="consent" required />
    <span>{L.consent}</span>
  </label>

  <div class="form-ex__actions">
    <button class="btn btn--gold form-ex__submit" type="submit">
      <span>{L.submit}</span>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </button>
    <div class="form-ex__alt">
      <span>{L.alt}</span>
      <a href="https://t.me/sofexpomgr" target="_blank" rel="noopener" data-channel="telegram" data-form="exhibitor">Telegram</a>
      <a href="https://wa.me/998557050705" target="_blank" rel="noopener" data-channel="whatsapp" data-form="exhibitor">WhatsApp</a>
    </div>
  </div>

  <p class="form__msg" role="status" aria-live="polite" hidden></p>
</form>

<style>
  .form-ex {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: clamp(18px, 2vw, 28px);
    display: grid;
    gap: 18px;
    box-shadow: var(--shadow);
    border-top: 3px solid var(--gold);
  }
  .form-ex--compact {
    padding: 16px;
    gap: 14px;
  }
  .form-ex__head {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: flex-start;
    flex-wrap: wrap;
  }
  .form-ex__kicker {
    margin: 0 0 6px;
    font-family: var(--f-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--moss);
    font-weight: 600;
  }
  .form-ex__title {
    margin: 0 0 6px;
    font-size: clamp(18px, 2.2vw, 22px);
    letter-spacing: -0.02em;
  }
  .form-ex__sub {
    margin: 0;
    font-size: 13px;
    color: var(--ink-60);
    line-height: 1.45;
    max-width: 36ch;
  }
  .form-ex__trust {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .form-ex__trust-item {
    padding: 4px 8px;
    border-radius: 20px;
    background: var(--cream-2);
    font-size: 11px;
    font-weight: 600;
    color: var(--ink-60);
    border: 1px solid var(--line);
  }
  .form-ex__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .form-ex__full {
    grid-column: 1 / -1;
  }
  .form-ex__consent {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    font-size: 11px;
    color: var(--ink-40);
    line-height: 1.4;
  }
  .form-ex__consent input {
    margin-top: 2px;
    width: 16px;
    height: 16px;
    flex: none;
    accent-color: var(--evergreen);
  }
  .form-ex__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }
  .form-ex__submit {
    min-width: 260px;
    justify-content: space-between;
    padding: 14px 20px;
    font-size: 14px;
    font-weight: 700;
  }
  .form-ex__alt {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--ink-40);
  }
  .form-ex__alt a {
    font-weight: 600;
    color: var(--evergreen);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .form-ex__alt a:hover {
    border-color: var(--evergreen);
  }
  @media (max-width: 640px) {
    .form-ex__grid {
      grid-template-columns: 1fr;
    }
    .form-ex__submit {
      width: 100%;
      min-width: 0;
    }
  }
</style>
