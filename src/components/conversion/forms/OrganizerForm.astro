---
/**
 * OrganizerForm — for venue rental / own event hosting
 * B2B, larger budgets, date-focused
 */
import type { SourceLocale as Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
  id?: string;
}

const { locale, id = 'organizer-form' } = Astro.props as Props;
const ru = locale === 'ru';
const endpoint = (import.meta.env.PUBLIC_LEAD_ENDPOINT ?? '').trim();

const L = {
  title: ru ? 'Провести событие в SOF EXPO' : 'Host event at SOF EXPO',
  sub: ru ? '4400 м² зал + 5000 м² улица. Ответ с расчётом за 2 часа.' : '4400 m² hall + 5000 m² outdoor. Quote in 2 hours.',
  name: ru ? 'Имя' : 'Name',
  company: ru ? 'Компания / организатор' : 'Company / organizer',
  phone: ru ? 'Телефон' : 'Phone',
  email: 'Email',
  eventType: ru ? 'Формат события' : 'Event format',
  types: ru ? ['Выставка', 'Конференция', 'Форум', 'Концерт / фестиваль', 'Ярмарка', 'Корпоратив', 'Другое'] : ['Exhibition', 'Conference', 'Forum', 'Concert / festival', 'Fair', 'Corporate', 'Other'],
  date: ru ? 'Желаемые даты' : 'Preferred dates',
  attendees: ru ? 'Кол-во участников' : 'Attendees',
  attendeesOpts: ['50–100', '100–300', '300–700', '700–1500', '1500+'],
  area: ru ? 'Нужная площадь' : 'Area needed',
  areas: ['500 m²', '1000 m²', '2000 m²', '4400 m²', '4400+5000 m²', ru ? 'Обсудим' : "Let's discuss"],
  comment: ru ? 'Опишите событие' : 'Describe event',
  submit: ru ? 'Получить расчёт аренды' : 'Get rental quote',
  consent: ru ? 'Согласен на обработку данных. Коммерческое предложение за 2 часа.' : 'Agree to data processing. Proposal in 2 hours.',
  ok: ru ? 'Заявка принята! Пришлём тех. спецификацию, фото и расчёт за 2 часа.' : 'Request received! We’ll send tech specs, photos and quote in 2 hours.',
  err: ru ? 'Заполните обязательные поля' : 'Please fill required fields',
};
---

<form translate="no" class="form-org" id={id} data-lead-form data-form-type="organizer" data-endpoint={endpoint || undefined} data-ok={L.ok} data-err={L.err} novalidate>
  <div class="form-org__head">
    <div>
      <p class="form-org__kicker">{ru ? 'Организаторам · 4400 м² + 5000 м²' : 'For organizers · 4400 m² + 5000 m²'}</p>
      <h3>{L.title}</h3>
      <p class="form-org__sub">{L.sub}</p>
    </div>
    <div class="form-org__specs">
      <div><b>4400</b><span>m² {ru ? 'зал' : 'hall'}</span></div>
      <div><b>5000</b><span>m² outdoor</span></div>
      <div><b>700</b><span>kW</span></div>
    </div>
  </div>

  <div class="form-org__grid">
    <div class="field"><label>{L.name} *</label><input name="name" required autocomplete="name" /></div>
    <div class="field"><label>{L.company} *</label><input name="company" required autocomplete="organization" /></div>
    <div class="field"><label>{L.phone} *</label><input name="phone" type="tel" required autocomplete="tel" placeholder="+998" /></div>
    <div class="field"><label>{L.email} *</label><input name="email" type="email" required autocomplete="email" /></div>
    <div class="field"><label>{L.eventType} *</label><select name="eventType" required><option value="">—</option>{L.types.map(t => <option>{t}</option>)}</select></div>
    <div class="field"><label>{L.date}</label><input name="date" type="text" placeholder={ru ? 'Напр. 15–17 мая 2027' : 'E.g. 15–17 May 2027'} /></div>
    <div class="field"><label>{L.attendees}</label><select name="attendees"><option value="">—</option>{L.attendeesOpts.map(o => <option>{o}</option>)}</select></div>
    <div class="field"><label>{L.area}</label><select name="area"><option value="">—</option>{L.areas.map(a => <option>{a}</option>)}</select></div>
    <div class="field form-org__full"><label>{L.comment}</label><textarea name="comment" rows="3" placeholder={ru ? 'Формат, техника, сцена, кейтеринг...' : 'Format, tech, stage, catering...'}></textarea></div>
  </div>

  <label class="form-org__consent"><input type="checkbox" name="consent" required /><span>{L.consent}</span></label>
  <button class="btn btn--gold form-org__submit" type="submit">{L.submit}</button>
  <p class="form__msg" role="status" aria-live="polite" hidden></p>
</form>

<style>
  .form-org {
    background: var(--evergreen);
    color: rgba(255,255,255,0.9);
    border-radius: 16px;
    padding: 22px;
    display: grid;
    gap: 16px;
    box-shadow: var(--shadow-lift);
    position: relative;
    overflow: hidden;
  }
  .form-org::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(60% 120% at 85% 0%, rgba(29,122,72,0.35), transparent 62%);
    pointer-events: none;
  }
  .form-org > * { position: relative; z-index: 1; }
  .form-org__kicker {
    margin: 0 0 6px;
    font-family: var(--f-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold-soft);
  }
  .form-org__head {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .form-org__head h3 {
    margin: 0 0 6px;
    color: #fff;
    font-size: 20px;
  }
  .form-org__sub {
    margin: 0;
    font-size: 13px;
    color: rgba(255,255,255,0.72);
    max-width: 36ch;
    line-height: 1.45;
  }
  .form-org__specs {
    display: flex;
    gap: 12px;
  }
  .form-org__specs div {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 56px;
    padding: 8px 10px;
    border-radius: 10px;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.14);
  }
  .form-org__specs b {
    font-family: var(--f-display);
    font-size: 18px;
    color: #fff;
    line-height: 1;
  }
  .form-org__specs span {
    font-family: var(--f-mono);
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgba(255,255,255,0.6);
    margin-top: 2px;
  }
  .form-org__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .form-org__full { grid-column: 1 / -1; }
  .form-org :global(.field label) {
    color: rgba(255,255,255,0.72);
  }
  .form-org :global(.field input),
  .form-org :global(.field select),
  .form-org :global(.field textarea) {
    background: rgba(255,255,255,0.08);
    border-color: rgba(255,255,255,0.18);
    color: #fff;
  }
  .form-org :global(.field input::placeholder),
  .form-org :global(.field textarea::placeholder) {
    color: rgba(255,255,255,0.4);
  }
  .form-org :global(.field input:focus),
  .form-org :global(.field select:focus),
  .form-org :global(.field textarea:focus) {
    background: rgba(255,255,255,0.12);
    border-color: var(--gold-soft);
    box-shadow: 0 0 0 3px rgba(231,213,174,0.18);
  }
  .form-org__consent {
    display: flex;
    gap: 8px;
    font-size: 11px;
    color: rgba(255,255,255,0.55);
    line-height: 1.4;
  }
  .form-org__consent input {
    width: 16px;
    height: 16px;
    flex: none;
    accent-color: var(--gold);
  }
  .form-org__submit {
    background: #fff;
    color: var(--evergreen);
    font-weight: 700;
    width: 100%;
    padding: 13px;
  }
  .form-org__submit:hover {
    background: var(--gold-soft);
  }
  @media (max-width: 600px) {
    .form-org__grid { grid-template-columns: 1fr; }
    .form-org__specs { width: 100%; justify-content: space-between; }
  }
</style>
