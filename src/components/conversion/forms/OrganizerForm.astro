---
/**
 * OrganizerForm — for venue rental / own event hosting
 * B2B, larger budgets, date-focused
 */
import type { SourceLocale as Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
  id?: string;
}

const { locale, id = 'organizer-form' } = Astro.props as Props;
const ru = locale === 'ru';
const endpoint = (import.meta.env.PUBLIC_LEAD_ENDPOINT ?? '').trim();

const L = {
  title: ru ? 'Провести событие в SOF EXPO' : 'Host event at SOF EXPO',
  sub: ru ? '4400 м² зал + 5000 м² улица. Ответ с расчётом в течение рабочего дня.' : '4400 m² hall + 5000 m² outdoor. Quote within one business day.',
  name: ru ? 'Имя' : 'Name',
  company: ru ? 'Компания / организатор' : 'Company / organizer',
  phone: ru ? 'Телефон' : 'Phone',
  email: 'Email',
  eventType: ru ? 'Формат события' : 'Event format',
  types: ru ? ['Выставка', 'Конференция', 'Форум', 'Концерт / фестиваль', 'Ярмарка', 'Корпоратив', 'Другое'] : ['Exhibition', 'Conference', 'Forum', 'Concert / festival', 'Fair', 'Corporate', 'Other'],
  date: ru ? 'Желаемые даты' : 'Preferred dates',
  attendees: ru ? 'Кол-во участников' : 'Attendees',
  attendeesOpts: ['50–100', '100–300', '300–700', '700–1500', '1500+'],
  area: ru ? 'Нужная площадь' : 'Area needed',
  areas: ['500 m²', '1000 m²', '2000 m²', '4400 m²', '4400+5000 m²', ru ? 'Обсудим' : "Let's discuss"],
  comment: ru ? 'Опишите событие' : 'Describe event',
  submit: ru ? 'Получить расчёт аренды' : 'Get rental quote',
  consent: ru ? 'Согласен на обработку данных. Коммерческое предложение — в течение рабочего дня.' : 'I agree to data processing. Proposal within one business day.',
  ok: ru ? 'Заявка принята! Пришлём тех. спецификацию, фото и расчёт в течение рабочего дня.' : 'Request received! We will send tech specs, photos and a quote within one business day.',
  err: ru ? 'Заполните обязательные поля' : 'Please fill required fields',
};
---

<form class="form-org" id={id} data-lead-form data-fallback={ru ? 'Мы получили ваш контакт только в этом браузере — отправьте заявку также на почту.' : 'Your request was kept in this browser only — please also send it by email.'} data-form-type="organizer" data-endpoint={endpoint || undefined} data-ok={L.ok} data-err={L.err} novalidate>
  <div class="form-org__head">
    <div>
      <p class="form-org__kicker">{ru ? 'Организаторам · 4400 м² + 5000 м²' : 'For organizers · 4400 m² + 5000 m²'}</p>
      <h3>{L.title}</h3>
      <p class="form-org__sub">{L.sub}</p>
    </div>
    <div class="form-org__specs">
      <div><b>4400</b><span>m² {ru ? 'зал' : 'hall'}</span></div>
      <div><b>5000</b><span>m² outdoor</span></div>
      <div><b>700</b><span>kW</span></div>
    </div>
  </div>

  <div class="form-org__grid">
    <div class="field"><label for={`${id}-name`}>{L.name} *</label><input id={`${id}-name`} name="name" required autocomplete="name" /></div>
    <div class="field"><label for={`${id}-company`}>{L.company} *</label><input id={`${id}-company`} name="company" required autocomplete="organization" /></div>
    <div class="field"><label for={`${id}-phone`}>{L.phone} *</label><input id={`${id}-phone`} name="phone" type="tel" required autocomplete="tel" placeholder="+998" /></div>
    <div class="field"><label for={`${id}-email`}>{L.email} *</label><input id={`${id}-email`} name="email" type="email" required autocomplete="email" /></div>
    <div class="field"><label for={`${id}-eventType`}>{L.eventType} *</label><select id={`${id}-eventType`} name="eventType" required><option value="">—</option>{L.types.map(t => <option>{t}</option>)}</select></div>
    <div class="field"><label for={`${id}-date`}>{L.date}</label><input id={`${id}-date`} name="date" type="text" placeholder={ru ? 'Напр. 15–17 мая 2027' : 'E.g. 15–17 May 2027'} /></div>
    <div class="field"><label for={`${id}-attendees`}>{L.attendees}</label><select id={`${id}-attendees`} name="attendees"><option value="">—</option>{L.attendeesOpts.map(o => <option>{o}</option>)}</select></div>
    <div class="field"><label for={`${id}-area`}>{L.area}</label><select id={`${id}-area`} name="area"><option value="">—</option>{L.areas.map(a => <option>{a}</option>)}</select></div>
    <div class="field form-org__full"><label for={`${id}-comment`}>{L.comment}</label><textarea id={`${id}-comment`} name="comment" rows="3" placeholder={ru ? 'Формат, техника, сцена, кейтеринг...' : 'Format, tech, stage, catering...'}></textarea></div>
  </div>

  <label class="form-org__consent"><input type="checkbox" name="consent" required /><span>{L.consent}</span></label>
  <button class="btn btn--gold form-org__submit" type="submit">{L.submit}</button>
  <p class="form__msg" role="status" aria-live="polite" hidden></p>
</form>

<style>
  /* 2026-10-13: light, like every other form on a white block panel. It used to be a dark card
     with white labels; the redesign drops the card background of embedded forms, which left
     white text on white (docs/18 §14). */
  .form-org {
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: var(--r-lg, 24px);
    padding: 24px;
    display: grid;
    gap: 18px;
  }
  .form-org__kicker {
    margin: 0 0 6px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--ink-60);
  }
  .form-org__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    flex-wrap: wrap;
  }
  .form-org__head h3 {
    margin: 0 0 6px;
    font-family: var(--f-display);
    font-weight: 500;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .form-org__sub {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--ink-60);
    max-width: 42ch;
    line-height: 1.45;
  }
  .form-org__specs {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .form-org__specs div {
    display: flex;
    flex-direction: column;
    min-width: 84px;
    padding: 10px 14px;
    border-radius: 16px;
    background: var(--cream-2, #f3f3f3);
  }
  .form-org__specs b {
    font-family: var(--f-display);
    font-weight: 500;
    font-size: 1.375rem;
    color: var(--ink);
    line-height: 1;
  }
  .form-org__specs span {
    font-size: 0.75rem;
    color: var(--ink-60);
    margin-top: 4px;
  }
  .form-org__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }
  .form-org__full { grid-column: 1 / -1; }
  .form-org__consent {
    display: flex;
    gap: 10px;
    font-size: 0.8125rem;
    color: var(--ink-60);
    line-height: 1.4;
  }
  .form-org__consent input {
    width: 18px;
    height: 18px;
    flex: none;
    accent-color: var(--ink);
  }
  .form-org__submit {
    justify-self: start;
    min-width: 240px;
  }
  @media (min-width: 600px) {
    .form-org__grid { grid-template-columns: 1fr 1fr; }
  }
</style>
