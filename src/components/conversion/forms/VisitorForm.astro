---
/**
 * VisitorForm — ticket / visitor registration, distinct from exhibitor
 * Light, fast, QR-focused
 */
import type { SourceLocale as Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
  eventName?: string;
  id?: string;
}

const { locale, eventName = '', id = 'visitor-form' } = Astro.props as Props;
const ru = locale === 'ru';
const endpoint = (import.meta.env.PUBLIC_LEAD_ENDPOINT ?? '').trim();

const L = {
  title: ru ? 'Получить бесплатный билет' : 'Get free ticket',
  sub: ru ? 'Для профильных специалистов. Билет придёт на почту после подтверждения регистрации.' : 'For trade visitors. Your ticket is emailed once the registration is confirmed.',
  name: ru ? 'Имя и фамилия' : 'Full name',
  company: ru ? 'Компания' : 'Company',
  position: ru ? 'Должность' : 'Position',
  positions: ru ? ['Руководитель', 'Закупщик', 'Технолог', 'Маркетолог', 'Дистрибьютор', 'Другое'] : ['Owner/CEO', 'Buyer', 'Technologist', 'Marketing', 'Distributor', 'Other'],
  phone: ru ? 'Телефон' : 'Phone',
  email: 'Email',
  industry: ru ? 'Отрасль' : 'Industry',
  industries: ru ? ['Продукты', 'Стройка', 'Агро', 'Авто', 'E-commerce', 'Образование', 'Другое'] : ['Food', 'Build', 'Agro', 'Auto', 'E-commerce', 'Education', 'Other'],
  purpose: ru ? 'Цель визита' : 'Visit purpose',
  purposes: ru ? ['Закупки', 'Поиск поставщиков', 'Партнёрства', 'Изучение рынка', 'Деловая программа'] : ['Purchasing', 'Find suppliers', 'Partnerships', 'Market research', 'Business program'],
  event: ru ? 'Выставка' : 'Exhibition',
  submit: ru ? 'Получить билет' : 'Get ticket',
  consent: ru ? 'Согласен на обработку данных. Билет придёт на email.' : 'I agree to data processing. Ticket to email.',
  ok: ru ? 'Регистрация принята! Билет придёт на почту после подтверждения. До встречи в SOF EXPO!' : 'Registration received! Your ticket is emailed once it is confirmed. See you at SOF EXPO!',
  err: ru ? 'Заполните имя, телефон и email' : 'Please fill name, phone, email',
};
---

<form class="form-vi" id={id} data-lead-form data-fallback={ru ? 'Мы получили ваш контакт только в этом браузере — отправьте заявку также на почту.' : 'Your request was kept in this browser only — please also send it by email.'} data-form-type="visitor" data-endpoint={endpoint || undefined} data-ok={L.ok} data-err={L.err} novalidate>
  <div class="form-vi__head">
    <div class="form-vi__icon">🎟️</div>
    <div>
      <h3>{L.title}</h3>
      <p>{L.sub}</p>
    </div>
  </div>

  <div class="form-vi__grid">
    <div class="field">
      <label for={`${id}-name`}>{L.name} *</label>
      <input id={`${id}-name`} name="name" required autocomplete="name" placeholder={ru ? 'Алишер Алиев' : 'John Smith'} />
    </div>
    <div class="field">
      <label for={`${id}-company`}>{L.company}</label>
      <input id={`${id}-company`} name="company" autocomplete="organization" placeholder={ru ? 'ООО Компания' : 'Company LLC'} />
    </div>
    <div class="field">
      <label for={`${id}-position`}>{L.position}</label>
      <select id={`${id}-position`} name="position">
        <option value="">—</option>
        {L.positions.map(p => <option>{p}</option>)}
      </select>
    </div>
    <div class="field">
      <label for={`${id}-phone`}>{L.phone} *</label>
      <input id={`${id}-phone`} name="phone" type="tel" required autocomplete="tel" placeholder="+998" />
    </div>
    <div class="field form-vi__full">
      <label for={`${id}-email`}>{L.email} *</label>
      <input id={`${id}-email`} name="email" type="email" required autocomplete="email" placeholder="you@company.com" />
    </div>
    <div class="field">
      <label for={`${id}-industry`}>{L.industry} *</label>
      <select id={`${id}-industry`} name="industry" required>
        <option value="">—</option>
        {L.industries.map(i => <option>{i}</option>)}
      </select>
    </div>
    <div class="field">
      <label for={`${id}-purpose`}>{L.purpose}</label>
      <select id={`${id}-purpose`} name="purpose">
        <option value="">—</option>
        {L.purposes.map(p => <option>{p}</option>)}
      </select>
    </div>
    {eventName && (
      <div class="field form-vi__full">
        <label for={`${id}-event`}>{L.event}</label>
        <input id={`${id}-event`} name="event" value={eventName} readonly />
      </div>
    )}
  </div>

  <label class="form-vi__consent">
    <input type="checkbox" name="consent" required />
    <span>{L.consent}</span>
  </label>

  <button class="btn btn--gold form-vi__submit" type="submit">{L.submit}</button>
  <p class="form-vi__note">{ru ? 'Бесплатно · билет на почту · без очереди на регистрацию' : 'Free · ticket by email · no registration queue'}</p>
  <p class="form__msg" role="status" aria-live="polite" hidden></p>
</form>

<style>
  .form-vi {
    background: linear-gradient(180deg, #ffffff 0%, #f8faf8 100%);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 20px;
    display: grid;
    gap: 16px;
    box-shadow: var(--shadow);
    position: relative;
    overflow: hidden;
  }
  .form-vi::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--moss), var(--gold));
  }
  .form-vi__head {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .form-vi__icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--cream-2);
    display: grid;
    place-items: center;
    font-size: 22px;
    flex: none;
  }
  .form-vi__head h3 {
    margin: 0 0 4px;
    font-size: 18px;
  }
  .form-vi__head p {
    margin: 0;
    font-size: 12px;
    color: var(--ink-60);
    line-height: 1.4;
  }
  .form-vi__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
  }
  .form-vi__full {
    grid-column: 1 / -1;
  }
  .form-vi__consent {
    display: flex;
    gap: 8px;
    font-size: 11px;
    color: var(--ink-40);
    line-height: 1.4;
  }
  .form-vi__consent input {
    width: 16px;
    height: 16px;
    flex: none;
    margin-top: 1px;
    accent-color: var(--evergreen);
  }
  .form-vi__submit {
    width: 100%;
    padding: 12px;
    font-weight: 700;
  }
  .form-vi__note {
    margin: 0;
    text-align: center;
    font-family: var(--f-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-40);
  }
  @media (min-width: 560px) {
    .form-vi__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
