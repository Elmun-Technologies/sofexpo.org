---
/**
 * VisitorForm — free ticket / visitor registration.
 * Kept to what a ticket needs: who you are, how to reach you, which show. A guest may
 * come on their own (a student, a private buyer, a family business owner without a
 * registered company), so the company is optional and only asked of those who come
 * from one. Position, industry and visit purpose are no longer asked: the show answers
 * the industry, and the sales team qualifies a visitor later, not at the door.
 */
import type { SourceLocale as Locale } from '@/i18n/config';
import { upcoming } from '@/data/events';

interface Props {
  locale: Locale;
  eventName?: string;
  id?: string;
}

const { locale, eventName = '', id = 'visitor-form' } = Astro.props as Props;
const ru = locale === 'ru';
const endpoint = (import.meta.env.PUBLIC_LEAD_ENDPOINT ?? '').trim();
const shows = upcoming.filter((e, i, all) => all.findIndex((x) => x.slug === e.slug) === i);

const L = {
  title: ru ? 'Получить бесплатный билет' : 'Get free ticket',
  sub: ru ? 'Билет придёт на почту после подтверждения регистрации.' : 'Your ticket is emailed once the registration is confirmed.',
  name: ru ? 'Имя и фамилия' : 'Full name',
  company: ru ? 'Компания' : 'Company',
  optional: ru ? 'необязательно' : 'optional',
  phone: ru ? 'Телефон' : 'Phone',
  email: 'Email',
  as: ru ? 'Я приду' : 'I am visiting',
  asCompany: ru ? 'От компании' : 'From a company',
  asPrivate: ru ? 'Сам по себе' : 'On my own',
  event: ru ? 'Выставка' : 'Exhibition',
  anyShow: ru ? 'Ещё не решил' : 'Not decided yet',
  submit: ru ? 'Получить билет' : 'Get ticket',
  consent: ru ? 'Согласен на обработку данных. Билет придёт на email.' : 'I agree to data processing. Ticket to email.',
  ok: ru ? 'Регистрация принята! Билет придёт на почту после подтверждения. До встречи в SOF EXPO!' : 'Registration received! Your ticket is emailed once it is confirmed. See you at SOF EXPO!',
  err: ru ? 'Заполните имя, телефон и email' : 'Please fill name, phone, email',
};
---

<form class="form-vi" id={id} data-lead-form data-fallback={ru ? 'Мы получили ваш контакт только в этом браузере — отправьте заявку также на почту.' : 'Your request was kept in this browser only — please also send it by email.'} data-form-type="visitor" data-endpoint={endpoint || undefined} data-ok={L.ok} data-err={L.err} novalidate>
  <div class="form-vi__head">
    <div class="form-vi__icon" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><path d="M3 8a2 2 0 0 0 2-2h14a2 2 0 0 0 2 2v2a2 2 0 0 0 0 4v2a2 2 0 0 0-2 2H5a2 2 0 0 0-2-2v-2a2 2 0 0 0 0-4Z" /><path d="M14 6v12" stroke-dasharray="2 2" /></svg>
    </div>
    <div>
      <h3>{L.title}</h3>
      <p>{L.sub}</p>
    </div>
  </div>

  <div class="form-vi__grid">
    <div class="field form-vi__full">
      <label for={`${id}-name`}>{L.name} *</label>
      <input id={`${id}-name`} name="name" required autocomplete="name" placeholder={ru ? 'Алишер Алиев' : 'John Smith'} />
    </div>
    <div class="field">
      <label for={`${id}-phone`}>{L.phone} *</label>
      <input id={`${id}-phone`} name="phone" type="tel" required autocomplete="tel" inputmode="tel" placeholder="+998" />
    </div>
    <div class="field">
      <label for={`${id}-email`}>{L.email} *</label>
      <input id={`${id}-email`} name="email" type="email" required autocomplete="email" inputmode="email" placeholder="you@mail.com" />
    </div>
    {eventName ? (
      <input type="hidden" name="event" value={eventName} />
    ) : (
      <div class="field form-vi__full">
        <label for={`${id}-event`}>{L.event}</label>
        <select id={`${id}-event`} name="event">
          <option value="">{L.anyShow}</option>
          {shows.map((e) => <option value={e.brand.en} translate="no">{e.brand.en}</option>)}
        </select>
      </div>
    )}
    <fieldset class="form-vi__as form-vi__full">
      <legend>{L.as}</legend>
      <label><input type="radio" name="visitorType" value="company" checked data-vi-as /><span>{L.asCompany}</span></label>
      <label><input type="radio" name="visitorType" value="private" data-vi-as /><span>{L.asPrivate}</span></label>
    </fieldset>
    <div class="field form-vi__full" data-vi-company>
      <label for={`${id}-company`}>{L.company} <small class="form-vi__opt">{L.optional}</small></label>
      <input id={`${id}-company`} name="company" autocomplete="organization" placeholder={ru ? 'ООО Компания' : 'Company LLC'} />
    </div>
  </div>

  <label class="form-vi__consent">
    <input type="checkbox" name="consent" required />
    <span>{L.consent}</span>
  </label>

  <button class="btn btn--gold form-vi__submit" type="submit">{L.submit}</button>
  <p class="form-vi__note">{ru ? 'Бесплатно · билет на почту · без очереди на регистрацию' : 'Free · ticket by email · no registration queue'}</p>
  <p class="form__msg" role="status" aria-live="polite" hidden></p>
</form>

<script>
  /* "On my own" hides (and clears) the company field — nobody is asked for a company they do not have */
  document.querySelectorAll<HTMLFormElement>('.form-vi').forEach((form) => {
    const box = form.querySelector<HTMLElement>('[data-vi-company]');
    const input = box?.querySelector('input');
    const sync = () => {
      const priv = form.querySelector<HTMLInputElement>('[data-vi-as]:checked')?.value === 'private';
      if (!box || !input) return;
      box.hidden = priv;
      input.disabled = priv;
      if (priv) input.value = '';
    };
    form.querySelectorAll('[data-vi-as]').forEach((radio) => radio.addEventListener('change', sync));
    form.addEventListener('reset', () => setTimeout(sync));
    sync();
  });
</script>

<style>
  .form-vi {
    background: linear-gradient(180deg, #ffffff 0%, var(--cream-2) 100%);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 20px;
    display: grid;
    gap: 16px;
    box-shadow: var(--shadow);
    position: relative;
    overflow: hidden;
  }
  .form-vi::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--moss), var(--gold));
  }
  .form-vi__head {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .form-vi__icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--cream-2);
    color: var(--evergreen);
    display: grid;
    place-items: center;
    flex: none;
  }
  .form-vi__head h3 {
    margin: 0 0 4px;
    font-size: 18px;
  }
  .form-vi__head p {
    margin: 0;
    font-size: 12px;
    color: var(--ink-60);
    line-height: 1.4;
  }
  .form-vi__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
  }
  .form-vi__full {
    grid-column: 1 / -1;
  }
  .form-vi__opt {
    margin-left: 4px;
    font-weight: 400;
    color: var(--ink-60);
  }
  .form-vi__opt::before {
    content: '· ';
  }
  .form-vi__as {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .form-vi__as legend {
    width: 100%;
    margin-bottom: 6px;
    padding: 0;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink);
  }
  .form-vi__as label {
    position: relative;
    flex: 1 1 140px;
    cursor: pointer;
  }
  .form-vi__as input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }
  .form-vi__as span {
    height: 100%;
    display: grid;
    place-items: center;
    padding: 10px 12px;
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    background: #fff;
    text-align: center;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink-60);
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .form-vi__as input:checked + span {
    border-color: var(--evergreen);
    background: var(--accent-soft);
    color: var(--evergreen);
    box-shadow: inset 0 0 0 1px var(--evergreen);
  }
  .form-vi__as input:focus-visible + span {
    box-shadow: var(--focus-ring);
  }
  .form-vi__consent {
    display: flex;
    gap: 8px;
    font-size: 12px;
    color: var(--ink-60);
    line-height: 1.4;
  }
  .form-vi__consent input {
    width: 16px;
    height: 16px;
    flex: none;
    margin-top: 1px;
    accent-color: var(--evergreen);
  }
  .form-vi__submit {
    width: 100%;
    padding: 12px;
    font-weight: 700;
  }
  .form-vi__note {
    margin: 0;
    text-align: center;
    font-family: var(--f-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-40);
  }
  @media (min-width: 560px) {
    .form-vi__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
