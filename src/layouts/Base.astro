---
import '@/styles/fonts.css';
import '@/styles/global.css';
import '@/styles/premium.css';
import '@/styles/motion.css';
import '@/styles/redesign.css';
/* type: Manrope (display) + Onest (body), self-hosted — src/styles/fonts.css */
import { buildMeta, entityNodes, SITE } from '@/lib/seo';
import { localize, localeMeta, type SourceLocale as Locale } from '@/i18n/config';
import { CURRENT_BRAND, isRootHost } from '@/data/hosts';
import { brandCss, type HostBrand } from '@/data/brands';
import { useUI } from '@/i18n/ui';
import photos from '@/data/photos.json';
import photoMeta from '@/data/photo-meta.json';
import photoDims from '@/data/photo-dims.json';
import TableEnhancements from '@/components/TableEnhancements.astro';
import Header from '@/components/Header.astro';
import PromoBar from '@/components/PromoBar.astro';
import Footer from '@/components/Footer.astro';
import StandQuizModal from '@/components/StandQuizModal.astro';
/* 2026-09-24 design pass: the eye-catching widgets were removed.
   LiveChat + PopupSystem + FloatingContacts were rejected and deleted (2026-10-04,
   docs/15) — booking goes through the on-page forms/CTA only.
   StickyCtaBar and smart CTA/quiz stay: they are part of the page, not floating chrome. */
import StickyCtaBar from '@/components/conversion/StickyCtaBar.astro';
import Tracking from '@/components/conversion/Tracking.astro';
import FormHandler from '@/components/conversion/FormHandler.astro';

interface Props {
  locale: Locale;
  /** path without locale prefix, e.g. "/events/foodera-expo/" */
  path: string;
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  /** LCP image to preload (absolute-from-root path) */
  preload?: string;
  breadcrumbs?: { name: string; path: string }[];
  /**
   * Absolute URL this page redirects to. Used when an exhibition cluster is published on its
   * own hostname: the old root path stays alive as a stub (no crawler lands on a 404, no
   * anchor text is wasted) while every identity signal — canonical, og:url, hreflang — is
   * pointed at the real page. A real 301 at the CDN is still preferred; see docs/05.
   */
  redirect?: string;
  /** a show's own page on the centre's host: wear that show's palette (docs/15 §10) */
  brand?: HostBrand | null;
}

const props = Astro.props;
/* the host's identity wins; otherwise a show page brings its own (alias mode) */
const PAGE_BRAND = CURRENT_BRAND ?? props.brand ?? null;
const { locale, path, jsonLd = [], breadcrumbs = [] } = props;

/** icon folder: a branded host keeps its own icons beside the centre's */
const ICON = CURRENT_BRAND ? `/brand/${CURRENT_BRAND.id}` : '';
const meta = buildMeta({
  locale,
  path,
  title: props.title,
  description: props.description,
  image: props.image,
  type: props.type,
  publishedTime: props.publishedTime,
  modifiedTime: props.modifiedTime,
  noindex: props.noindex,
});
if (props.redirect) {
  meta.canonical = props.redirect;
  meta.og.url = props.redirect;
  meta.hreflang = [];
  meta.xDefault = props.redirect;
}
/* a page we ask out of the index must not advertise language alternates: hreflang on a
   noindex URL is ignored at best and splits the signal at worst (docs/02 §4) */
if (meta.noindex) {
  meta.hreflang = [];
  meta.xDefault = '';
}
const t = useUI(locale);
const BUILD_DATE = new Date().toISOString().slice(0, 10);
const nodes: Record<string, unknown>[] = [
  {
    '@type': 'WebPage',
    '@id': meta.canonical,
    url: meta.canonical,
    name: props.title,
    description: props.description,
    inLanguage: localeMeta[locale].html,
    isPartOf: { '@id': `${SITE}/#website` },
    breadcrumb: breadcrumbs.length
      ? { '@id': `${SITE}${localize(locale, path)}#breadcrumbs` }
      : undefined,
    /* GEO: answer engines quote pages they can date, attribute and summarise */
    ...(props.publishedTime ? { datePublished: props.publishedTime } : {}),
    dateModified: props.modifiedTime ?? props.publishedTime ?? BUILD_DATE,
    publisher: { '@id': `${SITE}/#organization` },
    about: { '@id': `${SITE}/#venue` },
    primaryImageOfPage: { '@type': 'ImageObject', url: meta.og.image },
    speakable: { '@type': 'SpeakableSpecification', cssSelector: ['h1', 'main h1 + p', '.lead'] },
  },
  ...jsonLd,
];
/* keep one node per @id so entity stubs never duplicate the richer home nodes */
const seen = new Set<string>();
const graph = {
  '@context': 'https://schema.org',
  '@graph': [...nodes, ...entityNodes()].filter((node) => {
    const id = node?.['@id'];
    if (!id) return node !== undefined;
    if (seen.has(id)) return false;
    seen.add(id);
    return true;
  }),
};
const crumbs = [{ name: t('breadcrumbs.home'), path: '/' }, ...breadcrumbs];

/* The LCP hero is served as WebP through <Photo>; preloading the JPEG would download the
   picture twice. Resolve the same ladder here so the preload hint matches what the browser
   will actually pick. */
/* Scrapers trust og:image:width/height over the bytes, so a hard-coded 1200x630 makes
   Telegram and WhatsApp reserve the wrong box and crop the card. photo-dims.json carries
   what the build actually wrote. */
const ogName = /^https?:\/\/[^/]+\/images\/([a-z0-9-]+)\.jpg$/.exec(meta.og.image)?.[1];
const ogSize: [number, number] = (ogName && (photoDims as Record<string, [number, number]>)[ogName]) || [1200, 630];

const preloadName = props.preload ? /^\/images\/([a-z0-9-]+)\./.exec(props.preload)?.[1] : undefined;
const preloadRungs: number[] = (preloadName && (photos as Record<string, number[]>)[preloadName]) || [];
/* <Photo> offers AVIF first when the ladder exists, so the hint names the same format —
   a WebP preload would be a second download for every browser that takes the AVIF */
const preloadExt = preloadName && (photoMeta as Record<string, { a?: number }>)[preloadName]?.a ? 'avif' : 'webp';
const preload = props.preload
  ? {
      href: preloadRungs.length
        ? `/images/${preloadName}-${preloadRungs[preloadRungs.length - 1]}.${preloadExt}`
        : props.preload,
      srcset: preloadRungs.length
        ? preloadRungs.map((w) => `/images/${preloadName}-${w}.${preloadExt} ${w}w`).join(', ')
        : undefined,
      type: preloadRungs.length ? `image/${preloadExt}` : undefined,
    }
  : undefined;
---

<!doctype html>
<html lang={localeMeta[locale].html} data-brand={PAGE_BRAND?.id}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* motion is JS-gated: the class is set before first paint so nothing flashes */}
    <script is:inline>document.documentElement.classList.add('js')</script>
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={meta.canonical} />
    <meta name="theme-color" content={PAGE_BRAND?.palette.evergreen ?? "#123b25"} />
    <meta name="format-detection" content="telephone=no" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="robots" content={meta.noindex ? 'noindex,follow,max-image-preview:large' : 'index,follow,max-image-preview:large,max-snippet:-1'} />
    {
      meta.hreflang.map((h) => (
        <link rel="alternate" hreflang={localeMeta[h.locale].html} href={h.href} />
      ))
    }
    {meta.xDefault && <link rel="alternate" hreflang="x-default" href={meta.xDefault} />}
    {isRootHost && (
      <link rel="alternate" type="application/rss+xml" title="SOF EXPO Samarkand" href={`/${locale}/rss.xml`} />
    )}
    {props.redirect && <meta http-equiv="refresh" content={`0; url=${props.redirect}`} />}
    {/* The two faces that render above the fold in this locale (docs/18 §2): Manrope sets the
        H1 — usually the LCP element — and Onest the copy. ru renders Cyrillic, every other
        source locale Latin; the unicode-ranges in fonts.css pick the same files. */}
    {[`/fonts/manrope-${locale === 'ru' ? 'cyrillic' : 'latin'}.woff2`, `/fonts/onest-${locale === 'ru' ? 'cyrillic' : 'latin'}.woff2`].map((href) => (
      <link rel="preload" as="font" type="font/woff2" href={href} crossorigin="anonymous" />
    ))}
    <link rel="icon" href={`${ICON}/favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${ICON}/favicon.png`} type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href={`${ICON}/apple-touch-icon.png`} />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    {preload && (
      <link
        rel="preload"
        as="image"
        href={preload.href}
        imagesrcset={preload.srcset}
        imagesizes={preload.srcset ? '100vw' : undefined}
        type={preload.type}
        fetchpriority="high"
      />
    )}
    <meta property="og:type" content={meta.og.type} />
    <meta property="og:site_name" content={CURRENT_BRAND ? `${CURRENT_BRAND.name.en} ${CURRENT_BRAND.sub.en}` : "SOF EXPO Samarkand"} />
    <meta property="og:locale" content={meta.og.locale} />
    {meta.hreflang.filter((h) => h.locale !== locale).map((h) => <meta property="og:locale:alternate" content={localeMeta[h.locale].og} />)}
    <meta property="og:title" content={meta.og.title} />
    <meta property="og:description" content={meta.og.description} />
    <meta property="og:url" content={meta.og.url} />
    <meta property="og:image" content={meta.og.image} />
    <meta property="og:image:width" content={String(ogSize[0])} />
    <meta property="og:image:height" content={String(ogSize[1])} />
    <meta property="og:image:alt" content={props.title} />
    {meta.og.publishedTime && <meta property="article:published_time" content={meta.og.publishedTime} />}
    {meta.og.modifiedTime && <meta property="article:modified_time" content={meta.og.modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.og.title} />
    <meta name="twitter:description" content={meta.og.description} />
    <meta name="twitter:image" content={meta.og.image} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(graph)} />
    {/* a show host repaints the same token ladder with its own identity (src/data/brands.ts) —
        html[data-brand] is more specific than :root, so order of stylesheets does not matter */}
    {PAGE_BRAND && <style is:inline set:html={brandCss(PAGE_BRAND)} />}
  </head>
  <body>
    <div class="progress" aria-hidden="true"></div>
    <a class="skip" href="#main">{locale === 'ru' ? 'К основному содержимому' : 'Skip to content'}</a>
    <PromoBar locale={locale} hideFor={path} />
    <Header locale={locale} path={path} />
    <main id="main">
      {
        crumbs.length > 1 && (
          <div class="wrap">
            <ol class="crumbs">
              {crumbs.map((c, i) => (
                <li>
                  {i === crumbs.length - 1 ? (
                    <span aria-current="page">{c.name}</span>
                  ) : (
                    <a href={localize(locale, c.path)}>{c.name}</a>
                  )}
                </li>
              ))}
            </ol>
          </div>
        )
      }
      <slot />
    </main>
    <Footer locale={locale} path={path} />
    {/* The Rush-style quiz dialog: any [data-quiz-open] CTA opens it in place,
        the header CTA falls back to /request-stand/ without JavaScript. */}
    <StandQuizModal locale={locale} />
    <!-- Conversion system: CTA tracking and form handling only (no popups/livechat) -->
    <Tracking locale={locale} path={path} />
    <FormHandler />
    <StickyCtaBar locale={locale} pageType={path.includes('/exhibitors/') ? 'exhibitors' : path.includes('/visitors/') ? 'visitors' : path.includes('/organizers/') ? 'organizers' : path.includes('/events/') ? 'event' : path === '/' ? 'home' : 'other'} />
    <script>
      /* Subtle scroll reveal (user-approved 2026-09-22): fade + 8px over 200ms for
         sections below the first view only. JS-gated — without JavaScript the
         pending class is never added, so the site is fully visible without JS.
         Skipped under prefers-reduced-motion. docs/08 §5c */
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const vh = window.innerHeight;
        const els = Array.from(document.querySelectorAll('main .reveal')).filter(
          (el) => el.getBoundingClientRect().top > vh,
        );
        if (els.length) {
          els.forEach((el) => el.classList.add('reveal-pending'));
          const io = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('reveal-in');
                  io.unobserve(entry.target);
                }
              }
            },
            /* fire ~12% of a viewport BEFORE the section scrolls into view so
               the entrance is already done by the time the user sees the
               section — no blank band on fast scrolling (2026-10 fix) */
            { rootMargin: '0px 0px 12% 0px', threshold: 0.01 },
          );
          els.forEach((el) => io.observe(el));
          /* Chromium keeps observers only WEAKLY from the document: an observer
             with no JS reference can be garbage-collected mid-session, which
             silently stops callbacks and leaves later sections invisible
             forever. Retain every observer for the page lifetime. */
          ((window as any).__sofIO ??= []).push(io);
          /* Safety net: the IO alone can miss a section that is jumped over in a
             single instant scroll (ratio 0 → 0 between samples, no entry ever).
             Sweep on every scroll frame: anything whose top has reached the
             viewport reveals immediately — no section can stay invisible. */
          const revealNow = (el: Element) => {
            if (el.classList.contains('reveal-in')) return;
            el.classList.add('reveal-in');
            io.unobserve(el);
          };
          let sweeping = false;
          const sweep = () => {
            if (sweeping) return;
            sweeping = true;
            requestAnimationFrame(() => {
              sweeping = false;
              const bottom = window.innerHeight;
              for (const el of els) {
                if (el.getBoundingClientRect().top < bottom * 0.96) revealNow(el);
              }
            });
          };
          window.addEventListener('scroll', sweep, { passive: true });
          sweep();
        }
      }
      /* stagger index for children of revealed grids (consumed by motion.css) */
      document
        .querySelectorAll('main .reveal :is(.grid, .gallery, .stats, .steps, .checks)')
        .forEach((list) => Array.from(list.children).forEach((c, i) => (c as HTMLElement).style.setProperty('--i', String(Math.min(i, 8)))));

      /* hover layer: card spotlight + magnetic CTAs (fine pointers, motion allowed) */
      if (window.matchMedia('(hover: hover) and (pointer: fine)').matches && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const SPOT = '.feature, .ev, .pc, .mini, a.card';
        document.addEventListener('pointermove', (e) => {
          const t = e.target as Element | null;
          const card = t?.closest?.(SPOT) as HTMLElement | null;
          if (card) {
            const r = card.getBoundingClientRect();
            card.style.setProperty('--mx', `${e.clientX - r.left}px`);
            card.style.setProperty('--my', `${e.clientY - r.top}px`);
          }
          const btn = t?.closest?.('.btn--accent, .btn--gold') as HTMLElement | null;
          if (btn) {
            const r = btn.getBoundingClientRect();
            btn.style.setProperty('--tx', `${((e.clientX - r.left) / r.width - 0.5) * 8}px`);
            btn.style.setProperty('--ty', `${((e.clientY - r.top) / r.height - 0.5) * 6}px`);
          }
        }, { passive: true });
        document.addEventListener('pointerout', (e) => {
          const btn = (e.target as Element | null)?.closest?.('.btn--accent, .btn--gold') as HTMLElement | null;
          if (btn && !btn.contains(e.relatedTarget as Node)) { btn.style.removeProperty('--tx'); btn.style.removeProperty('--ty'); }
        }, { passive: true });
      }

      /* header state + reading progress: one passive, rAF-throttled listener */
      const root = document.documentElement;
      const bar = document.querySelector('.progress') as HTMLElement | null;
      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const y = window.scrollY;
          root.classList.toggle('is-scrolled', y > 8);
          const max = root.scrollHeight - window.innerHeight;
          bar?.style.setProperty('--p', max > 0 ? String(Math.min(1, y / max)) : '0');
          ticking = false;
        });
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      /* count-up for figures when they scroll into view (text stays correct without JS) */
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const nums = document.querySelectorAll<HTMLElement>('main .stat b.num');
        const cio = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              cio.unobserve(entry.target);
              const el = entry.target as HTMLElement;
              const node = Array.from(el.childNodes).find((n) => n.nodeType === 3 && /\d/.test(n.textContent || ''));
              if (!node) continue;
              const raw = node.textContent || '';
              const m = /(\d[\d\s,\u00a0]*)/.exec(raw);
              if (!m) continue;
              const target = Number(m[1].replace(/[^\d]/g, ''));
              if (!target || target < 10) continue;
              const sep = /,/.test(m[1]) ? ',' : /\d\s\d/.test(m[1]) ? '\u00a0' : '';
              const fmt = (n: number) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, sep);
              const t0 = performance.now();
              const dur = 1400;
              const step = (t: number) => {
                const k = Math.min(1, (t - t0) / dur);
                const e = 1 - Math.pow(1 - k, 4);
                node.textContent = raw.replace(m[1], fmt(Math.round(target * e)) + (/\s$/.test(m[1]) ? ' ' : ''));
                if (k < 1) requestAnimationFrame(step);
                else node.textContent = raw;
              };
              requestAnimationFrame(step);
            }
          },
          { threshold: 0.6 },
        );
        nums.forEach((n) => cio.observe(n));
        /* keep the observer reachable — unreferenced observers may be GC'd
           and the count-up would never run (same pitfall as the reveal io) */
        ((window as any).__sofIO ??= []).push(cio);
      }
    </script>
    <TableEnhancements />
  </body>
</html>

<style is:global>
  /* `main` is the 10px column of panels from redesign.css (`display: flex` + `gap: var(--gap)`,
     docs/18 §4). A later global `main { display: block }` here used to win over it and silently
     dropped every gutter: the panels fused into each other on the home, and the joined blocks
     (`margin-top: calc(-1 * var(--gap))`) overlapped their neighbour by 10px on the section
     pages. Do not re-add a `display` for `main` — the frame owns it. */
  .wrap + .wrap {
    margin-top: 0;
  }
</style>
