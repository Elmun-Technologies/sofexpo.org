---
import '@/styles/fonts.css';
import '@/styles/global.css';
import '@/styles/premium.css';
import { supportedLocales, localeMeta, localize } from '@/i18n/config';
const copy = {
  en: { title: 'This page has moved. Your next opportunity has not.', text: 'Explore the exhibition calendar or contact our team. We will help you find what you need.', home: 'Home', events: 'Exhibitions', contacts: 'Contact us' },
  ru: { title: 'Страница не найдена. Возможности остаются.', text: 'Откройте календарь выставок или свяжитесь с нашей командой — поможем найти нужную информацию.', home: 'Главная', events: 'Выставки', contacts: 'Связаться с нами' },
  zh: { title: '页面未找到，机遇依然在这里。', text: '查看展会日历或联系我们的团队，我们将帮助您找到所需信息。', home: '首页', events: '展会', contacts: '联系我们' },
  tr: { title: 'Bu sayfa taşınmış olabilir. Fırsatlar sizi bekliyor.', text: 'Fuar takvimini inceleyin veya ekibimizle iletişime geçin. Aradığınızı bulmanıza yardımcı olalım.', home: 'Ana sayfa', events: 'Fuarlar', contacts: 'İletişim' },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,follow" />
    <title>404 — Page not found · SOF EXPO Samarkand</title>
    <meta name="description" content="Find your way back to SOF EXPO Samarkand: exhibitions, visitor information, stand bookings and contacts in English, Russian, Chinese and Turkish." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main class="error-page wrap">
      <a class="error-brand" href="/en/">SOF EXPO <span>SAMARKAND</span></a>
      <p class="kicker">404</p>
      <h1>Page not found</h1>
      <nav class="error-languages" aria-label="Language">
        {supportedLocales.map(l => <a href={`#${l}`} lang={localeMeta[l].html}>{localeMeta[l].label}</a>)}
      </nav>
      <div class="error-grid">
        {supportedLocales.map(l => <section id={l} lang={localeMeta[l].html} class="card">
          <p class="kicker">{localeMeta[l].label}</p>
          <h2>{copy[l].title}</h2>
          <p>{copy[l].text}</p>
          <div class="btn-row">
            <a class="btn" href={localize(l,'/events/')}>{copy[l].events} →</a>
            <a class="btn btn--ghost" href={localize(l,'/contacts/')}>{copy[l].contacts}</a>
            <a class="error-home" href={localize(l,'/')}>{copy[l].home} →</a>
          </div>
        </section>)}
      </div>
    </main>
  </body>
</html>
<style>
  .error-page { padding-block: clamp(2rem, 6vw, 6rem); }
  .error-brand { display: block; font-weight: 700; font-size: 1.2rem; text-decoration: none; margin-bottom: 3rem; color: var(--ink); }
  .error-brand span { font-size: .8rem; color: var(--ink-60); }
  h1 { max-width: 20ch; font-size: clamp(2.6rem, 6vw, 5rem); }
  .error-languages { display: flex; flex-wrap: wrap; gap: 1.5rem; margin: 1.5rem 0 3rem; }
  /* mobile-first: one language card per row on a phone, two from ≥700px */
  .error-grid { display: grid; grid-template-columns: minmax(0,1fr); gap: 1.2rem; }
  h2 { font-size: 1.5rem; }
  .card { scroll-margin-top: 2rem; }
  .card p:not(.kicker) { color: var(--ink-60); margin-block: 1rem 1.5rem; }
  .error-home { align-self: center; padding: .5rem; }
  @media(min-width: 700px) { .error-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } }
</style>
