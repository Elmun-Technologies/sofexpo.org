---
/**
 * Catch-all for every authored page that is not driven by a content collection
 * (venue, exhibitors, visitors, organizers, company, legal). Each page ships its
 * own block sequence and copy per locale, so no two pages share a composition.
 */
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { sourceLocales as locales, localize, type SourceLocale as Locale } from '@/i18n/config';
import { pages, type PageDef } from '@/data/pages';
import { isBuiltHere } from '@/data/hosts';
import Base from '@/layouts/Base.astro';
import Blocks from '@/components/Blocks.astro';
import { breadcrumbJsonLd, organizationJsonLd, abs, faqJsonLd, serviceJsonLd } from '@/lib/seo';
import { pageCrumbs } from '@/lib/nav';

export const getStaticPaths = (async () => {
  const out: { params: { locale: Locale; slug: string }; props: { page: PageDef } }[] = [];
  for (const page of pages) {
    if (!isBuiltHere(page.path)) continue;
    const slug = page.path.replace(/^\/+|\/+$/g, '');
    for (const locale of locales) out.push({ params: { locale, slug }, props: { page } });
  }
  return out;
}) satisfies GetStaticPaths;

const { page } = Astro.props as InferGetStaticPropsType<typeof getStaticPaths>;
const locale = Astro.params.locale as Locale;
const meta = page.meta[locale];
const blocks = page.blocks[locale];
const crumbs = pageCrumbs(locale, page.path);
const trailItems = [
  { name: 'SOF EXPO Samarkand', url: abs(`/${locale}/`) },
  ...crumbs.map((c) => ({ name: c.name, url: abs(localize(locale, c.path)) })),
  { name: meta.title.split(' — ')[0], url: abs(localize(locale, page.path)) },
];
const bcJsonLd = breadcrumbJsonLd(trailItems);
const hero = blocks.find((b) => b.type === 'hero');
const faq = blocks.find((b) => b.type === 'faq');
const ld: Record<string, unknown>[] = [organizationJsonLd()];
if (faq?.items?.length) ld.push(faqJsonLd(faq.items as never, abs(localize(locale, page.path))));
/* hall-rental is a commercial query cluster — give it a Service entity (docs/08 §5c) */
if (page.path === '/organizers/') ld.push(serviceJsonLd(locale, abs(localize(locale, page.path))));
---

<Base
  {locale}
  title={meta.title}
  description={meta.description}
  path={page.path}
  image={page.image ?? '/og/default.jpg'}
  noindex={page.noindex}
  breadcrumbs={crumbs}
  jsonLd={[...ld, bcJsonLd]}
  preload={hero?.image}
>
  <Blocks {blocks} {locale} />
</Base>
