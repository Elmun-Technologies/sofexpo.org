---
/** A single market insight. Same renderer as news, different framing and extras. */
import type { GetStaticPaths } from 'astro';
import { sourceLocales as locales } from '@/i18n/config';
import { getCollection, render } from 'astro:content';
import { ownsPost, type PostKind } from '@/lib/contentOwnership';
import PostDetail from '@/components/PostDetail.astro';

export const getStaticPaths = (async () => {
  // each host builds only the pieces it publishes (the per-host editorial rule, docs/05)
  const entries = await getCollection('articles', ({ data }) => !data.draft);
  const out: { params: { locale: string; slug: string }; props: { entry: (typeof entries)[number] } }[] = [];
  for (const entry of entries) {
    const [locale, ...rest] = entry.id.split('/');
    if (!(locales as readonly string[]).includes(locale)) continue;
    if (!ownsPost('articles', rest.join('/'))) continue;
    out.push({ params: { locale, slug: rest.join('/') }, props: { entry } });
  }
  return out;
}) satisfies GetStaticPaths;

const { entry } = Astro.props as { entry: Awaited<ReturnType<typeof getCollection>>[number] };
const locale = Astro.params.locale as 'ru' | 'en';
const { Content, headings } = await render(entry);
const others = (await getCollection('articles'))
  .filter((e) => e.id.startsWith(`${locale}/`) && e.id !== entry.id && !e.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<PostDetail
  {locale}
  kind="articles"
  post={entry}
  {headings}
  body={Content}
  related={others}
  sectionTitle={{ ru: 'Аналитика рынков', en: 'Market insights' }}
/>
