---
/** Line-up: every exhibition the centre runs, ordered by date, with the next show first. */
import type { Locale } from '@/i18n/config';
import { localize } from '@/i18n/config';
import { useUI } from '@/i18n/ui';
import { events, upcoming } from '@/data/events';
import { archive } from '@/data/archive';
import { rootOnlyPaths } from '@/lib/hostRoutes';
import { abs, itemListJsonLd, breadcrumbJsonLd, organizationJsonLd } from '@/lib/seo';
import Base from '@/layouts/Base.astro';
import SectionHead from '@/components/SectionHead.astro';
import EventCard from '@/components/EventCard.astro';
import Icon from '@/components/Icon.astro';
import CtaBand from '@/components/CtaBand.astro';
import { industryLabel } from '@/lib/labels';

export function getStaticPaths() {
  return rootOnlyPaths();
}

const locale = Astro.params.locale as Locale;
const ru = locale === 'ru';
const t = useUI(locale);
const L = (p: string) => localize(locale, p);
const next = upcoming[0];
const rest = upcoming.slice(1);
const past = events.filter((e) => !upcoming.includes(e));
const groups = [...new Set(events.map((e) => e.industry))].map((key) => ({
  key,
  label: industryLabel(key, locale),
  items: events.filter((e) => e.industry === key),
}));

const copy = {
  ru: {
    title: 'Афиша выставок 2026–2027 в Самарканде',
    desc: 'Шесть отраслевых выставок в Самарканде: FOODERA, BUILD PRO, AGROPRO, PROMOTORS SHOW, WORLD EDU, ECOM & RETAIL. Даты, разделы, регистрация участников и посетителей.',
    h1: 'Шесть отраслей, один адрес',
    lead: 'Центр проводит собственную линейку событий: от продуктов и строительства до агропрома и электронной коммерции. Ниже — даты, формат и то, кому какое событие действительно нужно.',
  },
  en: {
    title: 'Exhibition line-up 2026–2027 in Samarkand',
    desc: 'Six trade shows in Samarkand: FOODERA, BUILD PRO, AGROPRO, PROMOTORS SHOW, WORLD EDU and ECOM & RETAIL. Dates, sections and registration for exhibitors and visitors.',
    h1: 'Six industries, one address',
    lead: 'The centre runs its own portfolio: from food and construction to agriculture and e-commerce. Below are the dates, the format and who each event is actually for.',
  },
};
---

<Base
  {locale}
  title={`${copy[locale].title} — SOF EXPO`}
  description={copy[locale].desc}
  path="/events/"
  image={next.heroImage}
  breadcrumbs={[{ name: ru ? 'Афиша выставок' : 'Exhibition line-up', path: '/events/' }]}
  jsonLd={[
    organizationJsonLd(),
    itemListJsonLd(
      events.map((e) => ({ name: e.brand[locale], url: abs(L(`/events/${e.slug}/`)) })),
      L('/events/'),
      ru ? 'Афиша выставок' : 'Exhibition line-up',
    ),
    breadcrumbJsonLd([{ name: 'SOF EXPO Samarkand', url: abs(`/${locale}/`) }, { name: ru ? 'Афиша выставок' : 'Line-up', url: abs(L('/events/')) }]),
  ]}
>
  <section class="sec">
    <div class="wrap">
      <SectionHead level={1} locale={locale} kicker={ru ? 'Афиша 2026–2027' : 'Line-up 2026–2027'} title={copy[locale].h1} text={copy[locale].lead} />
      <ul class="quick">
        {events.map((e) => (
          <li>
            <a href={L(`/events/${e.slug}/`)}>
              <b>{e.shortName}</b>
              <span class="quick__date">{e.dates.display[locale]}</span>
              <span class:list={['chip', 'quick__status', { 'chip--gold': e.status !== 'past' }]}>{e.status === 'past' ? (ru ? 'архив' : 'archive') : ru ? 'идёт набор' : 'sales open'}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {next && (
    <section class="sec sec--forest">
      <div class="wrap">
        <p class="kicker">{ru ? 'Ближайшее событие' : 'Next event'}</p>
        <EventCard locale={locale} event={next} priority variant="wide" />
      </div>
    </section>
  )}

  <section class="sec sec--paper">
    <div class="wrap">
      <SectionHead locale={locale} kicker={ru ? 'Скоро' : 'Upcoming'} title={ru ? 'Ближайшие выставки' : 'The next shows'} />
      <div class="grid g3">
        {rest.map((e) => <EventCard locale={locale} event={e} />)}
      </div>
      {past.length > 0 && (
        <>
          <hr class="hairline" style="margin:2.6rem 0" />
          <SectionHead locale={locale} kicker={ru ? 'Прошедшие редакции' : 'Past editions'} title={ru ? 'Отчёты, каталоги и фото' : 'Reports, catalogues and photos'} />
          <div class="grid g3">
            {past.map((e) => <EventCard locale={locale} event={e} />)}
          </div>
          <p class="small muted" style="margin-top:1.2rem">
            <a href={L('/events/past/')}>{ru ? `Архив всех редакций (${archive.length})` : `Full edition archive (${archive.length})`} →</a>
          </p>
        </>
      )}
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <SectionHead locale={locale} kicker={ru ? 'Как выбрать' : 'How to choose'} title={ru ? 'Событие под задачу, а не по календарю' : 'Pick the event for the job, not the calendar'} />
      <div class="grid g2">
        {groups.map((g) => (
          <div class="ind">
            <p class="mono-label">{g.label}</p>
            <ul>
              {g.items.map((e) => (
                <li>
                  <a href={L(`/events/${e.slug}/`)}>{e.brand[locale]}</a>
                  <span class="small muted">{e.dates.display[locale]}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <div class="tips">
        <p class="kicker">{ru ? 'Практика' : 'Practice'}</p>
        <ol>
          <li>{ru ? 'Продажа площади открывается за 4–6 месяцев до даты: лучшие локации разбирают в первый месяц.' : 'Floor sales open 4–6 months before the date; the best positions go in the first month.'}</li>
          <li>{ru ? 'Отраслевые выставки бесплатны для специалистов — регистрируйтесь заранее, чтобы не стоять на кассе.' : 'Trade shows are free for professionals — register early to skip the desk.'}</li>
          <li>{ru ? 'Деловая программа идёт параллельно: планируйте два дня, а не один.' : 'The business programme runs in parallel: plan two days, not one.'}</li>
        </ol>
      </div>
      <div class="btn-row" style="margin-top:1.6rem">
        <a class="btn btn--gold" href={L('/request-stand/')}>
          <Icon name="arrow" size={16} /> {t('cta.stand')}
        </a>
        <a class="btn btn--ghost" href={L('/visitors/tickets/')}>{t('cta.ticket')}</a>
      </div>
    </div>
  </section>

  <CtaBand
    locale={locale}
    title={ru ? 'Хотите своё событие в этом календаре?' : 'Want your own event in this calendar?'}
    text={ru ? 'Мы принимаем сторонние выставки, форумы и фестивали: зал, техника, сервис для участников.' : 'We take third-party shows, forums and festivals: hall, tech and exhibitor service.'}
    primary={{ label: ru ? 'Забронировать зал' : 'Book the hall', href: L('/organizers/') }}
    secondary={{ label: ru ? 'О площадке' : 'About the venue', href: L('/venue/') }}
  />
</Base>

<style>
  .quick {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.7rem;
    list-style: none;
    padding: 0;
    margin: 1.6rem 0 0;
  }
  .quick a {
    display: grid;
    gap: 0.3rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: var(--paper);
    text-decoration: none;
    color: inherit;
  }
  .quick a:hover {
    border-color: var(--moss);
  }
  .quick b {
    font-family: var(--f-display);
    font-size: 0.95rem;
  }
  .quick__date {
    color: var(--ink-60);
    font-size: 0.85rem;
  }
  .quick .quick__status {
    justify-self: start;
    margin-top: 0.15rem;
  }
  .ind {
    border: 1px solid var(--line);
    border-radius: var(--r);
    padding: 1.1rem 1.2rem;
    background: var(--paper);
  }
  .ind ul {
    list-style: none;
    margin: 0.6rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .ind li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px dashed var(--line);
    padding-bottom: 0.4rem;
  }
  .tips {
    margin-top: 2rem;
    padding: 1.2rem 1.3rem;
    background: var(--cream-2);
    border-radius: var(--r);
  }
  .tips ol {
    margin: 0.4rem 0 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.4rem;
    color: var(--ink-60);
  }
</style>
