---
/**
 * The line-up as a table calendar (docs/08 §4.3): date block, industry colour line,
 * one row per show, industry filter without JS (CSS :has()), .ics export generated
 * at build time from events.ts. The old card grid (5+1 orphan cards) is gone —
 * a calendar is what top-3 CIS expo sites put on this page.
 */
import type { SourceLocale as Locale } from '@/i18n/config';
import { localize } from '@/i18n/config';
import { events, upcoming } from '@/data/events';
import { archive } from '@/data/archive';
import { rootOnlyPaths } from '@/lib/hostRoutes';
import { abs, itemListJsonLd, breadcrumbJsonLd, organizationJsonLd } from '@/lib/seo';
import Base from '@/layouts/Base.astro';
import SectionHead from '@/components/SectionHead.astro';
import Icon from '@/components/Icon.astro';
import CtaBand from '@/components/CtaBand.astro';
import { bigDate, daysUntil, industryColor, industryLabel } from '@/lib/labels';

export function getStaticPaths() {
  return rootOnlyPaths();
}

const locale = Astro.params.locale as Locale;
const ru = locale === 'ru';
const L = (p: string) => localize(locale, p);
const next = upcoming[0];
/** future first, then the finished editions — the archive row keeps its report link */
const rows = [...events].sort((a, b) => a.dates.start.localeCompare(b.dates.start));
/** filter chips: only industries that actually have a show */
const filters = [...new Set(events.map((e) => e.industry))];

const copy = {
  ru: {
    title: 'Афиша выставок 2026–2027 в Самарканде',
    desc: 'Шесть отраслевых выставок в Самарканде: FOODERA, BUILD PRO, AGROPRO, PROMOTORS SHOW, WORLD EDU, ECOM & RETAIL. Даты, разделы, регистрация участников и посетителей.',
    h1: 'Шесть отраслей, один адрес',
    lead: 'Центр проводит собственную линейку событий: от продуктов и строительства до агропрома и электронной коммерции. Даты, разделы и статус брони — в календаре ниже.',
    all: 'Все отрасли',
    ics: 'Скачать календарь (.ics)',
    statusOpen: 'идёт набор',
    statusReg: 'приём заявок',
    statusPast: 'архив',
    stand: 'Стенд',
    ticket: 'Билет',
    report: 'Итоги',
    tipsTitle: 'Практика',
    tips: [
      'Продажа площади открывается за 4–6 месяцев до даты: лучшие локации разбирают в первый месяц.',
      'Отраслевые выставки бесплатны для специалистов — регистрируйтесь заранее, чтобы не стоять на кассе.',
      'Деловая программа идёт параллельно: планируйте два дня, а не один.',
    ],
  },
  en: {
    title: 'Exhibition line-up 2026–2027 in Samarkand',
    desc: 'Six trade shows in Samarkand: FOODERA, BUILD PRO, AGROPRO, PROMOTORS SHOW, WORLD EDU and ECOM & RETAIL. Dates, sections and registration for exhibitors and visitors.',
    h1: 'Six industries, one address',
    lead: 'The centre runs its own portfolio: from food and construction to agriculture and e-commerce. Dates, sections and booking status — in the calendar below.',
    all: 'All industries',
    ics: 'Download the calendar (.ics)',
    statusOpen: 'sales open',
    statusReg: 'applications open',
    statusPast: 'archive',
    stand: 'Stand',
    ticket: 'Pass',
    report: 'Report',
    tipsTitle: 'Practice',
    tips: [
      'Floor sales open 4–6 months before the date; the best positions go in the first month.',
      'Trade shows are free for professionals — register early to skip the desk.',
      'The business programme runs in parallel: plan two days, not one.',
    ],
  },
}[locale];
---

<Base
  {locale}
  title={`${copy.title} — SOF EXPO`}
  description={copy.desc}
  path="/events/"
  image={next.heroImage}
  breadcrumbs={[{ name: ru ? 'Афиша выставок' : 'Exhibition line-up', path: '/events/' }]}
  jsonLd={[
    organizationJsonLd(),
    itemListJsonLd(
      events.map((e) => ({ name: e.brand[locale], url: abs(L(`/events/${e.slug}/`)) })),
      L('/events/'),
      ru ? 'Афиша выставок' : 'Exhibition line-up',
    ),
    breadcrumbJsonLd([{ name: 'SOF EXPO Samarkand', url: abs(`/${locale}/`) }, { name: ru ? 'Афиша выставок' : 'Line-up', url: abs(L('/events/')) }]),
  ]}
>
  <section class="sec">
    <div class="wrap">
      <SectionHead level={1} locale={locale} kicker={ru ? 'Афиша 2026–2027' : 'Line-up 2026–2027'} title={copy.h1} text={copy.lead} />

      <div class="cal-wrap">
        <div class="cal__filter" role="group" aria-label={ru ? 'Фильтр по отрасли' : 'Industry filter'}>
          <input type="radio" name="ind-filter" id="f-all" checked />
          <label for="f-all">{copy.all}</label>
          {filters.map((f) => (
            <Fragment>
              <input type="radio" name="ind-filter" id={`f-${f}`} />
              <label for={`f-${f}`}>{industryLabel(f, locale)}</label>
            </Fragment>
          ))}
          <a class="cal__ics" href="/sofexpo-calendar.ics" download>
            <Icon name="doc" size={14} /> {copy.ics}
          </a>
        </div>

        <div class="cal">
          {rows.map((e) => {
            const d = bigDate(e.dates.start, e.dates.end, locale);
            const past = e.status === 'past';
            const days = daysUntil(e.dates.start);
            const status = past ? copy.statusPast : e.status === 'open' ? copy.statusOpen : copy.statusReg;
            return (
              <a class="cal__row" href={L(`/events/${e.slug}/`)} data-ind={e.industry} style={{ '--ic': industryColor(e.industry) } as Record<string, string>} aria-label={`${e.brand[locale]} — ${e.dates.display[locale]}`}>
                <span class="cal__date">
                  <b>{d.days}</b>
                  <span>{d.month} {d.year}</span>
                </span>
                <span class="cal__name">
                  <b>{e.brand[locale]}</b>
                  <small>
                    {e.edition[locale]}
                    {!past && days > 0 && (ru ? ` · через ${days} дн.` : ` · in ${days} d`)}
                  </small>
                </span>
                <span class="cal__ind">{industryLabel(e.industry, locale)}</span>
                <span class="cal__status">
                  <span class:list={['chip', { 'chip--live': !past }]}>
                    {!past && <span class="dot"></span>}
                    {status}
                  </span>
                </span>
                <span class="cal__act">
                  {!past ? (
                    <>
                      <span class="txt">
                        {copy.stand} <Icon name="arrow" size={13} />
                      </span>
                      <span class="txt">
                        {copy.ticket} <Icon name="arrow" size={13} />
                      </span>
                    </>
                  ) : (
                    <span class="txt">
                      {copy.report} <Icon name="arrow" size={13} />
                    </span>
                  )}
                </span>
              </a>
            );
          })}
        </div>
        <p class="small muted" style="margin-top:1rem">
          <a href={L('/events/past/')}>{ru ? `Архив всех редакций (${archive.length})` : `Full edition archive (${archive.length})`} →</a>
        </p>
      </div>

      <div class="tips" style="margin-top:2.4rem">
        <p class="kicker">{copy.tipsTitle}</p>
        <ol>
          {copy.tips.map((tip) => <li>{tip}</li>)}
        </ol>
      </div>
    </div>
  </section>

  <CtaBand
    locale={locale}
    title={ru ? 'Хотите своё событие в этом календаре?' : 'Want your own event in this calendar?'}
    text={ru ? 'Мы принимаем сторонние выставки, форумы и фестивали: зал, техника, сервис для участников.' : 'We take third-party shows, forums and festivals: hall, tech and exhibitor service.'}
    primary={{ label: ru ? 'Забронировать зал' : 'Book the hall', href: L('/organizers/') }}
    secondary={{ label: ru ? 'О площадке' : 'About the venue', href: L('/venue/') }}
  />
</Base>

<style>
  .tips {
    padding: 1.2rem 1.3rem;
    background: var(--cream-2);
    border-radius: var(--r);
  }
  .tips ol {
    margin: 0.4rem 0 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.4rem;
    color: var(--ink-60);
  }
  .cal__status .chip {
    white-space: nowrap;
  }
</style>
