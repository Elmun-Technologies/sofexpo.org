---
/** Archive of past editions: results, catalogues, photo reports — the proof layer of an expo site. */
import type { Locale } from '@/i18n/config';
import { localize } from '@/i18n/config';
import { archive, type Edition } from '@/data/archive';
import { getEvent } from '@/data/events';
import { rootOnlyPaths } from '@/lib/hostRoutes';
import { abs, breadcrumbJsonLd, itemListJsonLd } from '@/lib/seo';
import Base from '@/layouts/Base.astro';
import SectionHead from '@/components/SectionHead.astro';
import Icon from '@/components/Icon.astro';

export function getStaticPaths() {
  return rootOnlyPaths();
}

const locale = Astro.params.locale as Locale;
const ru = locale === 'ru';
const L = (p: string) => localize(locale, p);
const copy: Record<Locale, { title: string; desc: string; h1: string; lead: string }> = {
  ru: {
    title: 'Архив выставок: итоги и каталоги',
    desc: 'Итоги прошедших редакций SOF EXPO Samarkand: посещаемость, число экспонентов, каталоги участников и фотоматериалы BUILD PRO, AGROPRO, WORLD EDU, PROMOTORS SHOW.',
    h1: 'Что было на этой площадке',
    lead: 'Архив нужен не для ностальгии: по нему видно, какие разделы собирали аудиторию, сколько компаний приезжало и какие каталоги остались открытыми.',
  },
  en: {
    title: 'Exhibition archive: results and catalogues',
    desc: 'Past edition results at SOF EXPO Samarkand: attendance, exhibitor counts, catalogues and photography from BUILD PRO, AGROPRO, WORLD EDU and PROMOTORS SHOW.',
    h1: 'What this venue has hosted',
    lead: 'The archive is not for nostalgia: it shows which sections drew audiences, how many companies came and which catalogues stayed open.',
  },
};
const list: Edition[] = [...archive].sort((a, b) => b.year - a.year);
---

<Base
  {locale}
  title={`${copy[locale].title} — SOF EXPO`}
  description={copy[locale].desc}
  path="/events/past/"
  image="/images/hero-hall.jpg"
  breadcrumbs={[{ name: ru ? 'Афиша' : 'Line-up', path: '/events/' }, { name: ru ? 'Архив выставок' : 'Past editions', path: '/events/past/' }]}
  jsonLd={[
    itemListJsonLd(
      list.map((e) => ({ name: e.title[locale], url: abs(L(`/events/${e.eventSlug}/`)) })),
      L('/events/past/'),
      ru ? 'Архив выставок' : 'Past editions',
    ),
    breadcrumbJsonLd([{ name: 'SOF EXPO Samarkand', url: abs(`/${locale}/`) }, { name: ru ? 'Афиша' : 'Line-up', url: abs(L('/events/')) }, { name: ru ? 'Архив' : 'Archive', url: abs(L('/events/past/')) }]),
  ]}
>
  <section class="sec">
    <div class="wrap">
      <SectionHead level={1} locale={locale} kicker={ru ? 'Архив' : 'Archive'} title={copy[locale].h1} text={copy[locale].lead} />
      <div class="editions">
        {list.map((e) => {
          const ev = getEvent(e.eventSlug);
          return (
            <article class="ed">
              <div class="ed__year">
                <span class="num">{e.year}</span>
                <small>{e.dates}</small>
              </div>
              <div class="ed__body">
                <h2>{e.title[locale]}</h2>
                <p>{e.summary[locale]}</p>
                <ul class="ed__stats">
                  {e.results.map((r) => (
                    <li>
                      <b class="num">{r.value}</b>
                      <span>{r.label[locale]}</span>
                    </li>
                  ))}
                </ul>
                <div class="ed__links">
                  {ev && (
                    <a class="btn btn--sm btn--ghost" href={L(`/events/${ev.slug}/`)}>
                      {ru ? 'Страница выставки' : 'Show page'} <Icon name="arrow" size={15} />
                    </a>
                  )}
                  {e.catalogue && (
                    <a class="btn btn--sm btn--ghost" href={e.catalogue} rel="noopener" download={!e.catalogue.startsWith('http')}>
                      {ru ? 'Каталог' : 'Catalogue'}
                    </a>
                  )}
                  {e.photo && (
                    <a class="btn btn--sm btn--ghost" href={e.photo} target="_blank" rel="noopener">
                      {ru ? 'Фотоотчёт' : 'Photo report'}
                    </a>
                  )}
                </div>
              </div>
            </article>
          );
        })}
      </div>
      <p class="small muted" style="margin-top:1.6rem">
        {ru
          ? 'Нужны данные по другой редакции или году — напишите, выгрузим статистику и материалы.'
          : 'Need data on another edition or year — write to us and we will pull the statistics and materials.'}
      </p>
    </div>
  </section>
</Base>

<style>
  .editions {
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
    margin-top: 1.4rem;
  }
  .ed {
    background: var(--paper);
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: clamp(1rem, 0.5rem + 2vw, 2.4rem);
    padding: clamp(1.2rem, 0.8rem + 1.6vw, 2rem);
  }
  .ed__year {
    display: grid;
    gap: 0.2rem;
    align-content: start;
  }
  .ed__year span {
    font-size: 2rem;
    color: var(--evergreen);
  }
  .ed__year small {
    color: var(--ink-40);
    font-size: 0.82rem;
  }
  .ed h2 {
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.5rem);
    margin: 0 0 0.4rem;
  }
  .ed p {
    margin: 0;
    color: var(--ink-60);
    max-width: 70ch;
  }
  .ed__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.6rem;
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
  }
  .ed__stats li {
    display: grid;
    gap: 0.1rem;
  }
  .ed__stats b {
    font-size: 1.25rem;
    color: var(--gold);
  }
  .ed__stats span {
    font-size: 0.8rem;
    color: var(--ink-60);
  }
  .ed__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.1rem;
  }
  @media (max-width: 760px) {
    .ed {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
