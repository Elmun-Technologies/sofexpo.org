---
import Base from '@/layouts/Base.astro';
import { localize } from '@/i18n/config';
import { localePaths } from '@/lib/pages';
import { site } from '@/data/site';
import { upcoming, events } from '@/data/events';
import { CURRENT_EVENT } from '@/data/hosts';
import { eventPages } from '@/data/pages/event-pages';
import { neighbours } from '@/data/markets';
import { homeLogos, partnerSrc } from '@/lib/partners';
import EventPage from '@/components/EventPage.astro';
import { getCollection } from 'astro:content';
import { rootJsonLd, breadcrumbJsonLd, itemListJsonLd, faqJsonLd } from '@/lib/seo';
import { bigDate, daysUntil, industryLabel } from '@/lib/labels';
import { formatDate } from '@/lib/nav';
import { postHref } from '@/lib/contentOwnership';
import Icon from '@/components/Icon.astro';
import Photo from '@/components/Photo.astro';
import ShowLogo from '@/components/ShowLogo.astro';
import LeadForm from '@/components/LeadForm.astro';
import { logoFor } from '@/lib/showLogos';

export function getStaticPaths() {
  return localePaths();
}

/* On an exhibition's own hostname this route IS the event home: the cluster lives at the
   root of that host, so `/ru/` shows the show, not the centre. */
const hostEvent = CURRENT_EVENT ? events.find((e) => e.slug === CURRENT_EVENT) ?? null : null;
const hostPage = hostEvent ? eventPages[hostEvent.slug]?.overview ?? null : null;

const { locale } = Astro.params as { locale: 'ru' | 'en' };
const P = (p: string) => localize(locale, p);
const ru = locale === 'ru';
const next = upcoming[0];
const days = daysUntil(next.dates.start);
/* the big date block of the next-show card: "27–29" + "OCT 2026" (the EventHero helper) */
const nd = bigDate(next.dates.start, next.dates.end, locale);

/*
 * 2026-10 redesign (docs/18 §4): the home is a column of panels — a split hero (venue + a
 * hall photo), the next show beside the venue in four numbers, the six shows, three
 * audiences, the building, why Samarkand, logos, news and four questions. Every figure is
 * one the site already states elsewhere (docs/02 §5); the market totals are computed from
 * src/data/markets.ts, not typed in.
 */
const copy = {
  ru: {
    title: 'Выставочный центр в Самарканде — выставки и экспо Узбекистана | SOF EXPO',
    desc:
      'Выставочный центр SOF EXPO в Самарканде: 4 400 м² зала и 5 000 м² улицы, 20+ выставок и событий, 70 000+ посетителей в год. Бронирование стендов и аренда зала.',
    chips: ['Зал 4 400 м²', 'Открытая площадка 5 000 м²', '20+ событий в год'],
    h1: 'SOF EXPO — международный выставочный центр в Самарканде',
    lead: 'Отраслевые выставки, форумы и B2B-встречи. Шесть рынков Центральной Азии — в одном дне пути.',
    stand: 'Забронировать стенд',
    calendar: 'Календарь 2026–2027',
    heroPhoto: 'Зал SOF EXPO в день открытия',
    heroGo: 'Знакомство с центром',
    nextLabel: 'Ближайшая выставка',
    stats: [
      { v: '4 400 м²', l: 'крытый выставочный зал' },
      { v: '5 000 м²', l: 'открытая площадка' },
      { v: '20+', l: 'событий в год' },
      { v: '70 000+', l: 'посетителей в год' },
    ],
    quoteT: 'Цены, план зала и свободные места — за один рабочий день',
    quoteCta: 'Отправить запрос',
    showsK: 'Выставки в Узбекистане 2026–2027',
    showsT: 'Шесть отраслей. Один центр.',
    allEvents: 'Весь календарь',
    status: { open: 'Регистрация открыта', registration: 'Приём заявок', past: 'Итоги 2026' },
    aud: [
      { t: 'Экспонентам', d: 'Готовый стенд, место на плане зала и список закупщиков до открытия выставки.', href: '/exhibitors/', img: '/images/stand-dark.jpg', alt: 'Стенд экспонента индивидуальной застройки', tags: ['Пакеты', 'Застройка стендов', 'Спонсорство'], tone: 'ink' },
      { t: 'Посетителям', d: 'Бесплатный вход в торговые дни, QR-билет, деловая программа и отели.', href: '/visitors/', img: '/images/b2b-meeting.jpg', alt: 'Переговоры гостей на стенде', tags: ['Регистрация', 'Отели', 'Трансфер'], tone: 'blue' },
      { t: 'Организаторам', d: 'Зал и сервис для вашей выставки, форума или фестиваля.', href: '/organizers/', img: '/images/conference-stage.jpg', alt: 'Сцена конференц-зала', tags: ['Аренда зала', 'Конференции', 'Оборудование'], tone: 'paper' },
    ],
    venueK: 'Выставочный центр',
    venueT: 'Здание, готовое к монтажу',
    venueText: '700 кВт мощности, климат-контроль, Wi-Fi, переговорные для B2B, конференц-зал, ресторан и молельная комната — на одной территории.',
    specs: [
      { k: 'Электричество', v: '700 кВт · 220/380 В' },
      { k: 'Аэропорт / вокзал', v: '16 км / 23 км' },
      { k: 'Кафе и ресторан', v: '350 мест' },
      { k: 'Высота стенда', v: 'до 6 м' },
    ],
    venueAlts: ['Пустой выставочный зал перед монтажом', 'Здание SOF EXPO с флагами', 'Тракторы на открытой площадке'],
    halls: 'Залы и площади',
    specsCta: 'Техническая спецификация',
    regPhoto: 'Регистан вечером, Самарканд',
    regLabel: '18 км до Регистана',
    whyK: 'Почему Самарканд',
    whyT: 'Транзитный узел между шестью рынками',
    popL: 'млн человек на соседних рынках',
    gdpL: 'млрд долларов ВВП вместе · Всемирный банк',
    logosT: 'Экспоненты и партнёры',
    logosText: 'Государственные структуры, отраслевые бренды, медиа и отели.',
    logosCta: 'Все партнёры',
    newsT: 'Новости',
    newsCta: 'Все новости',
    formK: 'Заявка',
    formTitle: 'Получить планировку, цены и свободные места',
    formText: 'Укажите выставку и площадь — пришлём прайс, floor plan и профиль аудитории. Без оплаты сейчас.',
    formTitleCard: 'Заявка на стенд',
    formSub: '30 секунд — без оплаты сейчас.',
    formList: ['Прайс-лист и план зала в PDF', 'Профиль аудитории и список участников', 'Фиксация цены раннего бронирования', 'Подбор места с учётом вашего продукта'],
    directions: ['Продукты питания', 'Напитки', 'Стройматериалы', 'Агро', 'Авто', 'E-commerce и ритейл', 'Образование', 'Услуги', 'Другое'],
    faqT: 'Частые вопросы',
    faqCta: 'Все вопросы',
  },
  en: {
    title: 'Expo Centre Samarkand — Exhibitions & Trade Shows in Uzbekistan | SOF EXPO',
    desc:
      'SOF EXPO, the exhibition centre in Samarkand: 4,400 m² hall and 5,000 m² outdoors, 20+ trade shows and events, 70,000+ visitors a year. Book a stand or rent the hall.',
    chips: ['4,400 m² hall', '5,000 m² open-air area', '20+ events a year'],
    h1: 'SOF EXPO — the international exhibition centre in Samarkand',
    lead: 'Trade shows, forums and B2B meetings. Six Central Asian markets within a day’s travel.',
    stand: 'Book a stand',
    calendar: 'Calendar 2026–2027',
    heroPhoto: 'The SOF EXPO hall on opening day',
    heroGo: 'Get to know the centre',
    nextLabel: 'Next exhibition',
    stats: [
      { v: '4 400 m²', l: 'indoor exhibition hall' },
      { v: '5 000 m²', l: 'open-air area' },
      { v: '20+', l: 'events a year' },
      { v: '70 000+', l: 'visitors a year' },
    ],
    quoteT: 'Rates, the floor plan and free spots — within one business day',
    quoteCta: 'Send a request',
    showsK: 'Exhibitions in Uzbekistan 2026–2027',
    showsT: 'Six industries. One centre.',
    allEvents: 'Full calendar',
    status: { open: 'Registration open', registration: 'Applications open', past: '2026 results' },
    aud: [
      { t: 'For exhibitors', d: 'A ready stand, a place on the floor plan and the buyer list before the show opens.', href: '/exhibitors/', img: '/images/stand-dark.jpg', alt: 'A custom-built exhibitor stand', tags: ['Packages', 'Stand construction', 'Sponsorship'], tone: 'ink' },
      { t: 'For visitors', d: 'Free entry on trade days, a QR ticket, the business programme and hotels.', href: '/visitors/', img: '/images/b2b-meeting.jpg', alt: 'Guests in a meeting at a stand', tags: ['Registration', 'Hotels', 'Transfer'], tone: 'blue' },
      { t: 'For organizers', d: 'The hall and the services for your own exhibition, forum or festival.', href: '/organizers/', img: '/images/conference-stage.jpg', alt: 'The conference hall stage', tags: ['Hall rental', 'Conferences', 'Equipment'], tone: 'paper' },
    ],
    venueK: 'Exhibition centre',
    venueT: 'A building ready for build-up',
    venueText: '700 kW of power, climate control, Wi-Fi, B2B meeting rooms, a conference hall, a restaurant and a prayer room — on one site.',
    specs: [
      { k: 'Power', v: '700 kW · 220/380 V' },
      { k: 'Airport / railway station', v: '16 km / 23 km' },
      { k: 'Café and restaurant', v: '350 seats' },
      { k: 'Stand height', v: 'up to 6 m' },
    ],
    venueAlts: ['The empty exhibition hall before build-up', 'The SOF EXPO building with flags', 'Tractors on the open-air area'],
    halls: 'Halls and areas',
    specsCta: 'Technical data sheet',
    regPhoto: 'Registan in the evening, Samarkand',
    regLabel: '18 km to the Registan',
    whyK: 'Why Samarkand',
    whyT: 'A transit node between six markets',
    popL: 'million people in the neighbouring markets',
    gdpL: 'billion USD of combined GDP · World Bank',
    logosT: 'Exhibitors and partners',
    logosText: 'State bodies, industry brands, media and hotels.',
    logosCta: 'All partners',
    newsT: 'News',
    newsCta: 'All news',
    formK: 'Request',
    formTitle: 'Get the floor plan, rates and free spots',
    formText: 'Name the exhibition and the area — we send the price list, floor plan and audience profile. No payment now.',
    formTitleCard: 'Stand request',
    formSub: '30 seconds — no payment now.',
    formList: ['Price list and hall plan in PDF', 'Audience profile and exhibitor list', 'Early-booking price lock', 'Location picked around your product'],
    directions: ['Food products', 'Drinks', 'Building materials', 'Agriculture', 'Automotive', 'E-commerce and retail', 'Education', 'Services', 'Other'],
    faqT: 'Frequently asked questions',
    faqCta: 'All questions',
  },
}[locale];

/* the six shows of the season: the five ahead, then the one whose results are in */
const shows = [...upcoming, ...events.filter((e) => e.status === 'past')].slice(0, 6);

/* why Samarkand: the five neighbours by distance; totals computed, never typed */
const markets = [...neighbours].sort((a, b) => a.distanceKm - b.distanceKm);
const fmt = (n: number) => n.toLocaleString(ru ? 'ru-RU' : 'en-US');
const popTotal = Math.round(markets.reduce((n, m) => n + m.populationMln, 0) * 10) / 10;
const gdpTotal = Math.round(markets.reduce((n, m) => n + m.gdpBlnUsd, 0));

const news = (await getCollection('news'))
  .filter((e) => e.id.startsWith(`${locale}/`))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const faq = (ru
  ? [
      { q: 'Сколько стоит стенд и от чего зависит цена?', a: 'Ставка считается за квадратный метр и зависит от выставки, расположения места и типа застройки. Прайс-лист и план зала высылаем по заявке — в него уже входят электричество, мебель и брендирование.' },
      { q: 'Можно ли арендовать зал под своё мероприятие?', a: 'Да. Центр работает и как площадка для сторонних организаторов: выставка, форум, конференция, фестиваль или корпоративное событие. Заявку на расчёт даты и технического задания можно оставить на странице для организаторов.' },
      { q: 'Как попасть на выставку посетителем?', a: 'Регистрация онлайн даёт электронный билет: вход по QR-коду, без очереди. На отраслевых выставках вход для профильных специалистов бесплатный, на фестивальные форматы — по билету.' },
      { q: 'Помогаете ли вы с логистикой и проживанием?', a: 'Да: трансфер от аэропорта и вокзала, бронь отелей-партнёров со скидкой для участников, хранение и вывоз груза, разгрузка фуры.' },
    ]
  : [
      { q: 'What does a stand cost and what drives the price?', a: 'The rate is per square metre and depends on the show, location on the floor plan and build type. Send a request for the price list and hall plan — power, furniture and branding are already inside it.' },
      { q: 'Can I rent the hall for my own event?', a: 'Yes. The centre also works as a venue for third-party organizers: exhibitions, forums, conferences, festivals and corporate events. Submit a date request on the organizers page.' },
      { q: 'How do visitors get in?', a: 'Online registration issues an e-ticket — you enter with a QR code, no queue. Trade entry is free at industry shows; festival formats are ticketed.' },
      { q: 'Do you help with travel and accommodation?', a: 'Yes: transfers from the airport and station, discounted partner hotels for participants, storage, cargo handling and truck unloading.' },
    ]);

const jsonLd = [
  ...rootJsonLd(),
  breadcrumbJsonLd([{ name: ru ? 'Главная' : 'Home', url: P('/') }]),
  itemListJsonLd(
    events.map((e) => ({ name: e.brand[locale], url: P(`/events/${e.slug}/`) })),
    P('/'),
    ru ? 'Выставки SOF EXPO Samarkand' : 'SOF EXPO Samarkand exhibitions',
  ),
  faqJsonLd(faq, P('/')),
];
---

{hostEvent && hostPage ? <EventPage locale={locale} event={hostEvent} page={hostPage} /> : <Base
  locale={locale}
  path="/"
  title={copy.title}
  description={copy.desc}
  jsonLd={jsonLd}
  image={next.heroImage}
  preload="/images/hall-panorama.jpg"
>
  <!-- 1 · hero: the venue in one sentence, beside the hall on opening day -->
  <section class="h-hero">
    <div class="h-hero__text">
      <ul class="h-chips">{copy.chips.map((c) => <li>{c}</li>)}</ul>
      <h1>{copy.h1}</h1>
      <div class="h-hero__foot">
        <p>{copy.lead}</p>
        <div class="btn-row">
          <a class="btn" href={P('/request-stand/')} data-quiz-open data-quiz-source="home-hero">{copy.stand}</a>
          <a class="btn btn--ghost" href={P('/events/')}>{copy.calendar}</a>
        </div>
      </div>
    </div>
    <div class="h-hero__photo">
      <Photo src="/images/hall-panorama.jpg" alt={copy.heroPhoto} ratio="4/5" rounded={false} priority sizes="(max-width: 900px) 100vw, 46vw" />
      <span class="h-tag" aria-hidden="true">{copy.heroPhoto}</span>
      <a class="h-go" href={P('/venue/')} aria-label={copy.heroGo}><Icon name="arrow-ne" size={30} /></a>
    </div>
  </section>

  <!-- 2 · the next show, and the venue in four numbers -->
  <section class="h-next">
    <a class="h-show" href={P(`/events/${next.slug}/`)}>
      <span class="h-show__top">
        <span class="h-show__k">
          <span>{copy.nextLabel}</span>
          {days > 0 && <><span aria-hidden="true"> · </span><span>{ru ? `через ${days} дн.` : `in ${days} days`}</span></>}
        </span>
        <span class="arr arr--lg" aria-hidden="true"><Icon name="arrow-ne" size={22} /></span>
      </span>
      <span class="h-show__logo"><ShowLogo slug={next.slug} height={logoFor(next.slug)?.round ? 72 : 44} /></span>
      <span class="h-show__foot">
        <span class="h-show__date">{nd.days}<small> {nd.month} {nd.year}</small></span>
        <span class="h-chips h-chips--dark">
          <span>{industryLabel(next.industry, locale)}</span>
          {next.highlight && <span class="is-hot">{next.highlight.label[locale]}</span>}
        </span>
      </span>
      <span class="sr-only">{next.brand[locale]} · {next.dates.display[locale]}</span>
    </a>
    <div class="h-stats">
      {copy.stats.map((s) => <div class="h-stat"><span>{s.l}</span><b>{s.v}</b></div>)}
      <div class="h-quote">
        <p>{copy.quoteT}</p>
        <a class="pill pill--light" href={P('/request-stand/')} data-quiz-open data-quiz-source="home-quote">{copy.quoteCta}</a>
      </div>
    </div>
  </section>

  <!-- 3 · the six shows -->
  <section class="h-panel">
    <div class="h-head">
      <div>
        <p class="kicker">{copy.showsK}</p>
        <h2>{copy.showsT}</h2>
      </div>
      <a class="pill" href={P('/events/')}>{copy.allEvents}</a>
    </div>
    <div class="h-shows">
      {shows.map((e, i) => (
        <a class="h-card" href={P(`/events/${e.slug}/`)}>
          <span class="h-card__media">
            <Photo src={e.heroImage} alt={e.tagline[locale]} ratio="16/10" rounded={false} sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 33vw" />
            <span class="h-card__date">{e.dates.display[locale]}</span>
            <span class="h-card__logo"><ShowLogo slug={e.slug} height={26} /></span>
          </span>
          <span class="h-card__body">
            <span class="h-card__name"><b>{e.brand[locale]}</b><span aria-hidden="true">{String(i + 1).padStart(2, '0')}</span></span>
            <span class="h-card__desc">{e.tagline[locale]}</span>
            <span class="h-card__foot"><span class="h-card__status">{copy.status[e.status]}</span><span class="arr" aria-hidden="true"><Icon name="arrow-ne" size={16} /></span></span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- 4 · three audiences -->
  <section class="h-aud">
    {copy.aud.map((a) => (
      <a class:list={['h-aud__card', `is-${a.tone}`]} href={P(a.href)}>
        <Photo src={a.img} alt={a.alt} ratio="16/9" rounded={false} sizes="(max-width: 900px) 100vw, 33vw" />
        <span class="h-aud__body">
          <span class="h-aud__t"><b>{a.t}</b><span class="arr arr--line" aria-hidden="true"><Icon name="arrow-ne" size={18} /></span></span>
          <span class="h-aud__d">{a.d}</span>
          <span class="h-aud__tags">{a.tags.map((t) => <span>{t}</span>)}</span>
        </span>
      </a>
    ))}
  </section>

  <!-- 5 · the building -->
  <section class="h-venue">
    <div class="h-venue__photos">
      <Photo src="/images/hall-empty.jpg" alt={copy.venueAlts[0]} ratio="16/7" rounded={false} sizes="(max-width: 900px) 100vw, 56vw" />
      <Photo src="/images/venue-flags.jpg" alt={copy.venueAlts[1]} ratio="4/3" rounded={false} sizes="(max-width: 640px) 100vw, 28vw" />
      <Photo src="/images/outdoor-tractors.jpg" alt={copy.venueAlts[2]} ratio="4/3" rounded={false} sizes="(max-width: 640px) 100vw, 28vw" />
    </div>
    <div class="h-venue__text">
      <p class="kicker">{copy.venueK}</p>
      <h2>{copy.venueT}</h2>
      <p class="h-muted">{copy.venueText}</p>
      <dl class="h-specs">{copy.specs.map((x) => <div><dt>{x.k}</dt><dd>{x.v}</dd></div>)}</dl>
      <div class="btn-row">
        <a class="btn" href={P('/venue/halls/')}>{copy.halls}</a>
        <a class="btn btn--ghost" href={P('/venue/tech-specs/')}>{copy.specsCta}</a>
      </div>
    </div>
  </section>

  <!-- 6 · why Samarkand -->
  <section class="h-why">
    <div class="h-why__photo">
      <Photo src="/images/registan-night.jpg" alt={copy.regPhoto} ratio="4/5" rounded={false} sizes="(max-width: 900px) 100vw, 40vw" />
      <span class="h-tag h-tag--left">{copy.regLabel}</span>
    </div>
    <div class="h-why__text">
      <p class="kicker">{copy.whyK}</p>
      <h2>{copy.whyT}</h2>
      <ul class="h-markets">{markets.map((m) => <li>{m.name[locale]} <span>{fmt(m.distanceKm)} km</span></li>)}</ul>
      <div class="h-why__nums">
        <div><span>{copy.popL}</span><b>{fmt(popTotal)}</b></div>
        <div><span>{copy.gdpL}</span><b>${fmt(gdpTotal)}</b></div>
      </div>
    </div>
  </section>

  <!-- 7 · logos -->
  <section class="h-panel h-logos">
    <div class="h-logos__head">
      <h2>{copy.logosT}</h2>
      <p class="h-muted">{copy.logosText}</p>
      <a class="pill" href={P('/about/partners/')}>{copy.logosCta}</a>
    </div>
    <ul class="h-logos__grid">
      {homeLogos.map((l) => <li><img src={partnerSrc(l.id)} alt={ru ? `Логотип ${l.name}` : `${l.name} logo`} loading="lazy" decoding="async" height="56" /></li>)}
    </ul>
  </section>

  <!-- 8 · news -->
  <section class="h-panel">
    <div class="h-head">
      <h2>{copy.newsT}</h2>
      <a class="pill" href={P('/news/')}>{copy.newsCta}</a>
    </div>
    <div class="h-news">
      {news.map((n) => {
        const slug = n.id.split('/').slice(1).join('/');
        const ev = n.data.event ? events.find((e) => e.slug === n.data.event) : undefined;
        return (
          <a class="h-news__card" href={postHref(locale, 'news', slug)}>
            <Photo src={n.data.hero ?? ev?.heroImage ?? '/images/hero-hall.jpg'} alt={n.data.title} ratio="16/10" rounded={false} sizes="(max-width: 640px) 100vw, 33vw" />
            <span class="h-news__meta"><time datetime={n.data.date.toISOString()}>{formatDate(n.data.date.toISOString().slice(0, 10), locale)}</time>{ev && <> · {ev.shortName}</>}</span>
            <span class="h-news__t">{n.data.title}</span>
          </a>
        );
      })}
    </div>
  </section>

  <!-- 8.5 · the request: leads are the site's first goal (docs/18 §4), so the home keeps a form -->
  <section class="h-panel h-form" id="booking">
    <div class="h-form__head">
      <p class="kicker">{copy.formK}</p>
      <h2>{copy.formTitle}</h2>
