---
import Base from '@/layouts/Base.astro';
import { localize } from '@/i18n/config';
import { useUI } from '@/i18n/ui';
import { localePaths } from '@/lib/pages';
import { site } from '@/data/site';
import { telHref } from '@/lib/nav';
import { upcoming, events } from '@/data/events';
import { CURRENT_EVENT } from '@/data/hosts';
import { eventPages } from '@/data/pages/event-pages';
import EventPage from '@/components/EventPage.astro';
import { getCollection } from 'astro:content';
import { rootJsonLd, breadcrumbJsonLd, itemListJsonLd, faqJsonLd, abs } from '@/lib/seo';
import Icon from '@/components/Icon.astro';
import SectionHead from '@/components/SectionHead.astro';
import EventCard from '@/components/EventCard.astro';
import StatBand from '@/components/StatBand.astro';
import PageHero from '@/components/PageHero.astro';
import FeatureGrid from '@/components/FeatureGrid.astro';
import Countdown from '@/components/Countdown.astro';
import Faq from '@/components/Faq.astro';
import CtaBand from '@/components/CtaBand.astro';
import LeadForm from '@/components/LeadForm.astro';
import { humanDate } from '@/lib/labels';

export function getStaticPaths() {
  return localePaths();
}

/* On an exhibition's own hostname this route IS the event home: the cluster lives at the
   root of that host, so `/ru/` shows the show, not the centre. */
const hostEvent = CURRENT_EVENT ? events.find((e) => e.slug === CURRENT_EVENT) ?? null : null;
const hostPage = hostEvent ? eventPages[hostEvent.slug]?.overview ?? null : null;

const { locale } = Astro.params as { locale: 'ru' | 'en' };
const t = useUI(locale);
const P = (p: string) => localize(locale, p);
const ru = locale === 'ru';
const next = upcoming[0];
const later = upcoming.slice(1);

const copy = {
  ru: {
    title: 'SOF EXPO Samarkand — экспоцентр и выставки в Самарканде',
    desc:
      'Экспоцентр SOF EXPO Samarkand: 4 400 м² зала и 5 000 м² улицы, 20+ событий, 70 000+ посетителей в год. Бронирование стендов, аренда под своё событие, деловая программа.',
    heroKicker: 'Выставочный центр · Самарканд, Узбекистан',
    h1: 'Здесь отрасль встречается <em>лицом к лицу</em>',
    lead:
      'SOF EXPO Samarkand — крытый экспоцентр и оператор международных отраслевых выставок в центре Узбекистана. Один зал 4 400 м², открытая площадка 5 000 м², конференц-зал, кафе на 350 мест и парковка при въезде.',
    bullets: ['Заявка на стенд — ответ за 24 часа', 'Техспецификация и планировка — по запросу', 'Русский, английский, узбекский языки сервиса'],
    upcomingText:
      'Шесть собственных выставок в год: продукты и напитки, строительство, агропром, автоиндустрия, e-commerce и образование. Каждая — с деловой программой и биржей контактов.',
    venue: {
      kicker: 'Площадка',
      title: 'Один корпус, две площади, ноль сюрпризов при монтаже',
      text: 'Всё, что нужно для экспозиции, уже в здании: электричество 700 кВт, климат-контроль, аудиосистема, интернет и подъезд для фур. Технические детали высылаем до подписания договора.',
      links: [
        { href: '/venue/halls/', label: 'Залы и площади' },
        { href: '/venue/tech-specs/', label: 'Техническая спецификация' },
        { href: '/venue/how-to-get-there/', label: 'Как добраться' },
      ],
      specs: [
        ['Крытая площадь', '4 400 м², свободная планировка'],
        ['Открытая площадь', '5 000 м², подъезд фур и кран'],
        ['Электричество', '700 кВт, 220 / 380 В'],
        ['Конференц-зал', 'до 350 мест, аудио/видео, проекция'],
        ['Климат', 'охлаждение, обогрев, вентиляция'],
        ['Парковка', 'бесплатно, при въезде в центр'],
      ],
    },
    audiences: {
      kicker: 'Аудиториям',
      title: 'Выберите свою дверь',
      items: [
        { title: 'Экспонентам', text: 'Площадь, застройка, услуга «стенд под ключ», реклама на площадке и список закупщиков до старта выставки.', href: '/exhibitors/', label: 'Пакеты и цены' },
        { title: 'Посетителям', text: 'Билеты и бесплатная регистрация, расписание докладов, маршрут, отели и что взять с собой.', href: '/visitors/', label: 'Как посетить' },
        { title: 'Организаторам событий', text: 'Аренда зала под свою выставку, конференцию или фестиваль — с техподдержкой и сервисом на площадку.', href: '/organizers/', label: 'Забронировать площадку' },
        { title: 'Прессе и партнёрам', text: 'Аккредитация, пресс-релизы, фото- и видеоматериалы, логотипы и фактшит центра.', href: '/news/media-kit/', label: 'Медиа-кит' },
      ],
    },
    market: {
      kicker: 'Почему Самарканд',
      title: 'Транзитный узел между шестью рынками',
      text: 'Узбекистан — крупнейший по населению рынок Центральной Азии: более 125 млн потребителей в зоне прямого доступа, розница Узбекистана — 182 трлн сумов за 2024 год. От Самарканда до Ташкента, Душанбе, Ашхабада и Кабула — один перелёт или одна ночная фура.',
      countries: [
        ['Узбекистан', '125 млн потребителей региона'],
        ['Казахстан', 'крупнейший импортёр продуктов питания в CA'],
        ['Таджикистан', 'высокая доля узбекского импорта'],
        ['Кыргызстан', 'розничные сети и опт'],
        ['Туркменистан', 'госзакупки и тендеры'],
        ['Афганистан', 'приграничная торговля через Термез'],
      ],
    },
    stands: {
      kicker: 'Форматы участия',
      title: 'От готового стенда 9 м² до острова с индивидуальной застройкой',
      text: 'В стоимость входит площадь, брендирование, мебель, электричество, интернет и регистрация персонала. Сверх — застройка по брендбуку, перевод, промо-персонал и каталог.',
      items: [
        { name: 'Стандарт 9 м²', note: 'Готовая застройка, стол, два стула, свет, вывеска', icon: 'cube' },
        { name: 'Премиум 18 м²', note: 'Улучшенная локация, больше рекламной поверхности, переговорная зона', icon: 'star' },
        { name: 'Свободная площадь 36 м²+', note: 'Застройка по вашему проекту, согласование с технологами', icon: 'building' },
        { name: 'Конференц-сессия', note: 'Доклад в программе, зал, техника, модератор, трансляция', icon: 'mic' },
      ],
    },
    program: {
      kicker: 'Деловая программа',
      title: 'Не только экспозиция: форумы, панели и биржа контактов',
      text: 'На каждой выставке работает конференц-зал и сцена в зале. Мы собираем аудиторию заранее: категорийные менеджеры, закупщики сетей, архитекторы, агрономы, селлеры маркетплейсов.',
      points: ['10+ сессий и форумов на крупной выставке', 'Pre-matched переговоры «15 минут»', 'Модератор, техника и трансляция', 'Итоговый отчёт с контактами для экспонентов'],
    },
    services: {
      kicker: 'Сервис на площадке',
      title: 'Всё включено в ставку — или заказывается отдельно',
      text: 'Аренда оборудования, мебель, ТВ, печать, перевод, хостес, промо, клининг, хранение, встреча делегаций. Заявка подаётся одним бланком до монтажа.',
    },
    media: { kicker: 'Медиа', title: 'Новости выставки и аналитика рынков' },
    partners: {
      kicker: 'Поддержки и партнёры',
      title: 'С кем мы делаем выставки',
      text: 'Государственные органы Самаркандской области, отраслевые ассоциации, международные организаторы и инфраструктурные партнёры.',
    },
    form: {
      kicker: 'Заявка',
      title: 'Получить планировку, цены и свободные места',
      text: 'Укажите выставку и площадь — пришлём прайс, floor plan и профиль аудитории. Без оплаты сейчас.',
    },
  },
  en: {
    title: 'SOF EXPO Samarkand — exhibition centre and trade shows in Uzbekistan',
    desc:
      'SOF EXPO Samarkand: 4,400 m² hall and 5,000 m² outdoors, 20+ events and 70,000+ visitors a year. Book a stand or rent the hall for your own event.',
    heroKicker: 'Exhibition centre · Samarkand, Uzbekistan',
    h1: 'Where an industry meets <em>face to face</em>',
    lead:
      'SOF EXPO Samarkand is an indoor exhibition centre and the operator of international trade shows in the heart of Uzbekistan. One hall of 4,400 m², 5,000 m² of open ground, a conference hall, cafés for 350 guests and parking at the gate.',
    bullets: ['Booth request answered within 24 hours', 'Technical data sheet and floor plan on request', 'Service in Russian, English and Uzbek'],
    upcomingText:
      'Six owned exhibitions a year: food and drink, construction, agriculture, automotive, e-commerce and education. Each one runs with a business programme and a contact exchange.',
    venue: {
      kicker: 'The venue',
      title: 'One building, two areas, no surprises at build-up',
      text: 'Everything an exhibition needs is already in the shell: 700 kW power, climate control, hall audio, internet and truck access. Technical details go out before the contract is signed.',
      links: [
        { href: '/venue/halls/', label: 'Halls and areas' },
        { href: '/venue/tech-specs/', label: 'Technical data sheet' },
        { href: '/venue/how-to-get-there/', label: 'Getting there' },
      ],
      specs: [
        ['Indoor area', '4,400 m², open plan'],
        ['Open-air area', '5,000 m², truck and crane access'],
        ['Power', '700 kW, 220 / 380 V'],
        ['Conference hall', 'up to 350 seats, AV and projection'],
        ['Climate', 'cooling, heating, ventilation'],
        ['Parking', 'free, right at the entrance'],
      ],
    },
    audiences: {
      kicker: 'Audiences',
      title: 'Pick your door',
      items: [
        { title: 'For exhibitors', text: 'Space, shell scheme, turnkey stands, on-site advertising and a buyer list before the doors open.', href: '/exhibitors/', label: 'Packages and rates' },
        { title: 'For visitors', text: 'Tickets and free registration, talk schedule, route plan, hotels and what to bring.', href: '/visitors/', label: 'How to attend' },
        { title: 'For event organizers', text: 'Hall rental for your own show, conference or festival, with technical and visitor services.', href: '/organizers/', label: 'Book the venue' },
        { title: 'For press and partners', text: 'Accreditation, press releases, photo and video material, logos and venue fact sheet.', href: '/news/media-kit/', label: 'Media kit' },
      ],
    },
    market: {
      kicker: 'Why Samarkand',
      title: 'A transit node between six markets',
      text: 'Uzbekistan is the most populous market in Central Asia: more than 125 million consumers within direct reach, retail turnover of UZS 182 trillion in 2024. From Samarkand to Tashkent, Dushanbe, Ashgabat or Kabul is one flight or one overnight truck.',
      countries: [
        ['Uzbekistan', '125 M consumers in the region'],
        ['Kazakhstan', 'largest food importer in CA'],
        ['Tajikistan', 'high share of Uzbek imports'],
        ['Kyrgyzstan', 'retail chains and wholesale'],
        ['Turkmenistan', 'state procurement and tenders'],
        ['Afghanistan', 'border trade via Termez'],
      ],
    },
    stands: {
      kicker: 'Participation',
      title: 'From a 9 m² ready-made stand to a custom-built island',
      text: 'Rate includes space, branding, furniture, power, internet and staff badges. On top: custom build, interpreting, promo staff and catalogue listing.',
      items: [
        { name: 'Standard 9 m²', note: 'Shell scheme, table, two chairs, lighting, fascia board', icon: 'cube' },
        { name: 'Premium 18 m²', note: 'Better location, more ad surface, meeting area', icon: 'star' },
        { name: 'Raw space 36 m²+', note: 'Build to your design, engineering approval included', icon: 'building' },
        { name: 'Conference slot', note: 'A talk in the programme, hall, tech, moderator, stream', icon: 'mic' },
      ],
    },
    program: {
      kicker: 'Business programme',
      title: 'More than an expo: forums, panels and a contact exchange',
      text: 'Every show runs a conference hall and a stage inside the hall. We build the audience in advance: category managers, chain buyers, architects, agronomists and marketplace sellers.',
      points: ['10+ sessions and forums at a major show', 'Pre-matched 15-minute meetings', 'Moderator, AV and live stream', 'Post-show report with contacts for exhibitors'],
    },
    services: {
      kicker: 'On-site services',
      title: 'Included in the rate — or ordered separately',
      text: 'Equipment rental, furniture, screens, print, interpreting, hostesses, promo staff, cleaning, storage and delegation pickup. Ordered in a single form before build-up.',
    },
    media: { kicker: 'Media', title: 'Show news and market analysis' },
    partners: {
      kicker: 'Support and partners',
      title: 'Who we build exhibitions with',
      text: 'Samarkand regional authorities, industry associations, international organizers and infrastructure partners.',
    },
    form: {
      kicker: 'Request',
      title: 'Get the floor plan, rates and free spots',
      text: 'Name the exhibition and the area — we send the price list, floor plan and audience profile. No payment now.',
    },
  },
}[locale];

const news = (await getCollection('news'))
  .filter((e) => e.id.startsWith(`${locale}/`))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const articles = (await getCollection('articles'))
  .filter((e) => e.id.startsWith(`${locale}/`))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const faq = (ru
  ? [
      { q: 'Сколько стоит стенд и от чего зависит цена?', a: 'Ставка считается за квадратный метр и зависит от выставки, расположения места и типа застройки. Прайс-лист и план зала высылаем по заявке — в него уже входят электричество, мебель и брендирование.' },
      { q: 'Можно ли арендовать зал под своё мероприятие?', a: 'Да. Центр работает и как площадка для сторонних организаторов: выставка, форум, конференция, фестиваль или корпоративное событие. Заявку на расчёт даты и технического задания можно оставить на странице для организаторов.' },
      { q: 'Как попасть на выставку посетителем?', a: 'Регистрация онлайн даёт электронный билет: вход по QR-коду, без очереди. На отраслевых выставках вход для профильных специалистов бесплатный, на фестивальные форматы — по билету.' },
      { q: 'Помогаете ли вы с логистикой и проживанием?', a: 'Да: трансфер от аэропорта и вокзала, бронь отелей-партнёров со скидкой для участников, хранение и вывоз груза, разгрузка фуры.' },
    ]
  : [
      { q: 'What does a stand cost and what drives the price?', a: 'The rate is per square metre and depends on the show, location on the floor plan and build type. Send a request for the price list and hall plan — power, furniture and branding are already inside it.' },
      { q: 'Can I rent the hall for my own event?', a: 'Yes. The centre also works as a venue for third-party organizers: exhibitions, forums, conferences, festivals and corporate events. Submit a date request on the organizers page.' },
      { q: 'How do visitors get in?', a: 'Online registration issues an e-ticket — you enter with a QR code, no queue. Trade entry is free at industry shows; festival formats are ticketed.' },
      { q: 'Do you help with travel and accommodation?', a: 'Yes: transfers from the airport and station, discounted partner hotels for participants, storage, cargo handling and truck unloading.' },
    ]);

const jsonLd = [
  ...rootJsonLd(),
  breadcrumbJsonLd([{ name: ru ? 'Главная' : 'Home', url: P('/') }]),
  itemListJsonLd(
    events.map((e) => ({ name: e.brand[locale], url: P(`/events/${e.slug}/`) })),
    P('/'),
    ru ? 'Выставки SOF EXPO Samarkand' : 'SOF EXPO Samarkand exhibitions',
  ),
  faqJsonLd(faq, P('/')),
];
---

{hostEvent && hostPage ? <EventPage locale={locale} event={hostEvent} page={hostPage} /> : <Base
  locale={locale}
  path="/"
  title={copy.title}
  description={copy.desc}
  jsonLd={jsonLd}
  image="/images/hero-hall.jpg"
  preload="/images/hero-hall.jpg"
>
  <PageHero
    locale={locale}
    kicker={copy.heroKicker}
    title={copy.h1}
    lead={copy.lead}
    bullets={copy.bullets}
    image="/images/hero-hall.jpg"
    actions={[
      { label: t('cta.stand'), href: P('/request-stand/'), tone: 'gold' },
      { label: t('cta.all'), href: P('/events/'), tone: 'ghost' },
    ]}
>
    <div class="hero__side" slot="side">
      <p class="mono-label" style="margin:0 0 .5rem">{ru ? 'Ближайшее событие' : 'Next event'}</p>
      <a href={P(`/events/${next.slug}/`)} style="text-decoration:none;color:#fff">
        <h3 style="margin:0 0 .3rem;font-size:1.35rem">{next.brand[locale]}</h3>
      </a>
      <p style="margin:0;color:rgba(255, 255, 255, .8);font-size:.92rem">{next.tagline[locale]}</p>
      <Countdown locale={locale} target={next.dates.start} label={ru ? 'До старта' : 'Opening in'} />
      <div class="btn-row">
        <a class="btn btn--sm" style="background:rgba(255,255,255,.86);color:var(--evergreen)" href={P(`/events/${next.slug}/`)}>{t('cta.details')}</a>
        <a class="btn btn--sm btn--ghost" style="border-color:rgba(255, 255, 255, .4);color:rgba(255,255,255,.86)" href={P('/request-stand/')}>{t('cta.stand')}</a>
      </div>
    </div>
  </PageHero>

  <section class="sec--tight sec" style="padding-block:clamp(1.2rem,.6rem + 1.6vw,2rem)">
    <div class="wrap"><StatBand locale={locale} /></div>
  </section>

  <section class="sec" id="events">
    <div class="wrap">
      <SectionHead locale={locale} kicker={t('kicker.upcoming')} title={ru ? 'Афиша выставок 2026–2027' : 'Exhibition line-up 2026–2027'} text={copy.upcomingText}>
        <a slot="aside" class="btn btn--ghost btn--sm" href={P('/events/')}>{t('cta.all')} <Icon name="arrow" size={16} /></a>
      </SectionHead>
      <div class="grid g3">
        {upcoming.map((e, i) => <div><EventCard locale={locale} event={e} priority={i === 0} /></div>)}
      </div>
    </div>
  </section>

  <section class="sec sec--paper">
    <div class="wrap">
      <div class="grid g-sidebar">
        <div>
          <p class="kicker">{copy.venue.kicker}</p>
          <h2 set:html={copy.venue.title} />
          <p class="lead">{copy.venue.text}</p>
          <div class="btn-row" style="margin-top:1.4rem">
            {copy.venue.links.map((l) => <a class="chip" href={P(l.href)}>{l.label} →</a>)}
          </div>
          <div style="margin-top:1.6rem;border-radius:var(--r-lg);overflow:hidden">
            <img src="/images/venue-exterior.jpg" alt={ru ? 'Экстерьер выставочного центра SOF EXPO Samarkand' : 'Exterior of SOF EXPO Samarkand exhibition centre'} width="900" height="560" loading="lazy" decoding="async" />
          </div>
        </div>
        <div class="card card--sand">
          <h3 style="font-size:1.15rem;margin-bottom:1rem">{ru ? 'Параметры площадки' : 'Venue parameters'}</h3>
          <table class="table">
            <tbody>
              {copy.venue.specs.map(([k, v]) => <tr><th>{k}</th><td>{v}</td></tr>)}
            </tbody>
          </table>
          <a class="btn btn--sm" style="margin-top:1rem" href={P('/venue/tech-specs/')}>{ru ? 'Затребовать техспецификацию' : 'Request the data sheet'}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <SectionHead locale={locale} kicker={copy.audiences.kicker} title={copy.audiences.title} />
      <FeatureGrid locale={locale} cols={4} items={copy.audiences.items.map((i) => ({ title: i.title, text: i.text, href: P(i.href), meta: i.label }))} />
    </div>
  </section>

  <section class="sec sec--forest">
    <div class="wrap">
      <div class="grid g2" style="align-items:center">
        <div>
          <p class="kicker">{copy.stands.kicker}</p>
          <h2 set:html={copy.stands.title} />
          <p class="lead" style="color:rgba(255, 255, 255, .85)">{copy.stands.text}</p>
          <div class="btn-row" style="margin-top:1.4rem">
            <a class="btn btn--light" href={P('/exhibitors/packages/')}>{ru ? 'Все пакеты участия' : 'All participation packages'}</a>
            <a class="btn btn--ghost" style="border-color:rgba(255, 255, 255, .4);color:rgba(255,255,255,.86)" href={P('/exhibitors/floor-plan/')}>{ru ? 'Планировка зала' : 'Floor plan'}</a>
          </div>
        </div>
        <div class="grid g2">
          {copy.stands.items.map((i) => (
            <div class="stand-card">
              <span class="ico-tile"><Icon name={i.icon} size={22} /></span>
              <h3>{i.name}</h3>
              <p>{i.note}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="grid g-sidebar" style="align-items:center">
        <div>
          <p class="kicker">{copy.market.kicker}</p>
          <h2 set:html={copy.market.title} />
          <p class="lead">{copy.market.text}</p>
          <div class="grid g2" style="margin-top:1.4rem">
            {copy.market.countries.map(([c, note]) => (
              <div class="mini">
                <b>{c}</b>
                <span>{note}</span>
              </div>
            ))}
          </div>
        </div>
        <div>
