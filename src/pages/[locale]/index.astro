---
import Base from '@/layouts/Base.astro';
import { localize } from '@/i18n/config';
import { useUI } from '@/i18n/ui';
import { localePaths } from '@/lib/pages';
import { site } from '@/data/site';
import { upcoming, events } from '@/data/events';
import { CURRENT_EVENT } from '@/data/hosts';
import { eventPages } from '@/data/pages/event-pages';
import EventPage from '@/components/EventPage.astro';
import { getCollection } from 'astro:content';
import { rootJsonLd, breadcrumbJsonLd, itemListJsonLd, faqJsonLd } from '@/lib/seo';
import { bigDate, daysUntil, industryLabel } from '@/lib/labels';
import Icon from '@/components/Icon.astro';
import CalendarRail from '@/components/CalendarRail.astro';
import Countdown from '@/components/Countdown.astro';
import Faq from '@/components/Faq.astro';
import LeadForm from '@/components/LeadForm.astro';
import FeatureGrid from '@/components/FeatureGrid.astro';
import StatBand from '@/components/StatBand.astro';
import PostCard from '@/components/PostCard.astro';

export function getStaticPaths() {
  return localePaths();
}

/* On an exhibition's own hostname this route IS the event home: the cluster lives at the
   root of that host, so `/ru/` shows the show, not the centre. */
const hostEvent = CURRENT_EVENT ? events.find((e) => e.slug === CURRENT_EVENT) ?? null : null;
const hostPage = hostEvent ? eventPages[hostEvent.slug]?.overview ?? null : null;

const { locale } = Astro.params as { locale: 'ru' | 'en' };
const t = useUI(locale);
const P = (p: string) => localize(locale, p);
const ru = locale === 'ru';
const next = upcoming[0];
const d = bigDate(next.dates.start, next.dates.end, locale);
const days = daysUntil(next.dates.start);
const countdownLine =
  days > 1
    ? ru
      ? `До старта — ${days} ${days < 5 ? 'дня' : days < 21 || days > 24 ? 'дней' : 'дня'}`
      : `${days} days to opening`
    : days === 1
      ? ru
        ? 'До старта — завтра'
        : 'Opening tomorrow'
      : ru
        ? 'Выставка идёт сейчас'
        : 'The show is running now';

const copy = {
  ru: {
    title: 'SOF EXPO Samarkand — экспоцентр и выставки в Самарканде',
    desc:
      'Экспоцентр SOF EXPO Samarkand: 4 400 м² зала и 5 000 м² улицы, 20+ событий, 70 000+ посетителей в год. Бронирование стендов, аренда под своё событие, деловая программа.',
    heroKicker: (e: string, ind: string) => `Ближайшая выставка · ${ind}`,
    lead:
      'Один зал 4 400 м², открытая площадка 5 000 м², конференц-зал на 350 мест. Бронирование стенда — ответ за 24 часа; техспецификация и планировка — до договора.',
    stand: 'Забронировать стенд',
    ticket: 'Билет посетителя',
    more: 'Про выставку',
    venueTitle: 'Один корпус, две площади, ноль сюрпризов при монтаже',
    venueText: 'Электричество 700 кВт, климат-контроль, аудио, интернет и подъезд для фур уже в здании. Технические детали высылаем до подписания договора.',
    doorsTitle: 'Выберите свою дверь',
    doors: [
      { title: 'Экспонентам', text: 'Площадь, застройка, услуга «стенд под ключ», реклама на площадке и список закупщиков до старта выставки.', href: '/exhibitors/', meta: 'Пакеты и цены', image: '/images/hall-stand.jpg', imageAlt: 'Выставочный зал: стенды на монтаже' },
      { title: 'Посетителям', text: 'Билеты и бесплатная регистрация, расписание докладов, маршрут, отели и что взять с собой.', href: '/visitors/', meta: 'Как посетить', image: '/images/hall-crowd.jpg', imageAlt: 'Посетители в зале в день выставки' },
      { title: 'Организаторам событий', text: 'Аренда зала под свою выставку, конференцию или фестиваль — с техподдержкой и сервисом на площадке.', href: '/organizers/', meta: 'Забронировать площадку', image: '/images/conference-audience.jpg', imageAlt: 'Конференц-зал: деловая программа' },
    ],
    marketKicker: 'Почему Самарканд',
    marketTitle: 'Транзитный узел между шестью рынками',
    marketText:
      'Узбекистан — крупнейший по населению рынок Центральной Азии: более 125 млн потребителей в зоне прямого доступа, розница Узбекистана — 182 трлн сумов за 2024 год. От Самарканда до Ташкента, Душанбе, Ашхабада и Кабула — один перелёт или одна ночная фура.',
    countries: [
      ['Узбекистан', '125 млн потребителей региона'],
      ['Казахстан', 'крупнейший импортёр продуктов питания в CA'],
      ['Таджикистан', 'высокая доля узбекского импорта'],
      ['Кыргызстан', 'розничные сети и опт'],
      ['Туркменистан', 'госзакупки и тендеры'],
      ['Афганистан', 'приграничная торговля через Термез'],
    ],
    mediaKicker: 'Медиа',
    mediaTitle: 'Новости выставки и аналитика рынков',
    allNews: 'Все новости',
    formTitle: 'Получить планировку, цены и свободные места',
    formText: 'Укажите выставку и площадь — пришлём прайс, floor plan и профиль аудитории. Без оплаты сейчас.',
    formTitleCard: 'Заявка на стенд',
    formSub: '30 секунд — без оплаты сейчас.',
    formList: ['Прайс-лист и план зала в PDF', 'Профиль аудитории и список участников', 'Фиксация цены раннего бронирования', 'Подбор места с учётом вашего продукта'],
  },
  en: {
    title: 'SOF EXPO Samarkand — exhibition centre and trade shows in Uzbekistan',
    desc:
      'SOF EXPO Samarkand: 4,400 m² hall and 5,000 m² outdoors, 20+ events and 70,000+ visitors a year. Book a stand or rent the hall for your own event.',
    heroKicker: (e: string, ind: string) => `Next show · ${ind}`,
    lead:
      'One 4,400 m² hall, 5,000 m² of open ground, a 350-seat conference hall. Stand request answered within 24 hours; technical data sheet and floor plan before the contract.',
    stand: 'Book a stand',
    ticket: 'Visitor pass',
    more: 'About the show',
    venueTitle: 'One building, two areas, no surprises at build-up',
    venueText: '700 kW power, climate control, audio, internet and truck access are already in the shell. Technical details go out before the contract is signed.',
    doorsTitle: 'Pick your door',
    doors: [
      { title: 'For exhibitors', text: 'Space, shell scheme, turnkey stands, on-site advertising and a buyer list before the doors open.', href: '/exhibitors/', meta: 'Packages and rates', image: '/images/hall-stand.jpg', imageAlt: 'Exhibition hall: stands during build-up' },
      { title: 'For visitors', text: 'Tickets and free registration, talk schedule, route plan, hotels and what to bring.', href: '/visitors/', meta: 'How to attend', image: '/images/hall-crowd.jpg', imageAlt: 'Visitors in the hall on show day' },
      { title: 'For event organizers', text: 'Hall rental for your own show, conference or festival, with technical and visitor services.', href: '/organizers/', meta: 'Book the venue', image: '/images/conference-audience.jpg', imageAlt: 'Conference hall: business programme' },
    ],
    marketKicker: 'Why Samarkand',
    marketTitle: 'A transit node between six markets',
    marketText:
      'Uzbekistan is the most populous market in Central Asia: more than 125 million consumers within direct reach, retail turnover of UZS 182 trillion in 2024. From Samarkand to Tashkent, Dushanbe, Ashgabat or Kabul is one flight or one overnight truck.',
    countries: [
      ['Uzbekistan', '125 M consumers in the region'],
      ['Kazakhstan', 'largest food importer in CA'],
      ['Tajikistan', 'high share of Uzbek imports'],
      ['Kyrgyzstan', 'retail chains and wholesale'],
      ['Turkmenistan', 'state procurement and tenders'],
      ['Afghanistan', 'border trade via Termez'],
    ],
    mediaKicker: 'Media',
    mediaTitle: 'Show news and market analysis',
    allNews: 'All news',
    formTitle: 'Get the floor plan, rates and free spots',
    formText: 'Name the exhibition and the area — we send the price list, floor plan and audience profile. No payment now.',
    formTitleCard: 'Stand request',
    formSub: '30 seconds — no payment now.',
    formList: ['Price list and hall plan in PDF', 'Audience profile and exhibitor list', 'Early-booking price lock', 'Location picked around your product'],
  },
}[locale];

const news = (await getCollection('news'))
  .filter((e) => e.id.startsWith(`${locale}/`))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const [newsLead, ...newsRest] = news;

const faq = (ru
  ? [
      { q: 'Сколько стоит стенд и от чего зависит цена?', a: 'Ставка считается за квадратный метр и зависит от выставки, расположения места и типа застройки. Прайс-лист и план зала высылаем по заявке — в него уже входят электричество, мебель и брендирование.' },
      { q: 'Можно ли арендовать зал под своё мероприятие?', a: 'Да. Центр работает и как площадка для сторонних организаторов: выставка, форум, конференция, фестиваль или корпоративное событие. Заявку на расчёт даты и технического задания можно оставить на странице для организаторов.' },
      { q: 'Как попасть на выставку посетителем?', a: 'Регистрация онлайн даёт электронный билет: вход по QR-коду, без очереди. На отраслевых выставках вход для профильных специалистов бесплатный, на фестивальные форматы — по билету.' },
      { q: 'Помогаете ли вы с логистикой и проживанием?', a: 'Да: трансфер от аэропорта и вокзала, бронь отелей-партнёров со скидкой для участников, хранение и вывоз груза, разгрузка фуры.' },
    ]
  : [
      { q: 'What does a stand cost and what drives the price?', a: 'The rate is per square metre and depends on the show, location on the floor plan and build type. Send a request for the price list and hall plan — power, furniture and branding are already inside it.' },
      { q: 'Can I rent the hall for my own event?', a: 'Yes. The centre also works as a venue for third-party organizers: exhibitions, forums, conferences, festivals and corporate events. Submit a date request on the organizers page.' },
      { q: 'How do visitors get in?', a: 'Online registration issues an e-ticket — you enter with a QR code, no queue. Trade entry is free at industry shows; festival formats are ticketed.' },
      { q: 'Do you help with travel and accommodation?', a: 'Yes: transfers from the airport and station, discounted partner hotels for participants, storage, cargo handling and truck unloading.' },
    ]);

const jsonLd = [
  ...rootJsonLd(),
  breadcrumbJsonLd([{ name: ru ? 'Главная' : 'Home', url: P('/') }]),
  itemListJsonLd(
    events.map((e) => ({ name: e.brand[locale], url: P(`/events/${e.slug}/`) })),
    P('/'),
    ru ? 'Выставки SOF EXPO Samarkand' : 'SOF EXPO Samarkand exhibitions',
  ),
  faqJsonLd(faq, P('/')),
];
---

{hostEvent && hostPage ? <EventPage locale={locale} event={hostEvent} page={hostPage} /> : <Base
  locale={locale}
  path="/"
  title={copy.title}
  description={copy.desc}
  jsonLd={jsonLd}
  image={next.heroImage}
  preload={next.heroImage}
>
  <!-- 1 · hero = the next show: the date is the biggest element on the page -->
  <section class="home-hero">
    <figure class="home-hero__bg">
      <img src={next.heroImage} alt={next.tagline[locale]} width="1600" height="900" loading="eager" fetchpriority="high" />
    </figure>
    <div class="wrap">
      <div class="home-hero__in">
        <div>
          <p class="home-hero__kicker">
            <span class="dot" aria-hidden="true"></span>
            {copy.heroKicker(next.slug, industryLabel(next.industry, locale))}
          </p>
          <h1>{next.brand[locale]}</h1>
          <p class="home-hero__date">
            <b>{d.days}</b>
            <span>{d.month} {d.year}</span>
          </p>
          <p class="home-hero__lead">{copy.lead}</p>
          <div class="btn-row">
            <a class="btn" href={P(`/request-stand/`) + `?event=${next.slug}`}>
              <Icon name="sparkle" size={16} /> {copy.stand}
            </a>
            <a class="btn btn--ghost" style="border-color:rgba(255,255,255,.4);color:rgba(255,255,255,.88)" href={P('/visitors/tickets/')}>{copy.ticket}</a>
            <a class="home-hero__more" href={P(`/events/${next.slug}/`)}>{copy.more} <Icon name="arrow" size={15} /></a>
          </div>
        </div>
        <aside class="home-hero__side">
          <div>
            <p class="mono-label">{ru ? 'До старта' : 'Opening in'}</p>
            <Countdown locale={locale} target={next.dates.start} />
          </div>
          <div>
            <p class="mono-label" style="margin:0">{ru ? 'Площадка' : 'The venue'}</p>
            <p class="home-hero__venue">
              4 400 м² <span>·</span> 5 000 м² <span>·</span> 700 кВт <span>·</span> 350 мест
            </p>
            <p class="mono-label" style="margin:.5rem 0 0">{ru ? 'Самарканд, Узбекистан' : 'Samarkand, Uzbekistan'}</p>
          </div>
        </aside>
      </div>
      <CalendarRail locale={locale} />
    </div>
  </section>

  <!-- 2 · the venue in one line (the table lives on /venue/) -->
  <section class="sec--tight">
    <div class="wrap">
      <div class="venue-strip">
        <div class="venue-strip__nums">
          <div><b>4 400<small> м²</small></b><span>{ru ? 'зал' : 'hall'}</span></div>
          <div><b>5 000<small> м²</small></b><span>{ru ? 'улица' : 'outdoor'}</span></div>
          <div><b>700<small> кВт</small></b><span>{ru ? '220/380 В' : '220/380 V'}</span></div>
          <div><b>350</b><span>{ru ? 'мест, кафе' : 'seats, café'}</span></div>
        </div>
        <div class="venue-strip__txt">
          <h2>{copy.venueTitle}</h2>
          <p>{copy.venueText}</p>
          <div class="venue-strip__links">
            <a href={P('/venue/halls/')}>{ru ? 'Залы и площади' : 'Halls and areas'} →</a>
            <a href={P('/venue/tech-specs/')}>{ru ? 'Техническая спецификация' : 'Technical data sheet'} →</a>
            <a href={P('/venue/how-to-get-there/')}>{ru ? 'Как добраться' : 'Getting there'} →</a>
          </div>
        </div>
        <figure class="venue-strip__img">
          <img src="/images/venue-exterior.jpg" alt={ru ? 'Экстерьер выставочного центра SOF EXPO Samarkand' : 'Exterior of SOF EXPO Samarkand exhibition centre'} width="640" height="480" loading="lazy" decoding="async" />
        </figure>
      </div>
    </div>
  </section>

  <!-- 3 · three doors -->
  <section class="sec">
    <div class="wrap">
      <h2 class="sec-title">{copy.doorsTitle}</h2>
      <FeatureGrid locale={locale} cols={3} items={copy.doors.map((i) => ({ title: i.title, text: i.text, href: P(i.href), meta: i.meta, image: i.image, imageAlt: i.imageAlt }))} />
    </div>
  </section>

  <!-- 4 · why Samarkand: one stat band, once -->
  <section class="sec sec--paper">
    <div class="wrap">
      <div class="grid g-sidebar" style="align-items:center">
        <div>
          <p class="kicker">{copy.marketKicker}</p>
          <h2 set:html={copy.marketTitle} />
          <p class="lead">{copy.marketText}</p>
          <div class="grid g2" style="margin-top:1.4rem">
            {copy.countries.map(([c, note]) => (
              <div class="mini">
                <b>{c}</b>
                <span>{note}</span>
              </div>
            ))}
          </div>
        </div>
        <div>
          <img src="/images/samarkand-real.jpg" alt={ru ? 'Регистан в Самарканде' : 'Registan in Samarkand'} width="900" height="620" loading="lazy" decoding="async" style="border-radius:var(--r-lg)" />
          <div style="margin-top:1rem">
            <StatBand locale={locale} />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5 · media: one lead with a photo, three rows -->
  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="kicker">{copy.mediaKicker}</p>
          <h2>{copy.mediaTitle}</h2>
        </div>
        <a class="txt-link" href={P('/news/')}>{copy.allNews} <Icon name="arrow" size={15} /></a>
      </div>
      {newsLead && (
        <div style="margin-top:1.4rem">
          <PostCard locale={locale} post={newsLead} path="/news/" variant="lead" priority />
        </div>
      )}
      <div class="home-news-rows">
        {newsRest.slice(0, 3).map((n) => <PostCard locale={locale} post={n} path="/news/" variant="row" />)}
      </div>
    </div>
  </section>

  <!-- 6 · request + FAQ, full width, no empty column -->
  <section class="sec sec--paper" id="booking">
    <div class="wrap">
      <div class="grid g2" style="align-items:start">
        <Faq locale={locale} items={faq} title={ru ? 'Частые вопросы' : 'Frequently asked questions'} />
        <div>
          <p class="kicker">{ru ? 'Заявка' : 'Request'}</p>
          <h2 set:html={copy.formTitle} />
          <p class="lead">{copy.formText}</p>
          <ul class="form-list">
            {copy.formList.map((x) => <li>{x}</li>)}
          </ul>
        </div>
      </div>
      <LeadForm
        locale={locale}
        title={copy.formTitleCard}
        subtitle={copy.formSub}
        eventName={next.brand[locale]}
        directions={ru
          ? ['Продукты питания', 'Напитки', 'Стройматериалы', 'Агро', 'Авто', 'E-commerce и ритейл', 'Образование', 'Услуги', 'Другое']
          : ['Food products', 'Drinks', 'Building materials', 'Agriculture', 'Automotive', 'E-commerce and retail', 'Education', 'Services', 'Other']}
      />
    </div>
  </section>
</Base>}

<style>
  .home-hero__more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.35);
    padding-bottom: 1px;
  }
  .home-hero__more:hover {
    color: #fff;
    border-color: var(--gold-soft);
  }
  .sec--tight {
    padding-block: clamp(1.6rem, 1rem + 2vw, 3rem);
  }
  .sec-title {
    margin: 0 0 1.6rem;
    font-size: var(--t-h2);
  }
  .mini {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.85rem 1rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r);
  }
  .mini b {
    font-family: var(--f-display);
    font-size: 0.98rem;
    letter-spacing: -0.01em;
  }
  .mini span {
    font-size: 0.85rem;
    color: var(--ink-60);
  }
  .txt-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 1px;
  }
  .txt-link:hover {
    border-color: var(--ink);
  }
  .home-news-rows {
    margin-top: 0.8rem;
    border-top: 1px solid var(--line);
  }
  .form-list {
    padding-left: 1.1rem;
    margin-top: 1rem;
    display: grid;
    gap: 0.4rem;
    color: var(--ink-60);
  }
</style>
