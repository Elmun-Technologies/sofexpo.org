---
/**
 * Root document = 301 to the EN home (docs/08 §7, Q1 — option A).
 *
 * The real redirect is a host-level rule: scripts/build-hosts.mjs writes
 * `/ /en/ 301` into every host's `_redirects` (Cloudflare Pages / Netlify),
 * and the CDN config (redirects.vanity.md) mirrors it for alias mode.
 * This HTML page is the fallback for hosts that do not read `_redirects`:
 * meta-refresh + two explicit links, so RU users are never stranded.
 *
 * hreflang x-default now points at /en/ (src/i18n/config.ts).
 */
import { SITE } from '@/lib/seo';

const en = `${SITE}/en/`;
const ru = `${SITE}/ru/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content="0; url=/en/" />
    <link rel="canonical" href={en} />
    <title>SOF EXPO SAMARKAND — redirecting</title>
  </head>
  <body>
    <main style="font-family: system-ui, sans-serif; max-width: 40rem; margin: 15vh auto 0; padding: 0 1.25rem; line-height: 1.6">
      <p>
        <a href="/en/">EN home →</a>
      </p>
      <p lang="ru">
        <a href="/ru/">→ Главная на русском</a>
      </p>
      <p lang="zh-CN"><a href="/zh/">中文首页 →</a></p>
      <p lang="tr"><a href="/tr/">Türkçe ana sayfa →</a></p>
      <p lang="uz"><a href="/uz/">O‘zbekcha bosh sahifa →</a></p>
      <noscript>JavaScript is off — use the links above.</noscript>
    </main>
  </body>
</html>
