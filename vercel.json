{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "build": {
    "env": {
      "SITE": "https://sof-expo.com",
      "PUBLIC_HOSTS_MODE": "alias"
    }
  },
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/en/",
      "statusCode": 301
    },
    {
      "source": "/admin",
      "destination": "https://api.sof-expo.com/admin",
      "statusCode": 302
    },
    {
      "source": "/admin/:path*",
      "destination": "https://api.sof-expo.com/admin",
      "statusCode": 302
    },
    {
      "source": "/cabinet",
      "destination": "https://api.sof-expo.com/cabinet",
      "statusCode": 302
    },
    {
      "source": "/cabinet/:path*",
      "destination": "https://api.sof-expo.com/cabinet",
      "statusCode": 302
    },
    {
      "source": "/:locale(en|ru|zh|tr|uz)/events/foodera-expo/sections/delicacies/",
      "destination": "/:locale/events/foodera-expo/sections/fruits-vegetables/",
      "statusCode": 301
    }
  ]
}
